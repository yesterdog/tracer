+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Disagreement spans on the export text (scratch oracle)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from tracer_evalcore.align import Alignment, OpKind
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalcore.tokens import TokenSequence
+
+__all__ = ["Span", "SpanInputError", "extract_spans"]
+
+
+class SpanInputError(InputRefusedError):
+    """The alignment does not belong to the token sequences, or a span cannot be placed."""
+
+
+@dataclass(frozen=True, slots=True)
+class Span:
+    turn_index: int
+    turn_seq: int
+    start: int
+    end: int
+    export_token_start: int
+    export_token_end: int
+    stt_token_start: int
+    stt_token_end: int
+    substitutions: int
+    deletions: int
+    insertions: int
+    audio_start_ms: int | None
+    audio_end_ms: int | None
+
+    @property
+    def export_tokens(self) -> int:
+        return self.substitutions + self.deletions
+
+
+def _audio(stt: TokenSequence, lo: int, hi: int) -> tuple[int | None, int | None]:
+    if hi <= lo:
+        return None, None
+    held = []
+    for token in stt.tokens[lo:hi]:
+        if token.segment_index is None:
+            return None, None
+        held.append(stt.turns[token.turn_index].segments[token.segment_index])
+    first, last = held[0], held[-1]
+    if first.start_ms is None or last.end_ms is None:
+        return None, None
+    if any(s.start_ms is None or s.end_ms is None for s in held):
+        return None, None
+    if first.start_ms > last.end_ms:
+        return None, None
+    return first.start_ms, last.end_ms
+
+
+def extract_spans(alignment: Alignment, export: TokenSequence, stt: TokenSequence) -> tuple[Span, ...]:
+    ops = alignment.ops
+    if alignment.export_tokens != len(export.tokens) or alignment.stt_tokens != len(stt.tokens):
+        raise SpanInputError("alignment counts do not equal the token counts")
+    e = s = 0
+    export_before: list[int] = []
+    stt_before: list[int] = []
+    for op in ops:
+        if op.export_index is not None:
+            if op.export_index != e:
+                raise SpanInputError("export indices are not in order")
+        if op.stt_index is not None:
+            if op.stt_index != s:
+                raise SpanInputError("stt indices are not in order")
+        export_before.append(e)
+        stt_before.append(s)
+        e += op.export_index is not None
+        s += op.stt_index is not None
+    spans: list[Span] = []
+    k = 0
+    n = len(ops)
+    while k < n:
+        if ops[k].kind == OpKind.MATCH:
+            k += 1
+            continue
+        j = k
+        while j < n and ops[j].kind != OpKind.MATCH:
+            j += 1
+        run = range(k, j)
+        if all(ops[x].export_index is None for x in run):
+            base = export_before[k]
+            if not export.tokens:
+                raise SpanInputError("no export token to anchor an insertion to")
+            anchor = export.tokens[base - 1] if base > 0 else export.tokens[0]
+            where = anchor.end if base > 0 else anchor.start
+            lo, hi = stt_before[k], stt_before[k] + len(run)
+            a, b = _audio(stt, lo, hi)
+            spans.append(Span(anchor.turn_index, anchor.turn_seq, where, where, base, base, lo, hi, 0, 0, len(run), a, b))
+        else:
+            groups: list[int | None] = []
+            last: int | None = None
+            for x in run:
+                if ops[x].export_index is not None:
+                    last = export.tokens[ops[x].export_index].turn_index  # type: ignore[index]
+                groups.append(last)
+            first = next(g for g in groups if g is not None)
+            groups = [first if g is None else g for g in groups]
+            begin = 0
+            for idx in range(1, len(groups) + 1):
+                if idx == len(groups) or groups[idx] != groups[begin]:
+                    members = [run[x] for x in range(begin, idx)]
+                    ex = [ops[x].export_index for x in members if ops[x].export_index is not None]
+                    ft, lt = export.tokens[ex[0]], export.tokens[ex[-1]]
+                    lo = stt_before[members[0]]
+                    hi = lo + sum(1 for x in members if ops[x].stt_index is not None)
+                    a, b = _audio(stt, lo, hi)
+                    spans.append(
+                        Span(
+                            ft.turn_index, ft.turn_seq, ft.start, lt.end, ex[0], ex[-1] + 1, lo, hi,
+                            sum(1 for x in members if ops[x].kind == OpKind.SUBSTITUTION),
+                            sum(1 for x in members if ops[x].kind == OpKind.DELETION),
+                            sum(1 for x in members if ops[x].kind == OpKind.INSERTION), a, b,
+                        )
+                    )
+                    begin = idx
+        k = j
+    return tuple(spans)
