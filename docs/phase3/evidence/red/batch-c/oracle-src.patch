+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Comparison normaliser mr-Deva/1 (scratch oracle of the batch C tests)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+
+from tracer_evalcore.errors import InputRefusedError
+
+__all__ = [
+    "IGNORABLE", "IMPLEMENTED_RULES", "NORMALISER_ID", "SUPPORTED_NORMALISERS", "LoneSurrogateError",
+    "NormaliserError", "NormaliserInfo", "UnknownNormaliserError", "check_text", "char_class",
+    "comparison_key", "normaliser_info", "require_normaliser",
+]
+
+NORMALISER_ID = "mr-Deva/1"
+SUPPORTED_NORMALISERS: tuple[str, ...] = (NORMALISER_ID,)
+IMPLEMENTED_RULES: frozenset[str] = frozenset(f"R{n:02d}" for n in range(1, 19))
+
+IGNORABLE = frozenset(
+    {0x00AD, 0x061C, 0x200C, 0x200D, 0x200E, 0x200F, 0x2060, 0xFEFF}
+    | set(range(0x202A, 0x202F))
+    | set(range(0x2066, 0x206A))
+)
+_DROP = {c: None for c in IGNORABLE}
+_DIGITS = {0x0966 + n: 0x30 + n for n in range(10)}
+_SURROGATE = re.compile("[\ud800-\udfff]")
+
+
+class NormaliserError(InputRefusedError):
+    """The normaliser refused its input or its id."""
+
+
+class UnknownNormaliserError(NormaliserError):
+    """The id names no normaliser this package ships."""
+
+
+class LoneSurrogateError(NormaliserError):
+    """The text holds a lone surrogate; the importers replace them before storing."""
+
+
+@dataclass(frozen=True)
+class NormaliserInfo:
+    id: str
+    unicode_version: str
+
+
+def require_normaliser(normaliser: str) -> str:
+    if not isinstance(normaliser, str):
+        raise TypeError("normaliser must be a str")
+    if normaliser not in SUPPORTED_NORMALISERS:
+        raise UnknownNormaliserError("unknown normaliser id")
+    return normaliser
+
+
+def normaliser_info(normaliser: str) -> NormaliserInfo:
+    return NormaliserInfo(require_normaliser(normaliser), unicodedata.unidata_version)
+
+
+def check_text(text: str) -> None:
+    if not isinstance(text, str):
+        raise TypeError("text must be a str")
+    found = _SURROGATE.search(text)
+    if found is not None:
+        raise LoneSurrogateError(f"lone surrogate at code point index {found.start()}")
+
+
+def char_class(char: str) -> str:
+    if ord(char) in IGNORABLE:
+        return "I"
+    category = unicodedata.category(char)
+    if category[0] in "LM" or category == "Nd":
+        return "T"
+    return "S"
+
+
+def comparison_key(text: str, normaliser: str) -> str:
+    require_normaliser(normaliser)
+    check_text(text)
+    return unicodedata.normalize("NFC", text.translate(_DROP).translate(_DIGITS).casefold())
