+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Flags, confidence and the Signal interface (scratch oracle)."""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
+from fractions import Fraction
+from pathlib import Path
+from typing import Any, Protocol, runtime_checkable
+
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalcore.spans import Span
+from tracer_evalcore.tokens import TokenSequence
+
+SIGNAL_NAME = "stt_disagreement"
+FLAGS_FORMAT = "tracer.flags/1"
+FLAGS_JSON_SCHEMA: dict[str, Any] = json.loads((Path(__file__).parent / "_schema_json.txt").read_text())
+_NAME = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
+
+
+class ThresholdError(InputRefusedError):
+    """flag_min_confidence is not usable."""
+
+
+def levenshtein(a: str, b: str) -> int:
+    if not isinstance(a, str) or not isinstance(b, str):
+        raise TypeError("levenshtein compares str")
+    while a and b and a[0] == b[0]:
+        a, b = a[1:], b[1:]
+    while a and b and a[-1] == b[-1]:
+        a, b = a[:-1], b[:-1]
+    if not a:
+        return len(b)
+    if not b:
+        return len(a)
+    previous = list(range(len(b) + 1))
+    for i, x in enumerate(a, 1):
+        current = [i]
+        for j, y in enumerate(b, 1):
+            current.append(min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + (x != y)))
+        previous = current
+    return previous[-1]
+
+
+@dataclass(frozen=True, slots=True)
+class Confidence:
+    edit_distance: int
+    key_length: int
+
+    def __post_init__(self) -> None:
+        for v in (self.edit_distance, self.key_length):
+            if isinstance(v, bool) or not isinstance(v, int):
+                raise TypeError("confidence parts are ints")
+        if self.key_length < 1 or not 0 <= self.edit_distance <= self.key_length:
+            raise ValueError("need 0 <= edit_distance <= key_length and key_length >= 1")
+
+    @property
+    def display(self) -> str:
+        scaled = Fraction(self.edit_distance * 10000, self.key_length)
+        whole = round(scaled)  # Python rounds half to even
+        text = f"{Decimal(whole).scaleb(-4):f}"
+        if "." in text:
+            text = text.rstrip("0").rstrip(".")
+        return text
+
+    def meets(self, threshold: Decimal) -> bool:
+        if not isinstance(threshold, Decimal):
+            raise TypeError("threshold must be a Decimal")
+        return Fraction(self.edit_distance, self.key_length) >= Fraction(threshold)
+
+
+@runtime_checkable
+class Signal(Protocol):
+    @property
+    def name(self) -> str: ...
+
+    def confidence(self, span: Span, export: TokenSequence, stt: TokenSequence) -> Confidence: ...
+
+
+class SttDisagreementSignal:
+    name = SIGNAL_NAME
+
+    def confidence(self, span: Span, export: TokenSequence, stt: TokenSequence) -> Confidence:
+        a = " ".join(t.key for t in export.tokens[span.export_token_start : span.export_token_end])
+        b = " ".join(t.key for t in stt.tokens[span.stt_token_start : span.stt_token_end])
+        return Confidence(levenshtein(a, b), max(len(a), len(b), 1))
+
+
+STT_DISAGREEMENT = SttDisagreementSignal()
+
+
+def parse_threshold(value: int | float | Decimal) -> Decimal:
+    if isinstance(value, bool) or not isinstance(value, int | float | Decimal):
+        raise TypeError("flag_min_confidence must be a number")
+    if isinstance(value, float):
+        value = Decimal(repr(value))
+    elif isinstance(value, int):
+        value = Decimal(value)
+    if not value.is_finite() or value < 0 or value > 1:
+        raise ThresholdError("flag_min_confidence must be finite and within [0, 1]")
+    if value.normalize().as_tuple().exponent < -18:  # type: ignore[operator]
+        raise ThresholdError("flag_min_confidence has more than 18 fractional digits")
+    return value
+
+
+def format_threshold(threshold: Decimal) -> str:
+    if not isinstance(threshold, Decimal):
+        raise TypeError("threshold must be a Decimal")
+    value = parse_threshold(threshold)
+    if value == 0:
+        return "0"
+    text = f"{value.normalize():f}"
+    return text
+
+
+@dataclass(frozen=True, slots=True)
+class SpanFlag:
+    span: Span
+    signal: str
+    edit_distance: int
+    key_length: int
+    confidence: str
+    flagged: bool
+    near_chunk_boundary: bool
+
+
+def near_chunk_boundary(span: Span, stt: TokenSequence) -> bool:
+    tokens = stt.tokens
+    if span.stt_token_end > len(tokens):
+        raise ValueError("span does not belong to this STT sequence")
+    lo, hi = span.stt_token_start, span.stt_token_end
+    if hi > lo:
+        for i in range(lo, hi):
+            turn = tokens[i].turn_index
+            if i == 0 or tokens[i - 1].turn_index != turn:
+                return True
+            if i == len(tokens) - 1 or tokens[i + 1].turn_index != turn:
+                return True
+        return False
+    return 0 < lo < len(tokens) and tokens[lo - 1].turn_index != tokens[lo].turn_index
+
+
+def flag_spans(
+    spans: tuple[Span, ...] | list[Span],
+    export: TokenSequence,
+    stt: TokenSequence,
+    *,
+    signal: Signal,
+    flag_min_confidence: int | float | Decimal,
+) -> tuple[SpanFlag, ...]:
+    threshold = parse_threshold(flag_min_confidence)
+    if not isinstance(signal, Signal):
+        raise TypeError("signal must provide name and confidence")
+    name = signal.name
+    if not isinstance(name, str):
+        raise TypeError("signal name must be a str")
+    if not _NAME.fullmatch(name):
+        raise ValueError("signal name is not a machine key")
+    out = []
+    for span in spans:
+        value = signal.confidence(span, export, stt)
+        if not isinstance(value, Confidence):
+            raise TypeError("signal must return a Confidence")
+        out.append(
+            SpanFlag(span, name, value.edit_distance, value.key_length, value.display,
+                     value.meets(threshold), near_chunk_boundary(span, stt))
+        )
+    return tuple(out)
