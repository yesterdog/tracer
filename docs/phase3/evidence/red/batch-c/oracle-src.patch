+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Tokenizer with code-point offsets (scratch oracle of the batch C tests)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalcore.normalise import IGNORABLE, check_text, comparison_key, require_normaliser
+
+__all__ = [
+    "TextTurn", "TimedSegment", "Token", "TokenSequence", "TurnOrderError", "TurnToken", "tokenise",
+    "tokenise_turns",
+]
+
+
+class TurnOrderError(InputRefusedError):
+    """Turns are not in strictly increasing seq order."""
+
+
+@dataclass(frozen=True, slots=True)
+class Token:
+    key: str
+    start: int
+    end: int
+
+
+def _int(value: object, name: str, *, none_ok: bool = False) -> None:
+    if value is None and none_ok:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} must be an int")
+    if value < 0:
+        raise ValueError(f"{name} must not be negative")
+
+
+@dataclass(frozen=True, slots=True)
+class TimedSegment:
+    text: str
+    start_ms: int | None
+    end_ms: int | None
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.text, str):
+            raise TypeError("text must be a str")
+        _int(self.start_ms, "start_ms", none_ok=True)
+        _int(self.end_ms, "end_ms", none_ok=True)
+        if self.start_ms is not None and self.end_ms is not None and self.start_ms > self.end_ms:
+            raise ValueError("start_ms is after end_ms")
+
+
+@dataclass(frozen=True, slots=True)
+class TextTurn:
+    seq: int
+    text: str
+    segments: tuple[TimedSegment, ...] = ()
+
+    def __post_init__(self) -> None:
+        _int(self.seq, "seq")
+        if not isinstance(self.text, str):
+            raise TypeError("text must be a str")
+        object.__setattr__(self, "segments", tuple(self.segments))
+
+
+@dataclass(frozen=True, slots=True)
+class TurnToken:
+    turn_index: int
+    turn_seq: int
+    key: str
+    start: int
+    end: int
+    segment_index: int | None
+
+
+@dataclass(frozen=True)
+class TokenSequence:
+    turns: tuple[TextTurn, ...]
+    tokens: tuple[TurnToken, ...]
+
+    @property
+    def keys(self) -> tuple[str, ...]:
+        return tuple(t.key for t in self.tokens)
+
+
+_JOINERS = (0x200C, 0x200D)
+
+
+def tokenise(text: str, normaliser: str) -> tuple[Token, ...]:
+    require_normaliser(normaliser)
+    check_text(text)
+    out: list[Token] = []
+    category = unicodedata.category
+    n = len(text)
+    i = 0
+    while i < n:
+        c = text[i]
+        o = ord(c)
+        if o not in IGNORABLE:
+            cat = category(c)
+            if not (cat[0] in "LM" or cat == "Nd"):
+                i += 1
+                continue
+        j = i
+        first = -1
+        last = -1
+        while j < n:
+            c = text[j]
+            o = ord(c)
+            if o in IGNORABLE:
+                if o in _JOINERS and first >= 0:
+                    last = j + 1
+            else:
+                cat = category(c)
+                if cat[0] in "LM" or cat == "Nd":
+                    if first < 0 and (cat[0] == "L" or cat == "Nd"):
+                        first = j
+                    if first >= 0:
+                        last = j + 1
+                else:
+                    break
+            j += 1
+        if first >= 0:
+            out.append(Token(comparison_key(text[first:last], normaliser), first, last))
+        i = j
+    return tuple(out)
+
+
+def tokenise_turns(turns: Sequence[TextTurn], normaliser: str) -> TokenSequence:
+    require_normaliser(normaliser)
+    turns = tuple(turns)
+    previous = -1
+    for turn in turns:
+        if not isinstance(turn, TextTurn):
+            raise TypeError("turns must be TextTurn")
+        if turn.seq <= previous:
+            raise TurnOrderError(f"turn seq {turn.seq} does not follow {previous}")
+        previous = turn.seq
+    tokens: list[TurnToken] = []
+    for index, turn in enumerate(turns):
+        own = tokenise(turn.text, normaliser)
+        owners: list[int | None] = [None] * len(own)
+        if turn.segments:
+            flat: list[int] = []
+            for seg_index, segment in enumerate(turn.segments):
+                flat.extend([seg_index] * len(tokenise(segment.text, normaliser)))
+            seg_keys = [t.key for s in turn.segments for t in tokenise(s.text, normaliser)]
+            if seg_keys == [t.key for t in own]:
+                owners = list(flat)
+        for token, owner in zip(own, owners, strict=True):
+            tokens.append(TurnToken(index, turn.seq, token.key, token.start, token.end, owner))
+    return TokenSequence(turns, tuple(tokens))
