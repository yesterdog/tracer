+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Word alignment with the cost pair (edits, deletions + insertions) (scratch oracle)."""
+
+from __future__ import annotations
+
+import enum
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from tracer_evalcore.errors import EvalcoreError, InputRefusedError
+from tracer_evalcore.tokens import TokenSequence
+
+__all__ = [
+    "ALIGN_MAX_TOKENS", "AlignOp", "Alignment", "AlignmentTooLargeError", "EvalcoreError",
+    "InputRefusedError", "OpKind", "UndefinedMerError", "align", "align_keys",
+]
+
+ALIGN_MAX_TOKENS = 20000
+
+
+class OpKind(enum.StrEnum):
+    MATCH = "match"
+    SUBSTITUTION = "substitution"
+    DELETION = "deletion"
+    INSERTION = "insertion"
+
+
+class AlignmentTooLargeError(InputRefusedError):
+    def __init__(self, export_tokens: int, stt_tokens: int, max_tokens: int) -> None:
+        super().__init__(
+            f"alignment input too large: export {export_tokens} tokens, stt {stt_tokens} tokens, "
+            f"cap {max_tokens} per side"
+        )
+        self.export_tokens = export_tokens
+        self.stt_tokens = stt_tokens
+        self.max_tokens = max_tokens
+
+
+class UndefinedMerError(EvalcoreError):
+    """Both sides are empty: the match error rate has a zero denominator."""
+
+
+@dataclass(frozen=True, slots=True)
+class AlignOp:
+    kind: OpKind
+    export_index: int | None
+    stt_index: int | None
+
+
+@dataclass(frozen=True)
+class Alignment:
+    ops: tuple[AlignOp, ...]
+    hits: int
+    substitutions: int
+    deletions: int
+    insertions: int
+
+    def __post_init__(self) -> None:
+        tally = {k: 0 for k in OpKind}
+        for op in self.ops:
+            tally[OpKind(op.kind)] += 1
+        got = (tally[OpKind.MATCH], tally[OpKind.SUBSTITUTION], tally[OpKind.DELETION], tally[OpKind.INSERTION])
+        if got != (self.hits, self.substitutions, self.deletions, self.insertions):
+            raise ValueError("alignment counts do not equal the ops")
+
+    @property
+    def export_tokens(self) -> int:
+        return self.hits + self.substitutions + self.deletions
+
+    @property
+    def stt_tokens(self) -> int:
+        return self.hits + self.substitutions + self.insertions
+
+    @property
+    def edits(self) -> int:
+        return self.substitutions + self.deletions + self.insertions
+
+    @property
+    def mer(self) -> float:
+        total = self.hits + self.edits
+        if total == 0:
+            raise UndefinedMerError("match error rate of two empty texts is undefined")
+        return self.edits / total
+
+
+_BIG = 1 << 32
+
+
+def align_keys(
+    export_keys: Sequence[str], stt_keys: Sequence[str], *, max_tokens: int = ALIGN_MAX_TOKENS
+) -> Alignment:
+    if isinstance(max_tokens, bool) or not isinstance(max_tokens, int):
+        raise TypeError("max_tokens must be an int")
+    if max_tokens < 1:
+        raise ValueError("max_tokens must be at least 1")
+    for side in (export_keys, stt_keys):
+        if isinstance(side, str | bytes) or not isinstance(side, Sequence):
+            raise TypeError("keys must be a sequence of str")
+        if not all(isinstance(k, str) for k in side):
+            raise TypeError("keys must be str")
+    n, m = len(export_keys), len(stt_keys)
+    if n > max_tokens or m > max_tokens:
+        raise AlignmentTooLargeError(n, m, max_tokens)
+    sub, indel = _BIG, _BIG + 1
+    table = [[0] * (m + 1) for _ in range(n + 1)]
+    for j in range(1, m + 1):
+        table[0][j] = j * indel
+    for i in range(1, n + 1):
+        row, above = table[i], table[i - 1]
+        row[0] = i * indel
+        key = export_keys[i - 1]
+        for j in range(1, m + 1):
+            diag = above[j - 1] + (0 if key == stt_keys[j - 1] else sub)
+            best = above[j] + indel
+            left = row[j - 1] + indel
+            if left < best:
+                best = left
+            row[j] = diag if diag < best else best
+    ops: list[AlignOp] = []
+    i, j = n, m
+    while i > 0 or j > 0:
+        here = table[i][j]
+        if i > 0 and j > 0 and export_keys[i - 1] == stt_keys[j - 1] and here == table[i - 1][j - 1]:
+            ops.append(AlignOp(OpKind.MATCH, i - 1, j - 1))
+            i, j = i - 1, j - 1
+        elif i > 0 and j > 0 and export_keys[i - 1] != stt_keys[j - 1] and here == table[i - 1][j - 1] + sub:
+            ops.append(AlignOp(OpKind.SUBSTITUTION, i - 1, j - 1))
+            i, j = i - 1, j - 1
+        elif i > 0 and here == table[i - 1][j] + indel:
+            ops.append(AlignOp(OpKind.DELETION, i - 1, None))
+            i -= 1
+        else:
+            ops.append(AlignOp(OpKind.INSERTION, None, j - 1))
+            j -= 1
+    ops.reverse()
+    counts = {k: 0 for k in OpKind}
+    for op in ops:
+        counts[op.kind] += 1
+    return Alignment(
+        tuple(ops), counts[OpKind.MATCH], counts[OpKind.SUBSTITUTION], counts[OpKind.DELETION],
+        counts[OpKind.INSERTION],
+    )
+
+
+def align(export: TokenSequence, stt: TokenSequence, *, max_tokens: int = ALIGN_MAX_TOKENS) -> Alignment:
+    return align_keys(export.keys, stt.keys, max_tokens=max_tokens)
