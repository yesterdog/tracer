+def _kind_by_name(path: str) -> str | None:
+    name = path.rsplit("/", 1)[-1]
+    lower = name.lower()
+    if REPORT_NAME.fullmatch(name):
+        return REPORT
+    stem = lower
+    for sidecar in STORE_SIDECARS:
+        if stem.endswith(sidecar):
+            stem = stem[: -len(sidecar)]
+    if stem.endswith(STORE_SUFFIXES):
+        return STORE
+    if name == CALL_LOG_NAME and path not in CALL_LOG_ALLOWED:
+        return CALL_LOG
+    return None
+
+
+def _kind_by_content(path: str, head: bytes) -> str | None:
+    if head.startswith(SQLITE_MAGIC):
+        return STORE
+    if REPORT_MARKER.search(head):
+        suffix = path.rsplit("/", 1)[-1].lower().rpartition(".")[2]
+        if suffix in {"html", "htm"} or DOCUMENT_START.match(head):
+            return REPORT
+    if path.lower().endswith(".jsonl"):
+        first = head.split(b"\n", 1)[0]
+        if b'"bytes_sent"' in first and b'"audio_seconds"' in first:
+            return CALL_LOG
+    return None
+
+
+def _index_heads(root: Path, paths: list[str]) -> dict[str, bytes]:
+    """The first HEAD_BYTES of the staged blob of every path (one `git cat-file --batch`)."""
+    if not paths:
+        return {}
+    proc = subprocess.Popen(
+        ["git", "cat-file", "--batch"], cwd=root, stdin=subprocess.PIPE, stdout=subprocess.PIPE
+    )
+    assert proc.stdin is not None and proc.stdout is not None
+    heads: dict[str, bytes] = {}
+    import threading
+
+    def feed() -> None:
+        assert proc.stdin is not None
+        for path in paths:
+            proc.stdin.write(f":{path}\n".encode())
+        proc.stdin.close()
+
+    thread = threading.Thread(target=feed)
+    thread.start()
+    for path in paths:
+        header = proc.stdout.readline().split()
+        if len(header) != 3 or header[1] != b"blob":
+            continue
+        size = int(header[2])
+        data = proc.stdout.read(min(size, HEAD_BYTES))
+        remaining = size - len(data)
+        while remaining > 0:
+            chunk = proc.stdout.read(min(remaining, 1 << 20))
+            if not chunk:
+                break
+            remaining -= len(chunk)
+        proc.stdout.read(1)
+        heads[path] = data
+    thread.join()
+    proc.wait()
+    return heads
+
+
