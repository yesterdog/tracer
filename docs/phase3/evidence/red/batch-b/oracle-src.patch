@@ -0,0 +1,225 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Sarvam responses to Transcript, Turn, Segment and UsageRecord (ADR 0024 rules 12 and 13)."""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Sequence
+from decimal import Decimal
+from fractions import Fraction
+from typing import Any, Final
+
+from tracer_evalcore.audio.chunker import ChunkPlan
+from tracer_evalcore.stt import SttContext, SttOutcome
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.events import IngestWarning
+from tracer_evalschema.ids import TranscriptId, TurnId, UsageRecordId
+from tracer_evalschema.language import normalize_language_label
+from tracer_evalschema.primitives import canonical_decimal_text
+from tracer_evalschema.transcript import Transcript, Turn
+from tracer_evalschema.usage import UsageRecord
+
+from tracer_evalproviders.sarvam.models import ChunkResponse
+
+__all__ = [
+    "MODEL_BASIS",
+    "ROUNDING_KEY",
+    "map_responses",
+    "map_usage_records",
+    "usage_audio_seconds",
+]
+
+PROVIDER: Final = "sarvam"
+MODEL_BASIS: Final = "requested_not_echoed"
+ROUNDING_KEY: Final = "tracer.audio_seconds_rounding"
+_SCALE: Final = 10**18
+
+
+def usage_audio_seconds(frames: int, rate: int) -> tuple[str, str]:
+    """``(canonical decimal text, "exact" | "half_even_18")`` of ``frames / rate`` seconds."""
+    exact = Fraction(frames, rate)
+    scaled = round(exact * _SCALE)  # Fraction.__round__ rounds half to even
+    text = canonical_decimal_text(Decimal(scaled).scaleb(-18))
+    return text, ("exact" if Fraction(scaled, _SCALE) == exact else "half_even_18")
+
+
+def _is_empty(text: str) -> bool:
+    return text.strip() == ""
+
+
+def _ordered(plan: ChunkPlan, responses: Sequence[ChunkResponse]) -> list[ChunkResponse]:
+    by_index: dict[int, ChunkResponse] = {}
+    for item in responses:
+        if item.chunk_index in by_index or not 0 <= item.chunk_index < len(plan.chunks):
+            raise ValueError("a response names a chunk twice or a chunk the plan does not have")
+        by_index[item.chunk_index] = item
+    return [by_index[i] for i in sorted(by_index)]
+
+
+def map_usage_records(
+    plan: ChunkPlan, responses: Sequence[ChunkResponse], *, model: str, context: SttContext
+) -> tuple[UsageRecord, ...]:
+    out = []
+    for item in _ordered(plan, responses):
+        chunk = plan.chunks[item.chunk_index]
+        seconds, rounding = usage_audio_seconds(chunk.frames, chunk.sample_rate_hz)
+        document: dict[str, Any] = {
+            "id": UsageRecordId.new(),
+            "schema_version": SCHEMA_VERSION,
+            "created_at": context.created_at,
+            "metadata": {
+                ROUNDING_KEY: rounding,
+                "tracer.model_basis": MODEL_BASIS,
+                "tracer.chunk_index": item.chunk_index,
+            },
+            "run_id": context.run_id,
+            "domain": "evaluation",
+            "stage": "stt",
+            "provider": PROVIDER,
+            "model": model,
+            "provider_call_ref": {
+                "system": PROVIDER,
+                "kind": "request_id",
+                "value": item.response.request_id,
+            },
+            "quantities": [
+                {"unit": "audio_input_seconds", "count": seconds},
+                {"unit": "requests", "count": 1},
+            ],
+            "source": "measured",
+            "raw": None,
+        }
+        if item.responded_at is not None:
+            document["occurred_at"] = item.responded_at
+        out.append(UsageRecord.model_validate(document))
+    return tuple(out)
+
+
+def _floor_ms(chunk_start: int, rate: int, seconds: Decimal) -> int:
+    return math.floor((Fraction(chunk_start, rate) + Fraction(seconds)) * 1000)
+
+
+def map_responses(
+    plan: ChunkPlan, responses: Sequence[ChunkResponse], *, model: str, context: SttContext
+) -> SttOutcome:
+    ordered = _ordered(plan, responses)
+    if [item.chunk_index for item in ordered] != list(range(len(plan.chunks))):
+        raise ValueError("a transcript needs one response for every chunk of the plan")
+    transcript_id = TranscriptId.new()
+    turns: list[Turn] = []
+    warnings: list[IngestWarning] = []
+    empty: list[int] = []
+    tags: list[str | None] = []
+    raws: list[str | None] = []
+    any_offsets = False
+    for item in ordered:
+        chunk = plan.chunks[item.chunk_index]
+        response = item.response
+        if _is_empty(response.transcript):
+            empty.append(item.chunk_index)
+            continue
+        label = response.language_code
+        tag: str | None = None
+        if label is not None:
+            trimmed = label.strip()
+            tag, notes = normalize_language_label(trimmed)
+            code = notes[0].code if notes else ("language_label_normalized" if trimmed != label else None)
+            if code is not None:
+                warnings.append(
+                    IngestWarning(
+                        code=code,
+                        path=f"/chunks/{item.chunk_index}/language_code",
+                        raw=label,
+                        message="the provider label was read as a language tag"
+                        if code == "language_label_normalized"
+                        else "the provider label is not a language tag; it is kept as received",
+                    )
+                )
+        tags.append(tag)
+        raws.append(label)
+        segments: list[dict[str, Any]] = []
+        outside = False
+        if response.phrases:
+            duration = Fraction(chunk.frames, chunk.sample_rate_hz)
+            outside = any(Fraction(p.end_seconds) > duration for p in response.phrases)
+            if outside:
+                warnings.append(
+                    IngestWarning(
+                        code="phrase_time_outside_chunk",
+                        path=f"/chunks/{item.chunk_index}/timestamps",
+                        message="a phrase ends after its chunk; no segment is made for the chunk",
+                    )
+                )
+            else:
+                for phrase in response.phrases:
+                    segments.append(
+                        {
+                            "granularity": "phrase",
+                            "text": phrase.text,
+                            "start_ms": _floor_ms(chunk.start_frame, chunk.sample_rate_hz, phrase.start_seconds),
+                            "end_ms": _floor_ms(chunk.start_frame, chunk.sample_rate_hz, phrase.end_seconds),
+                        }
+                    )
+        metadata: dict[str, Any] = {"tracer.chunk_index": item.chunk_index}
+        if response.language_probability is not None:
+            metadata["tracer.language_probability"] = canonical_decimal_text(
+                response.language_probability
+            )
+        turn: dict[str, Any] = {
+            "id": TurnId.new(),
+            "schema_version": SCHEMA_VERSION,
+            "created_at": context.created_at,
+            "metadata": metadata,
+            "transcript_id": transcript_id,
+            "seq": len(turns),
+            "role": "unknown",
+            "source": "our_stt",
+            "text": response.transcript,
+            "timing_source": "none",
+        }
+        if label is not None:
+            turn["language_raw"] = label
+            if tag is not None:
+                turn["language"] = tag
+        if segments:
+            any_offsets = True
+            turn["segments"] = segments
+            turn["timing_source"] = "audio_alignment"
+            turn["start_ms"] = min(s["start_ms"] for s in segments)
+            turn["end_ms"] = max(s["end_ms"] for s in segments)
+        turns.append(Turn.model_validate(turn))
+    detected: str | None = None
+    detected_raw: str | None = None
+    if tags and None not in tags and len(set(tags)) == 1:
+        detected = tags[0]
+        if len(set(raws)) == 1:
+            detected_raw = raws[0]
+    head: dict[str, Any] = {
+        "id": transcript_id,
+        "schema_version": SCHEMA_VERSION,
+        "created_at": context.created_at,
+        "metadata": {
+            "tracer.chunk_plan": plan.as_metadata(),
+            "tracer.empty_chunks": {"count": len(empty), "indexes": empty},
+            "tracer.model_basis": MODEL_BASIS,
+        },
+        "source": "our_stt",
+        "provider": PROVIDER,
+        "model": model,
+        "privacy": context.privacy,
+    }
+    if detected is not None:
+        head["detected_language"] = detected
+        if detected_raw is not None:
+            head["detected_language_raw"] = detected_raw
+    if any_offsets:
+        head["timeline_origin"] = {"kind": "artifact", "ref": context.audio_artifact_id}
+    transcript = Transcript.model_validate(head)
+    return SttOutcome(
+        transcript=transcript,
+        turns=tuple(turns),
+        usage=map_usage_records(plan, ordered, model=model, context=context),
+        warnings=tuple(warnings),
+        failure=None,
+    )
diff --color -ruN a/packages/evalproviders/src/tracer_evalproviders/sarvam/models.py b/packages/evalproviders/src/tracer_evalproviders/sarvam/models.py
--- a/packages/evalproviders/src/tracer_evalproviders/sarvam/models.py	1970-01-01 05:30:00
+++ b/packages/evalproviders/src/tracer_evalproviders/sarvam/models.py	2026-10-25 05:35:07
@@ -0,0 +1,170 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Sarvam request and response models (ADR 0024 rules 3, 6 and 8)."""
+
+from __future__ import annotations
+
+import json
+import math
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal, InvalidOperation
+from typing import Any, Final
+
+from tracer_evalcore.stt import SttLanguageNotSupportedError
+from tracer_evalschema.loader import loads_strict
+
+__all__ = [
+    "API_BASE_URL",
+    "DEFAULT_MODEL",
+    "FORM_FIELD_NAMES",
+    "MAX_RESPONSE_BYTES",
+    "STT_PATH",
+    "STT_URL",
+    "ChunkResponse",
+    "SarvamPhrase",
+    "SarvamRequest",
+    "SarvamResponseShapeError",
+    "SarvamSttResponse",
+    "language_code_for",
+    "parse_response",
+]
+
+API_BASE_URL: Final = "https://api.sarvam.ai"
+STT_PATH: Final = "/speech-to-text"
+STT_URL: Final = API_BASE_URL + STT_PATH
+DEFAULT_MODEL: Final = "saaras:v4"
+FORM_FIELD_NAMES: Final = ("file", "language_code", "model", "with_timestamps")
+MAX_RESPONSE_BYTES: Final = 1_048_576
+_UNKNOWN: Final = "unknown"
+
+
+def language_code_for(configured: str) -> str:
+    """The ``language_code`` form value for a configured language: ``mr`` is sent as
+    ``unknown`` so that the engine observes the language; every other value is refused."""
+    if configured != "mr":
+        raise SttLanguageNotSupportedError(reason="language_not_supported")
+    return _UNKNOWN
+
+
+@dataclass(frozen=True)
+class SarvamRequest:
+    model: str
+
+    def text_fields(self, configured_language: str) -> dict[str, str]:
+        return {
+            "language_code": language_code_for(configured_language),
+            "model": self.model,
+            "with_timestamps": "true",
+        }
+
+
+class SarvamResponseShapeError(ValueError):
+    def __init__(self, reason: str) -> None:
+        self.reason = reason
+        super().__init__(reason)
+
+
+@dataclass(frozen=True)
+class SarvamPhrase:
+    text: str = field(repr=False)
+    start_seconds: Decimal
+    end_seconds: Decimal
+
+
+@dataclass(frozen=True)
+class SarvamSttResponse:
+    request_id: str
+    transcript: str = field(repr=False)
+    language_code: str | None
+    language_probability: Decimal | None
+    phrases: tuple[SarvamPhrase, ...] | None
+
+
+@dataclass(frozen=True)
+class ChunkResponse:
+    chunk_index: int
+    response: SarvamSttResponse
+    responded_at: datetime | None
+    attempts: int
+
+
+def _number(value: Any, reason: str) -> Decimal:
+    if isinstance(value, bool) or not isinstance(value, Decimal):
+        raise SarvamResponseShapeError(reason)
+    if not value.is_finite():
+        raise SarvamResponseShapeError(reason)
+    return value
+
+
+def _decimal_loads(body: bytes) -> Any:
+    # numbers are read from their JSON text as Decimal, never through a float
+    text = body.decode("utf-8")
+    loads_strict(text)  # strict I-JSON checks: duplicates, NaN, depth
+    document = json.loads(text, parse_float=Decimal, parse_int=Decimal, parse_constant=_no_constant)
+    if _has_lone_surrogate(document):
+        raise ValueError("lone surrogate")
+    return document
+
+
+def _has_lone_surrogate(value: Any) -> bool:
+    if isinstance(value, str):
+        return any(0xD800 <= ord(c) <= 0xDFFF for c in value)
+    if isinstance(value, dict):
+        return any(_has_lone_surrogate(k) or _has_lone_surrogate(v) for k, v in value.items())
+    if isinstance(value, list):
+        return any(_has_lone_surrogate(v) for v in value)
+    return False
+
+
+def _no_constant(name: str) -> Any:
+    raise ValueError(name)
+
+
+def parse_response(body: bytes) -> SarvamSttResponse:
+    try:
+        document = _decimal_loads(body)
+    except Exception:  # noqa: BLE001 - every parser failure is one typed refusal
+        raise SarvamResponseShapeError("not_json") from None
+    if not isinstance(document, dict):
+        raise SarvamResponseShapeError("not_object")
+    request_id = document.get("request_id")
+    if not isinstance(request_id, str):
+        raise SarvamResponseShapeError("request_id_invalid")
+    transcript = document.get("transcript")
+    if not isinstance(transcript, str):
+        raise SarvamResponseShapeError("transcript_invalid")
+    language = document.get("language_code")
+    if language is not None and not isinstance(language, str):
+        raise SarvamResponseShapeError("language_code_invalid")
+    probability: Decimal | None = None
+    if "language_probability" in document:
+        probability = _number(document["language_probability"], "language_probability_invalid")
+        if not Decimal(0) <= probability <= Decimal(1):
+            raise SarvamResponseShapeError("language_probability_invalid")
+    phrases: tuple[SarvamPhrase, ...] | None = None
+    if "timestamps" in document:
+        phrases = _phrases(document["timestamps"])
+    return SarvamSttResponse(request_id, transcript, language, probability, phrases)
+
+
+def _phrases(stamps: Any) -> tuple[SarvamPhrase, ...]:
+    if not isinstance(stamps, dict):
+        raise SarvamResponseShapeError("timestamps_invalid")
+    words = stamps.get("words")
+    starts = stamps.get("start_time_seconds")
+    ends = stamps.get("end_time_seconds")
+    if not (isinstance(words, list) and isinstance(starts, list) and isinstance(ends, list)):
+        raise SarvamResponseShapeError("timestamps_invalid")
+    if not len(words) == len(starts) == len(ends):
+        raise SarvamResponseShapeError("timestamps_invalid")
+    out = []
+    for word, start, end in zip(words, starts, ends, strict=True):
+        if not isinstance(word, str):
+            raise SarvamResponseShapeError("timestamps_invalid")
+        begin = _number(start, "timestamps_invalid")
+        finish = _number(end, "timestamps_invalid")
+        if begin < 0 or finish < 0 or begin > finish or math.isnan(float(begin)):
+            raise SarvamResponseShapeError("timestamps_invalid")
+        out.append(SarvamPhrase(word, begin, finish))
+    return tuple(out)
