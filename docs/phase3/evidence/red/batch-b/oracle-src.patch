--- a/packages/evalproviders/src/tracer_evalproviders/secrets.py	1970-01-01 05:30:00
+++ b/packages/evalproviders/src/tracer_evalproviders/secrets.py	2026-10-25 05:39:18
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The API key at run time (ADR 0024 rules 4 and 5): a redacting wrapper and the loader."""
+
+from __future__ import annotations
+
+import os
+import re
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any, NoReturn
+
+from tracer_evalcore.stt import SttKeyMissingError
+from tracer_evalschema.provider import ProviderConfigRef
+
+__all__ = ["CONFIG_REF", "ENV_VAR_NAME", "PLACEHOLDER", "ApiKey", "load_api_key", "provider_config_ref"]
+
+ENV_VAR_NAME = "SARVAM_API_KEY"
+CONFIG_REF = "env:SARVAM_API_KEY"
+PLACEHOLDER = "<redacted api key>"
+_LINE = re.compile(rb"^[ \t]*(?:export[ \t]+)?SARVAM_API_KEY[ \t]*=(.*)$")
+
+
+class ApiKey:
+    """A key that cannot be printed, formatted, pickled or copied by accident."""
+
+    __slots__ = ("_value",)
+
+    def __init__(self, value: str) -> None:
+        if not isinstance(value, str) or value.strip() == "":
+            raise SttKeyMissingError(reason="key_missing")
+        if any(ord(c) < 0x21 or ord(c) > 0x7E for c in value):
+            raise SttKeyMissingError(reason="key_invalid")
+        object.__setattr__(self, "_value", value)
+
+    def reveal(self) -> str:
+        return self._value  # type: ignore[no-any-return]
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        raise AttributeError("an ApiKey is immutable")
+
+    def __str__(self) -> str:
+        return PLACEHOLDER
+
+    def __repr__(self) -> str:
+        return f"ApiKey({PLACEHOLDER})"
+
+    def __format__(self, spec: str) -> str:
+        return PLACEHOLDER
+
+    def __reduce__(self) -> NoReturn:
+        raise TypeError("an ApiKey cannot be pickled or copied")
+
+    def __eq__(self, other: object) -> bool:
+        return self is other
+
+    def __hash__(self) -> int:
+        return id(self)
+
+
+def _clean(raw: str | None) -> str | None:
+    if raw is None:
+        return None
+    value = raw.strip(" \t\r\n")
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
+        value = value[1:-1]
+    return value or None
+
+
+def _from_file(path: str | os.PathLike[str]) -> str | None:
+    data: bytes | None
+    try:
+        data = Path(path).read_bytes()
+    except OSError:
+        data = None
+    if data is None:  # raised outside the handler: the OSError is not kept as a context
+        raise SttKeyMissingError(reason="env_file_unreadable")
+    found: bytes | None = None
+    for line in data.splitlines():
+        match = _LINE.match(line)
+        if match:
+            found = match.group(1)
+    if found is None:
+        return None
+    try:
+        return found.decode("utf-8")
+    except UnicodeDecodeError:
+        pass
+    raise SttKeyMissingError(reason="key_invalid")
+
+
+def load_api_key(
+    *,
+    environ: Mapping[str, str] | None = None,
+    env_file: str | os.PathLike[str] | None = None,
+) -> ApiKey:
+    """The key from ``SARVAM_API_KEY``: from ``env_file`` when one is named (the environment is
+    then not consulted), else from ``environ`` (default ``os.environ``). Nothing else is read,
+    exported or quoted."""
+    if env_file is not None:
+        raw = _from_file(env_file)
+    else:
+        raw = (os.environ if environ is None else environ).get(ENV_VAR_NAME)
+    value = _clean(raw)
+    if value is None:
+        raise SttKeyMissingError(reason="key_missing")
+    return ApiKey(value)
+
+
+def provider_config_ref(model: str) -> ProviderConfigRef:
+    """What the Project records: the name of the key, never its value, never the env-file path."""
+    return ProviderConfigRef.model_validate(
+        {"provider": "sarvam", "model": model, "config_ref": CONFIG_REF}
+    )
