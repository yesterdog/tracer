diff --color -ruN a/packages/evalcore/src/tracer_evalcore/stt.py b/packages/evalcore/src/tracer_evalcore/stt.py
--- a/packages/evalcore/src/tracer_evalcore/stt.py	1970-01-01 05:30:00
+++ b/packages/evalcore/src/tracer_evalcore/stt.py	2026-10-25 06:09:10
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The speech-to-text engine boundary (ADR 0024 rules 1, 10 and 11): a protocol, the typed result
+and the provider-neutral error taxonomy. No network module is imported here."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Protocol, runtime_checkable
+
+from tracer_evalschema.events import IngestWarning
+from tracer_evalschema.ids import ArtifactId, RunId
+from tracer_evalschema.privacy import PrivacyMarker
+from tracer_evalschema.transcript import Transcript, Turn
+from tracer_evalschema.usage import UsageRecord
+
+from tracer_evalcore.audio.chunker import ChunkPlan
+from tracer_evalcore.errors import EvalcoreError
+
+__all__ = [
+    "SttAuthError",
+    "SttConfigurationError",
+    "SttContext",
+    "SttEngine",
+    "SttError",
+    "SttKeyMissingError",
+    "SttLanguageNotSupportedError",
+    "SttOutcome",
+    "SttRateLimited",
+    "SttRequestRejected",
+    "SttResponseInvalid",
+    "SttServerError",
+    "SttTransportError",
+]
+
+
+class SttError(EvalcoreError):
+    """Base of every speech-to-text failure. Holds machine facts only: never a message, a body,
+    a header, a key or audio."""
+
+    def __init__(
+        self,
+        *,
+        chunk_index: int | None = None,
+        status: int | None = None,
+        kind: str | None = None,
+        code: str | None = None,
+        request_id: str | None = None,
+        attempts: int | None = None,
+        reason: str | None = None,
+    ) -> None:
+        self.chunk_index = chunk_index
+        self.status = status
+        self.kind = kind
+        self.code = code
+        self.request_id = request_id
+        self.attempts = attempts
+        self.reason = reason
+        parts = []
+        if chunk_index is not None:
+            parts.append(f"chunk {chunk_index}")
+        if status is not None:
+            parts.append(f"HTTP {status}")
+        if kind is not None:
+            parts.append(f"transport {kind}")
+        if code is not None:
+            parts.append(f"code {code}")
+        if reason is not None:
+            parts.append(f"reason {reason}")
+        if request_id is not None:
+            parts.append(f"request {request_id}")
+        if attempts is not None:
+            parts.append(f"{attempts} attempt(s)")
+        super().__init__(f"{type(self).__name__}: " + ", ".join(parts) if parts else "")
+
+    def __reduce__(self) -> tuple[object, ...]:
+        return (_rebuild, (type(self), self.__dict__.copy()))
+
+
+def _rebuild(cls: type[SttError], state: dict[str, object]) -> SttError:
+    return cls(**state)  # type: ignore[arg-type]
+
+
+class SttAuthError(SttError):
+    """HTTP 401 or 403, or ``invalid_api_key_error``. Not retried; the run stops."""
+
+
+class SttRequestRejected(SttError):
+    """Any other 4xx except 429. Not retried."""
+
+
+class SttRateLimited(SttError):
+    """429 after the last attempt, or a ``Retry-After`` above the bound."""
+
+
+class SttServerError(SttError):
+    """5xx after the last attempt."""
+
+
+class SttTransportError(SttError):
+    """Connect, read or write error or timeout after the last attempt."""
+
+
+class SttResponseInvalid(SttError):
+    """A 200 body that is not the documented shape, a body over the cap, a non-JSON content
+    type, or a 1xx or 3xx status. Not retried."""
+
+
+class SttConfigurationError(SttError, ValueError):
+    """The run was configured so that no request may be sent."""
+
+
+class SttKeyMissingError(SttConfigurationError):
+    """The API key is missing, empty or unusable."""
+
+
+class SttLanguageNotSupportedError(SttConfigurationError):
+    """The configured language is not one the engine supports (BL-162)."""
+
+
+@dataclass(frozen=True)
+class SttContext:
+    """What an engine needs besides the audio: the run, the audio artifact, the clock value that
+    stamps every record, the privacy marker and the configured language."""
+
+    run_id: RunId
+    audio_artifact_id: ArtifactId
+    created_at: datetime
+    privacy: PrivacyMarker
+    configured_language: str
+
+
+@dataclass(frozen=True)
+class SttOutcome:
+    """A transcript or a failure, never both (ADR 0024 rule 11)."""
+
+    transcript: Transcript | None
+    turns: tuple[Turn, ...]
+    usage: tuple[UsageRecord, ...]
+    warnings: tuple[IngestWarning, ...]
+    failure: SttError | None
+
+    def __post_init__(self) -> None:
+        if (self.transcript is None) == (self.failure is None):
+            raise ValueError("an outcome holds a transcript or a failure, exactly one")
+        if self.failure is not None and (self.turns or self.warnings):
+            raise ValueError("a failed outcome holds no turn and no warning")
+
+
+@runtime_checkable
+class SttEngine(Protocol):
+    """Chunks in, a typed result or a typed failure out."""
+
+    def transcribe(self, plan: ChunkPlan, context: SttContext) -> SttOutcome: ...
diff --color -ruN a/packages/evalproviders/src/tracer_evalproviders/calllog.py b/packages/evalproviders/src/tracer_evalproviders/calllog.py
--- a/packages/evalproviders/src/tracer_evalproviders/calllog.py	1970-01-01 05:30:00
+++ b/packages/evalproviders/src/tracer_evalproviders/calllog.py	2026-10-25 05:30:10
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The local call log (ADR 0024 rule 15): two JSON lines per attempt, no text, no key."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from collections.abc import Callable
+from datetime import UTC, datetime
+from pathlib import Path
+
+__all__ = ["CALL_LOG_NAME", "CallLog", "safe_request_id"]
+
+CALL_LOG_NAME = "sarvam_call_log.jsonl"
+_SAFE_ID = re.compile(r"^[A-Za-z0-9_.:-]{1,128}$")
+_SAFE_KIND = re.compile(r"^[a-z0-9_]{1,64}$")
+
+
+def safe_request_id(value: object) -> str | None:
+    return value if isinstance(value, str) and _SAFE_ID.fullmatch(value) else None
+
+
+def _now() -> datetime:
+    return datetime.now(UTC)
+
+
+class CallLog:
+    def __init__(self, path: Path, *, clock: Callable[[], datetime] = _now) -> None:
+        self._path = path
+        self._clock = clock
+        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
+        os.fchmod(descriptor, 0o600)
+        self._descriptor = descriptor
+
+    @classmethod
+    def open(cls, out_dir: str | os.PathLike[str], *, clock: Callable[[], datetime] = _now) -> CallLog:
+        directory = Path(out_dir)
+        directory.mkdir(parents=True, exist_ok=True)
+        return cls(directory / CALL_LOG_NAME, clock=clock)
+
+    @property
+    def path(self) -> Path:
+        return self._path
+
+    def before(self, *, chunk_index: int, attempt: int, bytes_sent: int, audio_seconds: str) -> None:
+        self._write("before", chunk_index, attempt, bytes_sent, audio_seconds, None, None, None, None)
+
+    def after(
+        self,
+        *,
+        chunk_index: int,
+        attempt: int,
+        bytes_sent: int,
+        audio_seconds: str,
+        status: int | None,
+        error_kind: str | None,
+        elapsed_ms: int,
+        request_id: str | None,
+    ) -> None:
+        self._write(
+            "after", chunk_index, attempt, bytes_sent, audio_seconds, status, error_kind,
+            elapsed_ms, request_id,
+        )
+
+    def _write(
+        self, phase: str, chunk: int, attempt: int, sent: int, seconds: str,
+        status: int | None, kind: str | None, elapsed: int | None, request_id: str | None,
+    ) -> None:
+        at = self._clock().astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
+        line = {
+            "at": at,
+            "phase": phase,
+            "chunk": chunk,
+            "attempt": attempt,
+            "bytes_sent": sent,
+            "audio_seconds": seconds,
+            "status": status,
+            "error_kind": kind if kind is not None and _SAFE_KIND.fullmatch(kind) else None,
+            "elapsed_ms": elapsed,
+            "request_id": safe_request_id(request_id),
+        }
+        data = (json.dumps(line, separators=(",", ":"), ensure_ascii=True) + "\n").encode("ascii")
+        os.write(self._descriptor, data)
+        os.fsync(self._descriptor)
+
+    def close(self) -> None:
+        if self._descriptor >= 0:
+            os.close(self._descriptor)
+            self._descriptor = -1
diff --color -ruN a/packages/evalproviders/src/tracer_evalproviders/cost.py b/packages/evalproviders/src/tracer_evalproviders/cost.py
--- a/packages/evalproviders/src/tracer_evalproviders/cost.py	1970-01-01 05:30:00
+++ b/packages/evalproviders/src/tracer_evalproviders/cost.py	2026-10-25 05:43:41
@@ -0,0 +1,149 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Cost of our STT through the evalschema pricing functions (ADR 0024 rule 14; ADR 0014)."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Context
+from typing import Any
+
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.cost import CostRecord, CostSummary, compute_cost, summarize_costs
+from tracer_evalschema.digest import compute_digest
+from tracer_evalschema.ids import CostRecordId, CostSummaryId, PricingCatalogId
+from tracer_evalschema.loader import loads_strict
+from tracer_evalschema.pricing import PriceEntry, PriceProvenance, PricingCatalog
+from tracer_evalschema.usage import UsageRecord
+
+__all__ = ["CatalogRefusedError", "SttCost", "compute_stt_cost", "load_user_catalog"]
+
+
+class CatalogRefusedError(ValueError):
+    """The user's price file was refused. The message holds a short code, never a value."""
+
+    def __init__(self, reason: str) -> None:
+        self.reason = reason
+        super().__init__(reason)
+
+
+@dataclass(frozen=True)
+class SttCost:
+    records: tuple[CostRecord, ...]
+    summary: CostSummary
+
+
+def _parse_catalog(text: str, created_at: datetime) -> PricingCatalog | str:
+    """The catalog, or the short code of the refusal (no exception is raised in here)."""
+    try:
+        document = loads_strict(text)
+    except Exception:  # noqa: BLE001
+        return "catalog_not_json"
+    if (
+        not isinstance(document, dict)
+        or set(document) != {"published_at", "entries"}
+        or not isinstance(document["entries"], list)
+        or not document["entries"]
+    ):
+        return "catalog_shape"
+    try:
+        entries = [PriceEntry.model_validate(e) for e in document["entries"]]
+    except (ValueError, TypeError):
+        return "catalog_entry_invalid"
+    if any(e.price_source != "user_supplied" for e in entries):
+        return "catalog_entry_not_user_supplied"
+    try:  # the schema's own reading of an instant, through a model that has one
+        published = PriceProvenance.model_validate(
+            {"kind": "x", "retrieved_at": document["published_at"]}
+        ).retrieved_at
+    except (ValueError, TypeError):
+        return "catalog_invalid"
+    fields: dict[str, Any] = {
+        "id": PricingCatalogId.new(),
+        "schema_version": SCHEMA_VERSION,
+        "created_at": created_at,
+        "version": 1,
+        "entries": entries,
+        "published_at": published,
+    }
+    try:
+        draft = PricingCatalog.model_construct(**fields, content_digest=None)
+        dumped = draft.model_dump(mode="json", by_alias=True)
+        dumped.pop("content_digest")
+        dumped.setdefault("metadata", {})
+        dumped["metadata_flags"] = []
+        digest = compute_digest(dumped)
+        return PricingCatalog.model_validate(
+            {**dumped, "content_digest": digest.model_dump(mode="json", exclude_none=True)}
+        )
+    except (ValueError, TypeError):
+        return "catalog_invalid"
+
+
+def load_user_catalog(text: str, *, created_at: datetime) -> PricingCatalog:
+    """The user's USD price file ``{"published_at": ..., "entries": [...]}`` as a sealed catalog."""
+    result = _parse_catalog(text, created_at)
+    if isinstance(result, str):
+        raise CatalogRefusedError(result)
+    return result
+
+
+def compute_stt_cost(
+    usages: Sequence[UsageRecord],
+    *,
+    catalog: PricingCatalog | None,
+    created_at: datetime,
+    run_started_at: datetime | None = None,
+) -> SttCost:
+    """One cost record per usage record and their summary. Without a catalog every record is
+    ``not_available`` with ``no_price_for_model``; nothing is ever 0 and nothing is converted."""
+    context = Context(prec=200)
+    records: list[CostRecord] = []
+    groups: list[list[UsageRecord]] = [[u] for u in usages] or [[]]
+    for group in groups:
+        if catalog is None and group:
+            records.append(
+                CostRecord.model_validate(
+                    {
+                        "id": CostRecordId.new(),
+                        "schema_version": SCHEMA_VERSION,
+                        "created_at": created_at,
+                        "domain": "evaluation",
+                        "usage_record_ids": [u.id for u in group],
+                        "status": "not_available",
+                        "na_reason": "no_price_for_model",
+                    }
+                )
+            )
+        elif catalog is None:
+            records.append(
+                CostRecord.model_validate(
+                    {
+                        "id": CostRecordId.new(),
+                        "schema_version": SCHEMA_VERSION,
+                        "created_at": created_at,
+                        "domain": "evaluation",
+                        "usage_record_ids": [],
+                        "status": "not_available",
+                        "na_reason": "no_usage",
+                    }
+                )
+            )
+        else:
+            records.append(
+                compute_cost(
+                    group,
+                    catalog,
+                    domain="evaluation",
+                    record_id=CostRecordId.new(),
+                    created_at=created_at,
+                    context=context,
+                    run_started_at=run_started_at,
+                )
+            )
+    summary = summarize_costs(
+        records, domain="evaluation", summary_id=CostSummaryId.new(), created_at=created_at
+    )
+    return SttCost(records=tuple(records), summary=summary)
diff --color -ruN a/packages/evalproviders/src/tracer_evalproviders/dryrun.py b/packages/evalproviders/src/tracer_evalproviders/dryrun.py
--- a/packages/evalproviders/src/tracer_evalproviders/dryrun.py	1970-01-01 05:30:00
+++ b/packages/evalproviders/src/tracer_evalproviders/dryrun.py	2026-10-25 05:32:12
@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The pre-send plan of ``tracer score --dry-run`` (ADR 0024 rule 16): reads no key, opens no
+connection, sends nothing."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+
+from tracer_evalcore.audio.chunker import ChunkPlan
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.ids import RunId, UsageRecordId
+from tracer_evalschema.pricing import PricingCatalog
+from tracer_evalschema.usage import UsageRecord
+
+from tracer_evalproviders.cost import compute_stt_cost
+from tracer_evalproviders.sarvam.mapping import usage_audio_seconds
+
+__all__ = ["DryRunCost", "DryRunPlan", "build_dry_run_plan"]
+
+
+@dataclass(frozen=True)
+class DryRunCost:
+    status: str  # "estimated" | "not_available"
+    amount: str | None
+    na_reason: str | None
+
+
+@dataclass(frozen=True)
+class DryRunPlan:
+    chunks: int
+    calls: int
+    total_frames: int
+    sample_rate_hz: int
+    audio_seconds: Decimal
+    audio_seconds_rounding: str
+    max_chunk_ms: int
+    search_ms: int
+    cost: DryRunCost | None
+
+    def render(self) -> str:
+        seconds = format(self.audio_seconds, "f")
+        if "." in seconds:
+            seconds = seconds.rstrip("0").rstrip(".")
+        suffix = "" if self.audio_seconds_rounding == "exact" else " (rounded half-even to 18 digits)"
+        if self.cost is None:
+            cost = "cost: not available (no USD price supplied)"
+        elif self.cost.status == "estimated":
+            cost = f"cost: {self.cost.amount} USD (computed from the supplied USD price)"
+        else:
+            cost = f"cost: not available ({self.cost.na_reason})"
+        return "\n".join(
+            [
+                f"chunks: {self.chunks}",
+                f"audio seconds: {seconds}{suffix}",
+                f"calls: {self.calls}",
+                cost,
+            ]
+        )
+
+
+def build_dry_run_plan(
+    plan: ChunkPlan,
+    *,
+    model: str,
+    catalog: PricingCatalog | None = None,
+    priced_at: datetime | None = None,
+) -> DryRunPlan:
+    text, rounding = usage_audio_seconds(plan.total_frames, plan.sample_rate_hz)
+    cost: DryRunCost | None = None
+    if catalog is not None:
+        usages = [
+            UsageRecord.model_validate(
+                {
+                    "id": UsageRecordId.new(),
+                    "schema_version": SCHEMA_VERSION,
+                    "created_at": priced_at or catalog.created_at,
+                    "run_id": RunId.new(),
+                    "domain": "evaluation",
+                    "stage": "stt",
+                    "provider": "sarvam",
+                    "model": model,
+                    "quantities": [
+                        {
+                            "unit": "audio_input_seconds",
+                            "count": usage_audio_seconds(c.frames, c.sample_rate_hz)[0],
+                        },
+                        {"unit": "requests", "count": 1},
+                    ],
+                    "source": "measured",
+                }
+            )
+            for c in plan.chunks
+        ]
+        result = compute_stt_cost(
+            usages, catalog=catalog, created_at=catalog.created_at, run_started_at=priced_at
+        )
+        total = result.summary.total
+        if result.summary.completeness == "complete" and total is not None:
+            cost = DryRunCost("estimated", total.amount, None)
+        else:
+            reasons = [r.na_reason for r in result.records if r.na_reason is not None]
+            cost = DryRunCost("not_available", None, reasons[0] if reasons else "no_usage")
+    return DryRunPlan(
+        chunks=len(plan.chunks),
+        calls=len(plan.chunks),
+        total_frames=plan.total_frames,
+        sample_rate_hz=plan.sample_rate_hz,
+        audio_seconds=Decimal(text),
+        audio_seconds_rounding=rounding,
+        max_chunk_ms=plan.max_chunk_ms,
+        search_ms=plan.search_ms,
+        cost=cost,
+    )
