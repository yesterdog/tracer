diff --color -ruN a/packages/evalproviders/src/tracer_evalproviders/sarvam/client.py b/packages/evalproviders/src/tracer_evalproviders/sarvam/client.py
--- a/packages/evalproviders/src/tracer_evalproviders/sarvam/client.py	1970-01-01 05:30:00
+++ b/packages/evalproviders/src/tracer_evalproviders/sarvam/client.py	2026-10-25 05:37:13
@@ -0,0 +1,317 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The Sarvam HTTP client (ADR 0024 rules 2, 3, 5, 8, 9, 10): one chunk per request, fixed
+endpoint, bounded deterministic retries, a response cap and a typed error for every failure."""
+
+from __future__ import annotations
+
+import json
+import re
+import time
+from collections.abc import Callable
+from datetime import UTC, datetime
+from email.utils import parsedate_to_datetime
+from types import TracebackType
+from typing import Final
+
+import httpx
+from tracer_evalcore.audio.chunker import Chunk
+from tracer_evalcore.stt import (
+    SttAuthError,
+    SttConfigurationError,
+    SttError,
+    SttRateLimited,
+    SttRequestRejected,
+    SttResponseInvalid,
+    SttServerError,
+    SttTransportError,
+)
+
+from tracer_evalproviders.calllog import CallLog, safe_request_id
+from tracer_evalproviders.sarvam.mapping import usage_audio_seconds
+from tracer_evalproviders.sarvam.models import (
+    DEFAULT_MODEL,
+    MAX_RESPONSE_BYTES,
+    STT_URL,
+    ChunkResponse,
+    SarvamRequest,
+    SarvamResponseShapeError,
+    parse_response,
+)
+from tracer_evalproviders.secrets import ApiKey
+
+__all__ = [
+    "BACKOFF_SECONDS",
+    "CONNECT_TIMEOUT_SECONDS",
+    "MAX_ATTEMPTS",
+    "POOL_TIMEOUT_SECONDS",
+    "READ_TIMEOUT_SECONDS",
+    "RETRY_AFTER_MAX_SECONDS",
+    "WRITE_TIMEOUT_SECONDS",
+    "SarvamClient",
+]
+
+MAX_ATTEMPTS: Final = 4
+BACKOFF_SECONDS: Final = (1.0, 2.0, 4.0)
+RETRY_AFTER_MAX_SECONDS: Final = 30
+CONNECT_TIMEOUT_SECONDS: Final = 10.0
+POOL_TIMEOUT_SECONDS: Final = 10.0
+READ_TIMEOUT_SECONDS: Final = 60.0
+WRITE_TIMEOUT_SECONDS: Final = 60.0
+_MODEL = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$")
+_CODE = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
+_DIGITS = re.compile(r"^[0-9]+$", re.ASCII)
+_KINDS: Final = (
+    (httpx.ConnectTimeout, "connect_timeout"),
+    (httpx.ReadTimeout, "read_timeout"),
+    (httpx.WriteTimeout, "write_timeout"),
+    (httpx.PoolTimeout, "pool_timeout"),
+    (httpx.ConnectError, "connect_error"),
+    (httpx.ReadError, "read_error"),
+    (httpx.WriteError, "write_error"),
+)
+
+
+def _transport_kind(error: httpx.RequestError) -> str:
+    for cls, key in _KINDS:
+        if isinstance(error, cls):
+            return key
+    return "transport_error"
+
+
+def _http_date(value: str | None) -> datetime | None:
+    if not value:
+        return None
+    try:
+        parsed = parsedate_to_datetime(value)
+    except (TypeError, ValueError, IndexError):
+        return None
+    return parsed.astimezone(UTC) if parsed.tzinfo is not None else None
+
+
+def _retry_after(headers: httpx.Headers) -> int | None:
+    """The delay in whole seconds the server asks for, or ``None`` (absent or unparseable)."""
+    value = headers.get("retry-after")
+    if value is None:
+        return None
+    text = value.strip()
+    if _DIGITS.fullmatch(text):
+        return int(text)
+    moment = _http_date(text)
+    sent = _http_date(headers.get("date"))
+    if moment is None or sent is None:
+        return None
+    return max(0, int((moment - sent).total_seconds()))
+
+
+def _error_facts(headers: httpx.Headers, body: bytes | None) -> tuple[str, str | None]:
+    code = "unrecognised"
+    request_id = None
+    if body is not None:
+        try:
+            document = json.loads(body)
+        except (ValueError, RecursionError):
+            document = None
+        error = document.get("error") if isinstance(document, dict) else None
+        if isinstance(error, dict):
+            raw_code = error.get("code")
+            if isinstance(raw_code, str) and _CODE.fullmatch(raw_code):
+                code = raw_code
+            request_id = safe_request_id(error.get("request_id"))
+    if request_id is None:
+        request_id = safe_request_id(headers.get("x-request-id"))
+    return code, request_id
+
+
+class _Attempt:
+    def __init__(self) -> None:
+        self.status: int | None = None
+        self.headers = httpx.Headers()
+        self.body: bytes | None = None
+        self.oversize = False
+        self.kind: str | None = None
+        self.undecodable = False
+
+
+class SarvamClient:
+    def __init__(
+        self,
+        api_key: ApiKey,
+        *,
+        call_log: CallLog,
+        model: str = DEFAULT_MODEL,
+        transport: httpx.BaseTransport | None = None,
+        sleep: Callable[[float], None] = time.sleep,
+        monotonic: Callable[[], float] = time.monotonic,
+    ) -> None:
+        if not isinstance(api_key, ApiKey):
+            raise TypeError("api_key must be an ApiKey")
+        if not isinstance(model, str) or not _MODEL.fullmatch(model):
+            raise SttConfigurationError(reason="model_invalid")
+        self._key = api_key
+        self._model = model
+        self._log = call_log
+        self._sleep = sleep
+        self._monotonic = monotonic
+        self._http = httpx.Client(
+            transport=transport,
+            follow_redirects=False,
+            timeout=httpx.Timeout(
+                connect=CONNECT_TIMEOUT_SECONDS,
+                read=READ_TIMEOUT_SECONDS,
+                write=WRITE_TIMEOUT_SECONDS,
+                pool=POOL_TIMEOUT_SECONDS,
+            ),
+        )
+
+    @property
+    def model(self) -> str:
+        return self._model
+
+    def close(self) -> None:
+        self._http.close()
+
+    def __enter__(self) -> SarvamClient:
+        return self
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        tb: TracebackType | None,
+    ) -> None:
+        self.close()
+
+    def _once(self, chunk: Chunk, attempt: int, seconds: str) -> _Attempt:
+        fields = SarvamRequest(self._model).text_fields("mr")
+        request = self._http.build_request(
+            "POST",
+            STT_URL,
+            headers={"api-subscription-key": self._key.reveal()},
+            data=fields,
+            files={"file": (f"chunk-{chunk.index}.wav", chunk.wav, "audio/wav")},
+        )
+        sent = len(request.read())
+        self._log.before(
+            chunk_index=chunk.index, attempt=attempt, bytes_sent=sent, audio_seconds=seconds
+        )
+        result = _Attempt()
+        started = self._monotonic()
+        try:
+            response = self._http.send(request, stream=True)
+            try:
+                result.status = response.status_code
+                result.headers = response.headers
+                buffer = bytearray()
+                for piece in response.iter_bytes():
+                    buffer += piece
+                    if len(buffer) > MAX_RESPONSE_BYTES:
+                        result.oversize = True
+                        break
+                result.body = None if result.oversize else bytes(buffer)
+            finally:
+                response.close()
+        except httpx.DecodingError:
+            result.undecodable = True
+        except httpx.RequestError as error:
+            result.kind = _transport_kind(error)
+        finished = self._monotonic()
+        code, request_id = (
+            _error_facts(result.headers, result.body) if result.status is not None else ("", None)
+        )
+        if result.status == 200 and result.body is not None and not result.oversize:
+            try:
+                request_id = safe_request_id(json.loads(result.body).get("request_id"))
+            except (ValueError, AttributeError, RecursionError):
+                request_id = safe_request_id(result.headers.get("x-request-id"))
+        self._log.after(
+            chunk_index=chunk.index,
+            attempt=attempt,
+            bytes_sent=sent,
+            audio_seconds=seconds,
+            status=result.status,
+            error_kind=result.kind,
+            elapsed_ms=int((finished - started) * 1000),
+            request_id=request_id,
+        )
+        return result
+
+    def send_chunk(self, chunk: Chunk) -> ChunkResponse:
+        failure = self._send(chunk)
+        if isinstance(failure, SttError):
+            raise failure
+        return failure
+
+    def _send(self, chunk: Chunk) -> ChunkResponse | SttError:
+        seconds, _ = usage_audio_seconds(chunk.frames, chunk.sample_rate_hz)
+        error: SttError | None = None
+        for attempt in range(1, MAX_ATTEMPTS + 1):
+            result = self._once(chunk, attempt, seconds)
+            outcome = self._classify(chunk, attempt, result)
+            if isinstance(outcome, ChunkResponse):
+                return outcome
+            retry, error = outcome
+            if not retry or attempt == MAX_ATTEMPTS:
+                return error
+            wait = BACKOFF_SECONDS[attempt - 1]
+            if result.status in (429, 503):
+                asked = _retry_after(result.headers)
+                if asked is not None:
+                    if asked > RETRY_AFTER_MAX_SECONDS:
+                        return SttRateLimited(
+                            chunk_index=chunk.index,
+                            status=result.status,
+                            code=error.code,
+                            request_id=error.request_id,
+                            attempts=attempt,
+                            reason="retry_after_above_bound",
+                        )
+                    wait = max(wait, float(asked))
+            self._sleep(wait)
+        raise AssertionError("unreachable")  # pragma: no cover
+
+    def _classify(
+        self, chunk: Chunk, attempt: int, result: _Attempt
+    ) -> ChunkResponse | tuple[bool, SttError]:
+        facts = {"chunk_index": chunk.index, "attempts": attempt}
+        if result.kind is not None:
+            return True, SttTransportError(kind=result.kind, **facts)
+        if result.undecodable:
+            return False, SttResponseInvalid(reason="body_undecodable", **facts)
+        status = result.status
+        assert status is not None
+        if status == 200:
+            return self._success(chunk, attempt, result)
+        if status < 200 or status >= 300 and status < 400 or 200 < status < 300:
+            return False, SttResponseInvalid(status=status, reason="unexpected_status", **facts)
+        code, request_id = _error_facts(result.headers, result.body)
+        facts_http = {"status": status, "code": code, "request_id": request_id, **facts}
+        if status in (401, 403) or code == "invalid_api_key_error":
+            return False, SttAuthError(**facts_http)
+        if status == 429:
+            return True, SttRateLimited(**facts_http)
+        if status >= 500:
+            return True, SttServerError(**facts_http)
+        return False, SttRequestRejected(**facts_http)
+
+    def _success(
+        self, chunk: Chunk, attempt: int, result: _Attempt
+    ) -> ChunkResponse | tuple[bool, SttError]:
+        facts = {"chunk_index": chunk.index, "attempts": attempt, "status": 200}
+        media = result.headers.get("content-type", "").split(";")[0].strip().lower()
+        if media != "application/json":
+            return False, SttResponseInvalid(reason="content_type", **facts)
+        if result.oversize or result.body is None:
+            return False, SttResponseInvalid(reason="body_too_large", **facts)
+        try:
+            parsed = parse_response(result.body)
+        except SarvamResponseShapeError as shape:
+            reason = shape.reason
+        else:
+            return ChunkResponse(
+                chunk_index=chunk.index,
+                response=parsed,
+                responded_at=_http_date(result.headers.get("date")),
+                attempts=attempt,
+            )
+        return False, SttResponseInvalid(reason=reason, **facts)
