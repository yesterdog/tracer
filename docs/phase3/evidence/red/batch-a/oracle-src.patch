@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The deterministic chunker (ADR 0024 rule 7): windows of at most ``max_chunk_ms``, each cut
+inside its last ``search_ms`` at the lowest-energy 20 ms frame. Pure Python over ``array('h')``.
+
+Frames are counted from the window start, ``rate * 20 // 1000`` sample frames each; a frame is a
+candidate when it lies whole inside the last ``rate * search_ms // 1000`` frames of the window;
+its energy is the exact integer sum of squares over all channels; ties go to the latest frame;
+the cut is the frame's middle sample frame. Chunks are canonical 44-byte-header PCM WAV files.
+"""
+
+from __future__ import annotations
+
+import struct
+import sys
+from array import array
+from dataclasses import dataclass, field
+from decimal import Decimal
+from typing import Any
+
+from tracer_evalcore.audio.seconds import exact_seconds
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalcore.importers.wav import WavAudio
+
+__all__ = [
+    "DEFAULT_MAX_CHUNK_MS",
+    "DEFAULT_SEARCH_MS",
+    "ChannelsRefusedError",
+    "Chunk",
+    "ChunkPlan",
+    "ChunkerError",
+    "ChunkerInputError",
+    "ChunkerParameterError",
+    "chunk_pcm",
+    "chunk_wav",
+]
+
+DEFAULT_MAX_CHUNK_MS = 25_000
+DEFAULT_SEARCH_MS = 5_000
+_FRAME_MS = 20
+
+
+class ChunkerError(InputRefusedError):
+    """The chunker refused its input or its parameters."""
+
+
+class ChunkerParameterError(ChunkerError):
+    """A parameter is not an int in range, or the window cannot be cut."""
+
+
+class ChunkerInputError(ChunkerError):
+    """The audio is not a whole number of 16-bit sample frames."""
+
+
+class ChannelsRefusedError(ChunkerError):
+    """More than one channel without the explicit opt-in, or more than two channels."""
+
+
+@dataclass(frozen=True)
+class Chunk:
+    index: int
+    start_frame: int
+    end_frame: int
+    sample_rate_hz: int
+    channels: int
+    wav: bytes = field(repr=False)
+
+    @property
+    def frames(self) -> int:
+        return self.end_frame - self.start_frame
+
+    @property
+    def duration_seconds(self) -> Decimal | None:
+        return exact_seconds(self.frames, self.sample_rate_hz)
+
+    @property
+    def start_seconds(self) -> Decimal | None:
+        return exact_seconds(self.start_frame, self.sample_rate_hz)
+
+
+@dataclass(frozen=True)
+class ChunkPlan:
+    sample_rate_hz: int
+    channels: int
+    max_chunk_ms: int
+    search_ms: int
+    total_frames: int
+    chunks: tuple[Chunk, ...]
+
+    def as_metadata(self) -> dict[str, Any]:
+        return {
+            "format": "tracer.chunk_plan/1",
+            "max_chunk_ms": self.max_chunk_ms,
+            "search_ms": self.search_ms,
+            "sample_rate_hz": self.sample_rate_hz,
+            "channels": self.channels,
+            "total_frames": self.total_frames,
+            "chunks": [
+                {"index": c.index, "start_frame": c.start_frame, "end_frame": c.end_frame}
+                for c in self.chunks
+            ],
+        }
+
+
+def _int(name: str, value: object, minimum: int) -> int:
+    if type(value) is not int:
+        raise ChunkerParameterError(f"{name} must be an int")
+    if value < minimum:
+        raise ChunkerParameterError(f"{name} must be at least {minimum}")
+    return value
+
+
+def _wav_bytes(pcm: bytes, rate: int, channels: int) -> bytes:
+    return (
+        b"RIFF"
+        + struct.pack("<I", 36 + len(pcm))
+        + b"WAVE"
+        + b"fmt "
+        + struct.pack("<IHHIIHH", 16, 1, channels, rate, rate * channels * 2, channels * 2, 16)
+        + b"data"
+        + struct.pack("<I", len(pcm))
+        + pcm
+    )
+
+
+def chunk_pcm(
+    pcm: bytes,
+    *,
+    sample_rate_hz: int,
+    channels: int,
+    max_chunk_ms: int = DEFAULT_MAX_CHUNK_MS,
+    search_ms: int = DEFAULT_SEARCH_MS,
+    accept_provider_downmix: bool = False,
+) -> ChunkPlan:
+    rate = _int("sample_rate_hz", sample_rate_hz, 1)
+    count = _int("channels", channels, 1)
+    window_ms = _int("max_chunk_ms", max_chunk_ms, 1)
+    region_ms = _int("search_ms", search_ms, 0)
+    if region_ms > window_ms:
+        raise ChunkerParameterError("search_ms must not exceed max_chunk_ms")
+    if type(accept_provider_downmix) is not bool:
+        raise ChunkerParameterError("accept_provider_downmix must be a bool")
+    if count > 2 or (count == 2 and not accept_provider_downmix):
+        raise ChannelsRefusedError(
+            "more than one channel: the provider merges channels; pass "
+            "accept_provider_downmix=True to send two channels unchanged"
+        )
+    if not isinstance(pcm, bytes):
+        raise TypeError("pcm must be bytes")
+    frame_bytes = 2 * count
+    if len(pcm) % frame_bytes != 0:
+        raise ChunkerInputError("the audio is not a whole number of sample frames")
+    total = len(pcm) // frame_bytes
+    window = rate * window_ms // 1000
+    frame = rate * _FRAME_MS // 1000
+    region = rate * region_ms // 1000
+    ranges: list[tuple[int, int]] = []
+    if total > window:
+        samples = array("h")
+        samples.frombytes(pcm)
+        if sys.byteorder == "big":
+            samples.byteswap()
+        candidates = [
+            k
+            for k in range(window // frame)
+            if k * frame >= window - region and (k + 1) * frame <= window
+        ]
+        if not candidates:
+            raise ChunkerParameterError("no whole 20 ms frame lies in the search region")
+        start = 0
+        while total - start > window:
+            best_k = -1
+            best_energy = 0
+            for k in candidates:
+                low = (start + k * frame) * count
+                energy = sum(v * v for v in samples[low : low + frame * count])
+                if best_k < 0 or energy <= best_energy:
+                    best_k, best_energy = k, energy
+            cut = start + best_k * frame + frame // 2
+            ranges.append((start, cut))
+            start = cut
+        ranges.append((start, total))
+    elif total > 0:
+        ranges.append((0, total))
+    chunks = tuple(
+        Chunk(
+            index=index,
+            start_frame=first,
+            end_frame=last,
+            sample_rate_hz=rate,
+            channels=count,
+            wav=_wav_bytes(pcm[first * frame_bytes : last * frame_bytes], rate, count),
+        )
+        for index, (first, last) in enumerate(ranges)
+    )
+    return ChunkPlan(
+        sample_rate_hz=rate,
+        channels=count,
+        max_chunk_ms=window_ms,
+        search_ms=region_ms,
+        total_frames=total,
+        chunks=chunks,
+    )
+
+
+def chunk_wav(
+    audio: WavAudio,
+    *,
+    max_chunk_ms: int = DEFAULT_MAX_CHUNK_MS,
+    search_ms: int = DEFAULT_SEARCH_MS,
+    accept_provider_downmix: bool = False,
+) -> ChunkPlan:
+    return chunk_pcm(
+        audio.pcm,
+        sample_rate_hz=audio.sample_rate_hz,
+        channels=audio.channels,
+        max_chunk_ms=max_chunk_ms,
+        search_ms=search_ms,
+        accept_provider_downmix=accept_provider_downmix,
+    )
diff --git a/packages/evalcore/src/tracer_evalcore/audio/seconds.py b/packages/evalcore/src/tracer_evalcore/audio/seconds.py
