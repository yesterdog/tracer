@@ -0,0 +1,389 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""VoicEra-style transcript export reader: the F8 mapper promoted into the product.
+
+The file is a header line ``call_id=<id>``, a ``---`` line and message lines
+``[<timestamp>] <speaker>: <text>``. The mapping is the one of the F8 test mapper
+(``packages/evalschema/tests/support/mappings/voicera_transcript.py``): ``assistant`` is the agent,
+``user`` the caller, every line is an ``agent_log`` turn without timing or language. Differences
+from F8 (contract docs/phase3/api-surface-batch-a.md section 4): a warning that drops or alters
+content is a refusal unless ``accept_warnings=True``, and a call id with control or bidi characters
+is always refused, without echoing it.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Mapping
+from dataclasses import dataclass
+from datetime import UTC, datetime, timedelta, timezone
+from typing import Any
+
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.events import IngestWarning
+from tracer_evalschema.ids import ExternalRef, TranscriptId, TurnId
+from tracer_evalschema.text import replace_lone_surrogates
+from tracer_evalschema.transcript import LanguageDeclaration, Transcript, Turn
+
+__all__ = [
+    "NON_REFUSING_WARNING_CODES",
+    "VoicEraRead",
+    "VoicEraRefusedError",
+    "read_voicera_export",
+]
+
+NON_REFUSING_WARNING_CODES = frozenset(
+    {"call_id_not_uuid", "timestamp_not_parseable", "naive_timestamp", "time_precision_reduced"}
+)
+_UNSAFE_CALL_ID = frozenset(
+    chr(c) for c in (0x200E, 0x200F, 0x061C, *range(0x202A, 0x202F), *range(0x2066, 0x206A))
+)
+_HEADER = re.compile(r"call_id=(?P<value>.+)")
+_UUID = re.compile(r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}")
+_MESSAGE = re.compile(r"\[(?P<ts>[^\]]*)\] (?P<speaker>[^\s:]+):(?: (?P<text>.*))?")
+_INSTANT = re.compile(
+    r"(?P<y>[0-9]{4})-(?P<mo>[0-9]{2})-(?P<d>[0-9]{2})[T ](?P<h>[0-9]{2}):(?P<mi>[0-9]{2})"
+    r":(?P<s>[0-9]{2})(?:\.(?P<frac>[0-9]+))?(?P<zone>Z|[+-][0-9]{2}:[0-9]{2})?"
+)
+_ROLE = {"assistant": "agent", "user": "caller"}
+_BOM = "\ufeff"
+_TIME_MESSAGES = {
+    "timestamp_not_parseable": "the timestamp is not an ISO-8601 instant; no wall time is stored",
+    "naive_timestamp": "the timestamp has no zone; no wall time is stored",
+    "time_precision_reduced": "digits finer than a microsecond were cut",
+}
+_LISTED = 20
+
+
+class VoicEraRefusedError(InputRefusedError):
+    """The export was refused. ``warnings`` holds every warning of the read (they quote lines)."""
+
+    def __init__(self, message: str, warnings: tuple[IngestWarning, ...] = ()) -> None:
+        super().__init__(message)
+        self.warnings = warnings
+
+
+@dataclass(frozen=True)
+class VoicEraRead:
+    transcript: Transcript | None
+    turns: tuple[Turn, ...]
+    warnings: tuple[IngestWarning, ...]
+    external_refs: tuple[ExternalRef, ...]
+
+
+class _Warnings:
+    def __init__(self) -> None:
+        self.items: list[IngestWarning] = []
+        self._seen: set[tuple[str, str | None, str | None]] = set()
+
+    def warn(
+        self, code: str, message: str, *, path: str | None = None, raw: str | None = None
+    ) -> None:
+        shown_path = None if path is None else replace_lone_surrogates(path)
+        shown_raw = None if raw is None else replace_lone_surrogates(raw)
+        key = (code, shown_path, shown_raw)
+        if key in self._seen:
+            return
+        self._seen.add(key)
+        self.items.append(IngestWarning(code=code, path=shown_path, raw=shown_raw, message=message))
+
+    def text(self, value: str, source: str) -> str:
+        replaced = replace_lone_surrogates(value)
+        if replaced != value:
+            self.warn(
+                "text_not_valid_unicode",
+                "the text held a lone surrogate, stored with U+FFFD in its place",
+                path=source,
+                raw=replaced,
+            )
+        return replaced
+
+
+def _lines(text: str) -> list[str]:
+    pieces = text.split("\n")
+    if pieces and pieces[-1] == "":
+        pieces.pop()
+    out = [piece[:-1] if piece.endswith("\r") else piece for piece in pieces]
+    if out and out[0].startswith(_BOM):
+        out[0] = out[0][1:]
+    return out
+
+
+def _instant(stamp: str) -> tuple[str | None, str | None]:
+    found = _INSTANT.fullmatch(stamp)
+    if found is None:
+        return None, "timestamp_not_parseable"
+    zone = found["zone"]
+    if zone is None:
+        return None, "naive_timestamp"
+    try:
+        if zone == "Z":
+            offset = timedelta(0)
+        else:
+            hours, minutes = int(zone[1:3]), int(zone[4:6])
+            if hours > 23 or minutes > 59:
+                return None, "timestamp_not_parseable"
+            offset = timedelta(hours=hours, minutes=minutes)
+            if zone[0] == "-":
+                offset = -offset
+        fraction = found["frac"] or ""
+        micro = int(fraction[:6].ljust(6, "0"))
+        moment = datetime(
+            int(found["y"]),
+            int(found["mo"]),
+            int(found["d"]),
+            int(found["h"]),
+            int(found["mi"]),
+            int(found["s"]),
+            micro,
+            tzinfo=timezone(offset),
+        )
+        utc = moment.astimezone(UTC)
+        text = (
+            f"{utc.year:04d}-{utc.month:02d}-{utc.day:02d}T"
+            f"{utc.hour:02d}:{utc.minute:02d}:{utc.second:02d}.{utc.microsecond:06d}Z"
+        )
+    except (ValueError, OverflowError):
+        return None, "timestamp_not_parseable"
+    return text, ("time_precision_reduced" if len(fraction) > 6 else None)
+
+
+def _failing_fields(exc: ValueError) -> list[str] | None:
+    errors = getattr(exc, "errors", None)
+    if errors is None:
+        return None
+    try:
+        located = errors(include_input=False, include_url=False)
+    except TypeError:
+        return None
+    names: list[str] = []
+    for item in located:
+        loc = item.get("loc") or ()
+        if not loc:
+            return None
+        names.append(str(loc[0]))
+    return names
+
+
+def _build(
+    cls: Any,
+    fixed: dict[str, Any],
+    values: dict[str, Any],
+    caller: set[str],
+    note: _Warnings,
+    where: str | None,
+) -> Any | None:
+    """Build a record; an optional field the schema refuses is dropped with a warning, a record
+    that cannot be built without it is dropped with a warning (the F8 recorder's rule)."""
+    optional = {name for name, info in cls.model_fields.items() if not info.is_required()}
+    values = dict(values)
+    for _ in range(len(values) + 1):
+        try:
+            return cls(**fixed, **values)
+        except ValueError as exc:
+            bad = _failing_fields(exc)
+            if set(bad or []) & caller:
+                raise
+            dropped = [n for n in (bad or []) if n in values and n in optional]
+            if not dropped or len(dropped) != len(set(bad or [])):
+                note.warn(
+                    "malformed_entry",
+                    f"a {cls.__name__} could not be built from the source and was not stored",
+                    path=where,
+                )
+                return None
+            for name in dropped:
+                del values[name]
+                note.warn(
+                    "malformed_entry",
+                    f"{cls.__name__}.{name} is not valid for the schema and was not stored",
+                    path=where,
+                )
+    return None
+
+
+def read_voicera_export(
+    text: str,
+    *,
+    created_at: str | datetime,
+    privacy: Any,
+    declared_language: LanguageDeclaration | Mapping[str, Any] | None = None,
+    accept_warnings: bool = False,
+) -> VoicEraRead:
+    if not isinstance(text, str):
+        raise TypeError("an export is passed as decoded text")
+    if type(accept_warnings) is not bool:
+        raise TypeError("accept_warnings must be a bool")
+    # the caller's own arguments are checked first, whatever the content: the model raises
+    arguments: dict[str, Any] = {
+        "id": TranscriptId.new(),
+        "schema_version": SCHEMA_VERSION,
+        "created_at": created_at,
+        "source": "agent_export",
+        "privacy": privacy,
+        "declared_language": declared_language,
+    }
+    Transcript(**arguments)
+    note = _Warnings()
+    lines = _lines(text)
+    if all(line.strip() == "" for line in lines):
+        note.warn("empty_input", "the export has no line with content")
+        return _finish(None, [], note, [], accept_warnings)
+
+    transcript_id = TranscriptId.new()
+    head: dict[str, Any] = {"source": "agent_export"}
+    if declared_language is not None:
+        head["declared_language"] = declared_language
+    refs: list[ExternalRef] = []
+    header_ok = False
+    turns: list[Turn] = []
+    for index, line in enumerate(lines):
+        number = index + 1
+        where = f"f8:{number}"
+        if number == 1:
+            found = _HEADER.fullmatch(line)
+            if found is not None:
+                header_ok = True
+                value = found["value"]
+                if any(ch in _UNSAFE_CALL_ID or unicodedata.category(ch) == "Cc" for ch in value):
+                    raise VoicEraRefusedError(
+                        "the export header holds control or bidirectional characters in the "
+                        "call id: call_id_unsafe_characters at f8:1/call_id; refused"
+                    )
+                _header(note, head, refs, value)
+                continue
+            note.warn(
+                "header_not_recognized",
+                "the first line is not a call_id header",
+                path=where,
+                raw=line,
+            )
+        elif number == 2:
+            if line == "---":
+                continue
+            note.warn(
+                "delimiter_not_found",
+                "the second line is not the header delimiter",
+                path=where,
+                raw=line,
+            )
+            if _MESSAGE.fullmatch(line) is None:
+                continue
+        if line.strip() == "":
+            continue
+        message = _MESSAGE.fullmatch(line)
+        if message is None:
+            if number > 2:
+                note.warn("unparsed_line", "the line is not a message line", path=where, raw=line)
+            continue
+        turn = _message(note, transcript_id, where, message, len(turns), created_at)
+        if turn is not None:
+            turns.append(turn)
+
+    transcript: Transcript | None = None
+    if turns or header_ok:
+        transcript = _build(
+            Transcript,
+            {
+                "privacy": privacy,
+                "id": transcript_id,
+                "schema_version": SCHEMA_VERSION,
+                "created_at": created_at,
+            },
+            head,
+            {"privacy", "created_at"},
+            note,
+            None,
+        )
+    return _finish(transcript, turns, note, refs, accept_warnings)
+
+
+def _finish(
+    transcript: Transcript | None,
+    turns: list[Turn],
+    note: _Warnings,
+    refs: list[ExternalRef],
+    accept_warnings: bool,
+) -> VoicEraRead:
+    warnings = tuple(note.items)
+    dropping = [w for w in warnings if w.code not in NON_REFUSING_WARNING_CODES]
+    if dropping and not accept_warnings:
+        listed = ", ".join(
+            w.code if w.path is None else f"{w.code} at {w.path}" for w in dropping[:_LISTED]
+        )
+        more = f" and {len(dropping) - _LISTED} more" if len(dropping) > _LISTED else ""
+        raise VoicEraRefusedError(
+            f"the export was refused: {len(dropping)} warning(s) drop or alter content: "
+            f"{listed}{more}; pass accept_warnings=True to read it anyway",
+            warnings,
+        )
+    return VoicEraRead(transcript, tuple(turns), warnings, tuple(refs))
+
+
+def _header(note: _Warnings, head: dict[str, Any], refs: list[ExternalRef], value: str) -> None:
+    source = "f8:1/call_id"
+    if not _UUID.fullmatch(value):
+        note.warn(
+            "call_id_not_uuid",
+            "the call id is not shaped like a UUID and is kept as it is",
+            path=source,
+            raw=value,
+        )
+    if replace_lone_surrogates(value) != value:
+        note.warn(
+            "text_not_valid_unicode",
+            "an external identifier holds a lone surrogate and is not stored",
+            path=source,
+        )
+        return
+    refs.append(ExternalRef(system="voicera", kind="call_id", value=value))
+    head["provider_call_ref"] = {"system": "voicera", "kind": "call_id", "value": value}
+
+
+def _message(
+    note: _Warnings,
+    transcript_id: TranscriptId,
+    where: str,
+    message: re.Match[str],
+    seq: int,
+    created_at: str | datetime,
+) -> Turn | None:
+    speaker = message["speaker"]
+    role = _ROLE.get(speaker)
+    if role is None:
+        note.warn(
+            "unknown_enum_value",
+            "the speaker label is not assistant or user, so the line is not mapped",
+            path=f"{where}/speaker",
+            raw=speaker,
+        )
+        return None
+    values: dict[str, Any] = {
+        "seq": seq,
+        "role": role,
+        "source": "agent_log",
+        "timing_source": "none",
+        "text": note.text(message["text"] or "", f"{where}/text"),
+    }
+    stamp = message["ts"]
+    instant, code = _instant(stamp)
+    if instant is not None:
+        values["wall_time"] = {"at": instant, "meaning": "unknown"}
+    if code is not None:
+        note.warn(code, _TIME_MESSAGES[code], path=f"{where}/timestamp", raw=stamp)
+    turn: Turn | None = _build(
+        Turn,
+        {
+            "transcript_id": transcript_id,
+            "id": TurnId.new(),
+            "schema_version": SCHEMA_VERSION,
+            "created_at": created_at,
+        },
+        values,
+        {"transcript_id", "created_at"},
+        note,
+        where,
+    )
+    return turn
