index 0000000..417a36a
--- /dev/null
+++ b/packages/evalcore/src/tracer_evalcore/audio/seconds.py
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Exact durations: frames divided by the sample rate, as a Decimal or not at all."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from math import gcd
+
+__all__ = ["MAX_DECIMAL_SCALE", "exact_seconds"]
+
+#: The most fractional digits a canonical decimal of the schema carries (DecimalString).
+MAX_DECIMAL_SCALE = 18
+
+
+def exact_seconds(frames: int, rate: int) -> Decimal | None:
+    """``frames / rate`` seconds when a finite decimal with at most 18 fractional digits equals
+    it exactly, else ``None`` (never rounded, never a float)."""
+    if type(frames) is not int or type(rate) is not int:
+        raise TypeError("frames and rate must be int")
+    if frames < 0:
+        raise ValueError("frames must not be negative")
+    if rate <= 0:
+        raise ValueError("rate must be positive")
+    divisor = gcd(frames, rate)
+    numerator, denominator = frames // divisor, rate // divisor
+    twos = fives = 0
+    rest = denominator
+    while rest % 2 == 0:
+        rest //= 2
+        twos += 1
+    while rest % 5 == 0:
+        rest //= 5
+        fives += 1
+    if rest != 1:
+        return None
+    scale = max(twos, fives)
+    if scale > MAX_DECIMAL_SCALE:
+        return None
+    scaled = numerator * (10**scale // denominator)
+    return Decimal(scaled).scaleb(-scale)
