@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""WAV reader: one 16-bit PCM file to an Artifact, the exact duration and the samples.
+
+Plain PCM (format tag 1), 16 bits, at least one channel. The header is parsed here, byte by
+byte, so that the result does not depend on the Python version; sizes in the header are compared
+with the file and never used to allocate.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import stat
+import struct
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+from pathlib import Path
+from typing import Any
+
+from tracer_evalcore.audio.seconds import exact_seconds
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.artifact import Artifact, AudioFormat
+from tracer_evalschema.ids import ArtifactId
+from tracer_evalschema.privacy import ConsentRecord, PrivacyMarker, RetentionPolicy
+
+__all__ = [
+    "DEFAULT_MAX_WAV_BYTES",
+    "WavAudio",
+    "WavError",
+    "WavMalformedError",
+    "WavTooLargeError",
+    "WavTruncatedError",
+    "WavUnsupportedFormatError",
+    "read_wav",
+]
+
+DEFAULT_MAX_WAV_BYTES = 1_073_741_824
+
+
+class WavError(InputRefusedError):
+    """A WAV file was refused."""
+
+
+class WavMalformedError(WavError):
+    """Not a WAV file, or a header that contradicts itself."""
+
+
+class WavTruncatedError(WavError):
+    """The file ends before the bytes its header declares."""
+
+
+class WavUnsupportedFormatError(WavError):
+    """Not plain 16-bit PCM, or no channel, or a rate of zero."""
+
+
+class WavTooLargeError(WavError):
+    """The file is larger than the cap; it was not read."""
+
+
+@dataclass(frozen=True)
+class WavAudio:
+    artifact: Artifact
+    frames: int
+    sample_rate_hz: int
+    channels: int
+    duration_seconds: Decimal | None
+    pcm: bytes = field(repr=False)
+
+
+def read_wav(
+    path: str | os.PathLike[str],
+    *,
+    created_at: str | datetime,
+    consent: ConsentRecord,
+    retention: RetentionPolicy,
+    max_bytes: int = DEFAULT_MAX_WAV_BYTES,
+) -> WavAudio:
+    if type(max_bytes) is not int:
+        raise TypeError("max_bytes must be an int")
+    if max_bytes <= 0:
+        raise ValueError("max_bytes must be positive")
+    if not isinstance(consent, ConsentRecord):
+        raise TypeError("consent must be a ConsentRecord")
+    if not isinstance(retention, RetentionPolicy):
+        raise TypeError("retention must be a RetentionPolicy")
+    resolved = Path(path).resolve(strict=True)
+    with open(resolved, "rb") as handle:
+        info = os.fstat(handle.fileno())
+        if not stat.S_ISREG(info.st_mode):
+            raise WavMalformedError("not a regular file")
+        if info.st_size > max_bytes:
+            raise WavTooLargeError(f"file of {info.st_size} bytes is over the cap of {max_bytes}")
+        # the buffer is sized by the file, never by the cap; one byte more detects a file that grew
+        content = handle.read(info.st_size + 1)
+    if len(content) > max_bytes or len(content) > info.st_size:
+        raise WavTooLargeError(f"file is over the cap of {max_bytes} bytes or changed while read")
+    channels, rate, pcm = _parse(content)
+    frames = len(pcm) // (2 * channels)
+    fields: dict[str, Any] = {
+        "id": ArtifactId.new(),
+        "schema_version": SCHEMA_VERSION,
+        "created_at": created_at,  # the model parses the RFC 3339 text
+        "uri": resolved.as_uri(),
+        "sha256": hashlib.sha256(content).hexdigest(),
+        "size": len(content),
+        "audio_format": AudioFormat(
+            container="wav",
+            codec="pcm_s16le",
+            sample_rate_hz=rate,
+            channels=channels,
+            bits_per_sample=16,
+        ),
+        "privacy": PrivacyMarker(human_subject=True, consent=consent, retention=retention),
+    }
+    artifact = Artifact(**fields)
+    return WavAudio(
+        artifact=artifact,
+        frames=frames,
+        sample_rate_hz=rate,
+        channels=channels,
+        duration_seconds=exact_seconds(frames, rate),
+        pcm=pcm,
+    )
+
+
+def _parse(content: bytes) -> tuple[int, int, bytes]:
+    if len(content) < 12 or content[:4] != b"RIFF" or content[8:12] != b"WAVE":
+        raise WavMalformedError("not a RIFF/WAVE file")
+    position = 12
+    fmt: tuple[int, int] | None = None
+    while position + 8 <= len(content):
+        chunk_id = content[position : position + 4]
+        (size,) = struct.unpack_from("<I", content, position + 4)
+        body = position + 8
+        if chunk_id == b"fmt ":
+            if body + size > len(content):
+                raise WavTruncatedError("the file ends inside the fmt chunk")
+            fmt = _parse_fmt(content, body, size)
+        elif chunk_id == b"data":
+            if fmt is None:
+                raise WavMalformedError("the data chunk comes before the fmt chunk, or none")
+            available = len(content) - body
+            if size > available:
+                raise WavTruncatedError(
+                    f"the data chunk declares {size} bytes but {available} follow"
+                )
+            channels, rate = fmt
+            if size % (2 * channels) != 0:
+                raise WavTruncatedError("the data chunk ends inside a frame")
+            return channels, rate, bytes(content[body : body + size])
+        position = body + size + (size & 1)
+    if fmt is None:
+        raise WavMalformedError("no fmt chunk")
+    raise WavMalformedError("no data chunk")
+
+
+def _parse_fmt(content: bytes, body: int, size: int) -> tuple[int, int]:
+    if size < 16:
+        raise WavMalformedError("the fmt chunk is shorter than 16 bytes")
+    tag, channels, rate, _byte_rate, block_align, bits = struct.unpack_from(
+        "<HHIIHH", content, body
+    )
+    if tag != 1:
+        raise WavUnsupportedFormatError(f"format tag {tag} is not plain PCM")
+    if bits != 16:
+        raise WavUnsupportedFormatError(f"{bits}-bit samples are not read; only 16-bit PCM")
+    if channels == 0:
+        raise WavUnsupportedFormatError("the file declares no channel")
+    if rate == 0:
+        raise WavUnsupportedFormatError("the file declares a sample rate of zero")
+    if block_align != channels * 2:
+        raise WavMalformedError("the block alignment contradicts the channels")
+    return channels, rate
