+def phase3_findings(lock: Lock, policy: Policy) -> list[Finding]:
+    """The Phase 3 packages: the third-party closure of each is frozen, and every third-party
+    runtime dependency is a bounded range (workspace packages are pinned exactly)."""
+    out: list[Finding] = []
+    for key, project in PHASE3_PROJECTS.items():
+        lp = lock.packages.get(norm_name(project))
+        if lp is None or not policy.phase3_closure[key]:
+            continue
+
+        def fail(note: str, project: str = project, version: str = lp.version) -> None:
+            out.append(Finding(project, version, "?", "FAIL", note))
+
+        reached = lock.closure([project]) - {norm_name(project)}
+        third_party = {n for n in reached if "editable" not in lock.packages[n].source}
+        expected = set(policy.phase3_closure[key])
+        if third_party != expected:
+            fail(
+                f"runtime closure changed: extra {sorted(third_party - expected)}, "
+                f"missing {sorted(expected - third_party)}"
+            )
+        for r in lp.requires_dist:
+            if norm_name(r["name"]) in lock.packages and (
+                "editable" in lock.packages[norm_name(r["name"])].source
+            ):
+                continue  # a workspace package: pinned exactly in pyproject
+            if not re.fullmatch(r">=\d+(\.\d+)*,<\d+(\.\d+)*", str(r.get("specifier", ""))):
+                fail(f"runtime dependency {r['name']} not declared as a bounded range (>=X,<Y)")
+    return out
+
