+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The store of a scored run: a SQLite file in the output directory, through tracer-evaldb."""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import tracer_evaldb
+from tracer_evalschema.agent import AgentTarget
+from tracer_evalschema.bundle import RunBundle
+from tracer_evalschema.ids import RunBundleId
+from tracer_evalschema.project import Project
+
+__all__ = ["STORE_FILE_NAME", "StoredRun", "load_run", "open_sqlite_store", "store_run"]
+
+STORE_FILE_NAME = "tracer.sqlite"
+
+
+@dataclass(frozen=True)
+class StoredRun:
+    bundle_id: RunBundleId
+    created: bool
+    inserted: dict[str, int]
+
+
+def open_sqlite_store(out_dir: str | os.PathLike[str]) -> Any:
+    directory = Path(out_dir)
+    directory.mkdir(parents=True, exist_ok=True)
+    path = (directory / STORE_FILE_NAME).resolve()
+    engine = tracer_evaldb.create_store_engine(f"sqlite:///{path}")
+    tracer_evaldb.migrate.upgrade(engine)
+    tracer_evaldb.open_store(engine)
+    return engine
+
+
+def store_run(engine: Any, *, project: Project, agent_target: AgentTarget, bundle: RunBundle) -> StoredRun:
+    tracer_evaldb.store_project(engine, project)
+    tracer_evaldb.store_definition(engine, agent_target)
+    tracer_evaldb.store_snapshot(engine, bundle.snapshot)
+    result = tracer_evaldb.store_run_bundle(engine, bundle)
+    return StoredRun(bundle.id, result.created, dict(result.inserted))
+
+
+def load_run(engine: Any, bundle_id: RunBundleId) -> RunBundle:
+    loaded = tracer_evaldb.load_run_bundle(engine, bundle_id)
+    assert loaded.bundle is not None  # noqa: S101
+    return loaded.bundle
diff --git a/packages/evalcore/src/tracer_evalcore/definitions.py b/packages/evalcore/src/tracer_evalcore/definitions.py
new file mode 100644
index 0000000..2ffb65d
--- /dev/null
+++ b/packages/evalcore/src/tracer_evalcore/definitions.py
@@ -0,0 +1,359 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Metric definition templates, the recorded-run configuration and its binding parameters."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from datetime import datetime
+from decimal import Decimal
+from typing import Any
+
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.agent import AgentTarget
+from tracer_evalschema.digest import compute_digest
+from tracer_evalschema.evaluator import MAX_DURATION_MS, Evaluator, evaluator_digest_domain
+from tracer_evalschema.ids import (
+    AgentTargetId,
+    ConfigSnapshotId,
+    EvaluatorId,
+    MetricBindingId,
+    MetricDefinitionId,
+    PersonaId,
+    ProjectId,
+    RubricId,
+    TypedId,
+)
+from tracer_evalschema.metrics import MetricBinding, MetricDefinition
+from tracer_evalschema.persona import Persona
+from tracer_evalschema.primitives import canonical_decimal_text
+from tracer_evalschema.project import Project
+from tracer_evalschema.provider import ProviderConfigRef
+from tracer_evalschema.rubric import Rubric
+from tracer_evalschema.snapshot import ConfigSnapshot, compute_snapshot_digest
+
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalcore.flags import ThresholdError, parse_threshold
+from tracer_evalcore.normalise import SUPPORTED_NORMALISERS
+from tracer_evalcore.registry import (
+    COUNT_KEY,
+    DEFAULT_REGISTRY,
+    MER_KEY,
+    SHARE_KEY,
+    SHIPPED_KEYS,
+    ScorerRegistry,
+    check_runnable,
+    implementation_ref,
+)
+from tracer_evalcore.rubricfile import RubricFileError, RubricSpec
+
+__all__ = [
+    "BindingParameterError",
+    "COUNT_KEY",
+    "EVALUATOR_NAME",
+    "MER_KEY",
+    "PARAMETER_NAMES",
+    "PLACEHOLDER_KEY",
+    "RECORDED_ENDPOINT_URL",
+    "SHARE_KEY",
+    "SHIPPED_KEYS",
+    "RecordedConfiguration",
+    "ScoringParameters",
+    "build_configuration",
+    "check_binding_parameters",
+    "parameters_of",
+    "recorded_agent_target",
+    "recorded_project",
+    "shipped_definition",
+    "shipped_definitions",
+]
+
+PARAMETER_NAMES = ("flag_min_confidence", "normaliser")
+PLACEHOLDER_KEY = "recorded_call_no_outcome_check"
+EVALUATOR_NAME = "recorded-call agreement scoring"
+RECORDED_ENDPOINT_URL = "wss://recorded-call.invalid/"
+_UNITS = {MER_KEY: "ratio", COUNT_KEY: "count", SHARE_KEY: "ratio"}
+_SECOND = ("transcript", "agent_transcript")
+
+
+class BindingParameterError(InputRefusedError):
+    """A binding parameter is missing, invalid, unequal across bindings or names no normaliser."""
+
+    def __init__(self, code: str, key: str | None = None, parameter: str | None = None) -> None:
+        self.code = code
+        self.key = key
+        self.parameter = parameter
+        super().__init__(f"{code}: {key} {parameter}")
+
+
+@dataclass(frozen=True)
+class ScoringParameters:
+    flag_min_confidence: Decimal
+    normaliser: str
+
+
+def _doc_base(entity_id: TypedId, created_at: datetime, *, version: int | None) -> dict[str, Any]:
+    doc: dict[str, Any] = {
+        "id": str(entity_id),
+        "schema_version": SCHEMA_VERSION,
+        "created_at": _instant(created_at),
+        "metadata": {},
+        "metadata_flags": [],
+    }
+    if version is not None:
+        doc["version"] = version
+    return doc
+
+
+def _instant(moment: datetime) -> str:
+    return moment.strftime("%Y-%m-%dT%H:%M:%S.%f") + "Z"
+
+
+def _seal(cls: Any, doc: dict[str, Any]) -> Any:
+    subject = evaluator_digest_domain(doc) if cls is Evaluator else doc
+    digest = compute_digest(subject).model_dump(mode="json", exclude_none=True)
+    return cls.model_validate({**doc, "content_digest": digest})
+
+
+def _ref(record: Any) -> dict[str, Any]:
+    return {
+        "id": str(record.id),
+        "version": record.version,
+        "content_digest": record.content_digest.model_dump(mode="json", exclude_none=True),
+    }
+
+
+def _definition_doc(key: str, created_at: datetime, pass_rule: Mapping[str, Any] | None) -> dict[str, Any]:
+    doc = _doc_base(MetricDefinitionId.new(), created_at, version=1)
+    doc.update(
+        {
+            "key": key,
+            "kind": "deterministic",
+            "value_type": "numeric",
+            "unit": _UNITS[key],
+            "requires": list(_SECOND),
+            "languages": ["mr"],
+            "script_sensitive": False,
+            "aggregation": {"kind": "per_conversation"},
+            "pass_rule": None if pass_rule is None else dict(pass_rule),
+            "parameters": [
+                {"name": "flag_min_confidence", "value_type": "number"},
+                {"name": "normaliser", "value_type": "string"},
+            ],
+            "implementation_ref": implementation_ref(key),
+        }
+    )
+    return doc
+
+
+def shipped_definition(key: str, *, created_at: datetime) -> MetricDefinition:
+    if key not in SHIPPED_KEYS:
+        raise ValueError("not a shipped metric key")
+    built: MetricDefinition = _seal(MetricDefinition, _definition_doc(key, created_at, None))
+    return built
+
+
+def shipped_definitions(*, created_at: datetime) -> tuple[MetricDefinition, ...]:
+    return tuple(shipped_definition(key, created_at=created_at) for key in SHIPPED_KEYS)
+
+
+# ---------------------------------------------------------------------------- parameters
+
+
+def _threshold(value: object, key: str) -> Decimal:
+    if type(value) not in (int, float):
+        raise BindingParameterError("binding_param_invalid", key, "flag_min_confidence")
+    try:
+        return parse_threshold(value)  # type: ignore[arg-type]
+    except (ThresholdError, ValueError, TypeError):
+        raise BindingParameterError("binding_param_invalid", key, "flag_min_confidence") from None
+
+
+def check_binding_parameters(params_by_key: Mapping[str, Mapping[str, Any]]) -> ScoringParameters:
+    found: list[ScoringParameters] = []
+    for key in SHIPPED_KEYS:
+        params = params_by_key.get(key)
+        if params is None:
+            raise BindingParameterError("binding_param_missing", key, None)
+        for name in PARAMETER_NAMES:
+            if params.get(name) is None:
+                raise BindingParameterError("binding_param_missing", key, name)
+        threshold = _threshold(params["flag_min_confidence"], key)
+        normaliser = params["normaliser"]
+        if not isinstance(normaliser, str):
+            raise BindingParameterError("binding_param_invalid", key, "normaliser")
+        if normaliser not in SUPPORTED_NORMALISERS:
+            raise BindingParameterError("normaliser_unknown", key, "normaliser")
+        found.append(ScoringParameters(threshold, normaliser))
+    if any(item != found[0] for item in found[1:]):
+        raise BindingParameterError("binding_param_unequal")
+    return found[0]
+
+
+# ------------------------------------------------------------------------ configuration
+
+
+@dataclass(frozen=True)
+class RecordedConfiguration:
+    snapshot: ConfigSnapshot
+
+    def definition(self, key: str) -> MetricDefinition:
+        for definition in self.snapshot.metric_definitions:
+            if definition.key == key:
+                return definition
+        raise KeyError(key)
+
+    def binding(self, key: str) -> MetricBinding:
+        definition = self.definition(key)
+        for binding in self.snapshot.metric_bindings:
+            if binding.metric.id == definition.id:
+                return binding
+        raise KeyError(key)
+
+
+def parameters_of(snapshot: ConfigSnapshot) -> ScoringParameters:
+    configuration = RecordedConfiguration(snapshot)
+    params: dict[str, Mapping[str, Any]] = {}
+    for key in SHIPPED_KEYS:
+        try:
+            params[key] = configuration.binding(key).params
+        except KeyError:
+            continue
+    return check_binding_parameters(params)
+
+
+def _placeholder_doc(created_at: datetime) -> dict[str, Any]:
+    doc = _doc_base(MetricDefinitionId.new(), created_at, version=1)
+    doc.update(
+        {
+            "key": PLACEHOLDER_KEY,
+            "kind": "llm_judge",
+            "value_type": "boolean",
+            "requires": ["transcript"],
+            "languages": "language_independent",
+            "script_sensitive": False,
+            "aggregation": {"kind": "per_conversation"},
+            "pass_rule": {"kind": "equals_true"},
+            "parameters": [],
+            "prompt_template": (
+                "Placeholder required by schema 0.0.1. No judge is run for a recorded call and "
+                "no outcome is evaluated: {{expected_outcome}}"
+            ),
+            "prompt_variables": ["expected_outcome"],
+            "judge_model_ref": {"provider": "none", "model": "not_run"},
+        }
+    )
+    return doc
+
+
+def build_configuration(
+    spec: RubricSpec,
+    *,
+    configured_language: str,
+    created_at: datetime,
+    registry: ScorerRegistry = DEFAULT_REGISTRY,
+) -> RecordedConfiguration:
+    if not any(
+        i.metric == SHARE_KEY and i.required and i.pass_rule is not None for i in spec.items
+    ):
+        raise RubricFileError("rubric_budget_missing")
+    params = {"flag_min_confidence": spec.flag_min_confidence, "normaliser": spec.normaliser}
+    check_binding_parameters(dict.fromkeys(SHIPPED_KEYS, params))
+    rules = {item.metric: item.pass_rule for item in spec.items}
+    definitions: list[MetricDefinition] = []
+    for key in SHIPPED_KEYS:
+        rule = rules.get(key)
+        pass_rule = None if rule is None else rule.model_dump(mode="json", exclude_none=True)
+        definitions.append(_seal(MetricDefinition, _definition_doc(key, created_at, pass_rule)))
+    placeholder: MetricDefinition = _seal(MetricDefinition, _placeholder_doc(created_at))
+    definitions.append(placeholder)
+    check_runnable(definitions, registry)
+    persona = _seal(
+        Persona,
+        {**_doc_base(PersonaId.new(), created_at, version=1), "language": configured_language},
+    )
+    evaluator_id = EvaluatorId.new()
+    bindings: list[MetricBinding] = []
+    for definition in definitions:
+        doc = _doc_base(MetricBindingId.new(), created_at, version=1)
+        doc.update(
+            {
+                "evaluator_id": str(evaluator_id),
+                "metric": _ref(definition),
+                "params": dict(params) if definition.key in SHIPPED_KEYS else {},
+                "enabled": True,
+            }
+        )
+        bindings.append(_seal(MetricBinding, doc))
+    evaluator_doc = _doc_base(evaluator_id, created_at, version=1)
+    evaluator_doc.update(
+        {
+            "name": EVALUATOR_NAME,
+            "language": configured_language,
+            "instructions": (
+                "This run scores a recorded call. No call was simulated. The agreement between "
+                "the agent's own transcript export and our speech-to-text transcript of the "
+                "recording is measured, and the export spans that disagree are flagged for a "
+                "person to read."
+            ),
+            "expected_outcome": "No outcome is evaluated in this run; the recording is scored only.",
+            "persona": _ref(persona),
+            "metric_bindings": [_ref(b) for b in bindings],
+            "scripted_turns": [],
+            "expected_tool_calls": [],
+            "max_duration_ms": MAX_DURATION_MS,
+        }
+    )
+    evaluator: Evaluator = _seal(Evaluator, evaluator_doc)
+    by_definition = {b.metric.id: b for b in bindings}
+    placeholder_binding = by_definition[placeholder.id]
+    items = [{"binding": _ref(placeholder_binding), "required": True}]
+    for item in spec.items:
+        definition = next(d for d in definitions if d.key == item.metric)
+        items.append({"binding": _ref(by_definition[definition.id]), "required": item.required})
+    rubric: Rubric = _seal(
+        Rubric, {**_doc_base(RubricId.new(), created_at, version=1), "items": items}
+    )
+    snapshot_doc = _doc_base(ConfigSnapshotId.new(), created_at, version=None)
+    snapshot_doc.update(
+        {
+            "evaluator": evaluator.model_dump(mode="json", by_alias=True),
+            "persona": persona.model_dump(mode="json", by_alias=True),
+            "metric_definitions": [d.model_dump(mode="json", by_alias=True) for d in definitions],
+            "metric_bindings": [b.model_dump(mode="json", by_alias=True) for b in bindings],
+            "rubric": rubric.model_dump(mode="json", by_alias=True),
+        }
+    )
+    digest = compute_snapshot_digest(snapshot_doc).model_dump(mode="json", exclude_none=True)
+    return RecordedConfiguration(ConfigSnapshot.model_validate({**snapshot_doc, "content_digest": digest}))
+
+
+def recorded_project(
+    *, name: str, created_at: datetime, provider_configs: Sequence[ProviderConfigRef] = ()
+) -> Project:
+    return Project(
+        id=ProjectId.new(),
+        schema_version=SCHEMA_VERSION,
+        created_at=created_at,
+        name=name,
+        provider_configs=list(provider_configs),
+    )
+
+
+def recorded_agent_target(*, name: str, created_at: datetime) -> AgentTarget:
+    doc = _doc_base(AgentTargetId.new(), created_at, version=1)
+    doc.update(
+        {
+            "name": name,
+            "endpoint": {"transport": "ws", "url": RECORDED_ENDPOINT_URL},
+            "languages": [],
+            "declared_capabilities": [],
+            "declared_stack": [],
+        }
+    )
+    built: AgentTarget = _seal(AgentTarget, doc)
+    return built
+
+
+_ = canonical_decimal_text
diff --git a/packages/evalcore/src/tracer_evalcore/flagsdoc.py b/packages/evalcore/src/tracer_evalcore/flagsdoc.py
new file mode 100644
index 0000000..674ed7f
--- /dev/null
+++ b/packages/evalcore/src/tracer_evalcore/flagsdoc.py
@@ -0,0 +1,254 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The ``tracer.flags/1`` document: built from the pieces of a scoring pass and validated."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Mapping, Sequence
+from decimal import Decimal
+from fractions import Fraction
+from typing import Any
+
+from tracer_evalcore.align import Alignment
+from tracer_evalcore.errors import InputRefusedError
+from tracer_evalcore.flags import FLAGS_FORMAT, SIGNAL_NAME, SpanFlag, format_threshold
+from tracer_evalcore.tokens import TokenSequence
+
+__all__ = ["FLAGS_METADATA_KEY", "FlagsDocumentError", "build_flags_document", "validate_flags_document"]
+
+FLAGS_METADATA_KEY = "tracer.flags"
+_MAX = 9007199254740991
+_NORMALISER = re.compile(r"^[a-z]{2,3}-[A-Z][a-z]{3}/[1-9][0-9]{0,8}$")
+_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,63}$")
+_THRESHOLD = re.compile(r"^(?:0|1|0\.[0-9]{0,17}[1-9])$")
+_CONFIDENCE = re.compile(r"^(?:0|1|0\.[0-9]{0,3}[1-9])$")
+_TOP = {"format", "signal", "normaliser", "stt", "flag_min_confidence", "alignment", "tokens", "spans"}
+_SPAN = {
+    "turn_seq", "start", "end", "export_tokens", "stt_token_start", "stt_token_end",
+    "substitutions", "deletions", "insertions", "edit_distance", "key_length", "confidence",
+    "flagged", "near_chunk_boundary",
+}  # fmt: skip
+
+
+class FlagsDocumentError(InputRefusedError):
+    def __init__(self, code: str) -> None:
+        self.code = code
+        super().__init__(code)
+
+
+def build_flags_document(
+    *,
+    normaliser: str,
+    provider: str,
+    model: str,
+    threshold: Decimal,
+    alignment: Alignment,
+    export: TokenSequence,
+    stt: TokenSequence,
+    flags: Sequence[SpanFlag],
+) -> dict[str, Any]:
+    spans: list[dict[str, Any]] = []
+    for flag in flags:
+        span = flag.span
+        record: dict[str, Any] = {
+            "turn_seq": span.turn_seq,
+            "start": span.start,
+            "end": span.end,
+            "export_tokens": span.export_tokens,
+            "stt_token_start": span.stt_token_start,
+            "stt_token_end": span.stt_token_end,
+            "substitutions": span.substitutions,
+            "deletions": span.deletions,
+            "insertions": span.insertions,
+            "edit_distance": flag.edit_distance,
+            "key_length": flag.key_length,
+            "confidence": flag.confidence,
+            "flagged": flag.flagged,
+            "near_chunk_boundary": flag.near_chunk_boundary,
+        }
+        if span.audio_start_ms is not None and span.audio_end_ms is not None:
+            record["audio_start_ms"] = span.audio_start_ms
+            record["audio_end_ms"] = span.audio_end_ms
+        spans.append(record)
+    return {
+        "format": FLAGS_FORMAT,
+        "signal": SIGNAL_NAME,
+        "normaliser": normaliser,
+        "stt": {"provider": provider, "model": model, "model_source": "requested"},
+        "flag_min_confidence": format_threshold(threshold),
+        "alignment": {
+            "unit": "word",
+            "hits": alignment.hits,
+            "substitutions": alignment.substitutions,
+            "deletions": alignment.deletions,
+            "insertions": alignment.insertions,
+        },
+        "tokens": {
+            "export": len(export.tokens),
+            "stt": len(stt.tokens),
+            "flagged_export": sum(f.span.export_tokens for f in flags if f.flagged),
+        },
+        "spans": spans,
+    }
+
+
+def _int(value: object, low: int = 0) -> bool:
+    return type(value) is int and low <= value <= _MAX
+
+
+def _fail(code: str) -> FlagsDocumentError:
+    return FlagsDocumentError(code)
+
+
+def _structure(doc: Mapping[str, Any]) -> None:
+    if not isinstance(doc, Mapping):
+        raise TypeError("a flags document is a mapping")
+    if set(doc) != _TOP:
+        raise _fail("flags_shape")
+    if doc["format"] != FLAGS_FORMAT or doc["signal"] != SIGNAL_NAME:
+        raise _fail("flags_shape")
+    if not isinstance(doc["normaliser"], str) or _NORMALISER.fullmatch(doc["normaliser"]) is None:
+        raise _fail("flags_shape")
+    stt = doc["stt"]
+    if (
+        not isinstance(stt, Mapping)
+        or set(stt) != {"provider", "model", "model_source"}
+        or stt["model_source"] != "requested"
+        or not all(isinstance(stt[k], str) and _NAME.fullmatch(stt[k]) for k in ("provider", "model"))
+    ):
+        raise _fail("flags_shape")
+    threshold = doc["flag_min_confidence"]
+    if not isinstance(threshold, str) or _THRESHOLD.fullmatch(threshold) is None:
+        raise _fail("flags_shape")
+    alignment = doc["alignment"]
+    keys = {"unit", "hits", "substitutions", "deletions", "insertions"}
+    if (
+        not isinstance(alignment, Mapping)
+        or set(alignment) != keys
+        or alignment["unit"] != "word"
+        or not all(_int(alignment[k]) for k in keys - {"unit"})
+    ):
+        raise _fail("flags_shape")
+    tokens = doc["tokens"]
+    if (
+        not isinstance(tokens, Mapping)
+        or set(tokens) != {"export", "stt", "flagged_export"}
+        or not _int(tokens["export"], 1)
+        or not _int(tokens["stt"], 1)
+        or not _int(tokens["flagged_export"])
+    ):
+        raise _fail("flags_shape")
+    spans = doc["spans"]
+    if not isinstance(spans, list):
+        raise _fail("flags_shape")
+    for span in spans:
+        if not isinstance(span, Mapping):
+            raise _fail("flags_shape")
+        keys = set(span)
+        if not (_SPAN <= keys <= _SPAN | {"audio_start_ms", "audio_end_ms"}):
+            raise _fail("flags_shape")
+        if ("audio_start_ms" in keys) != ("audio_end_ms" in keys):
+            raise _fail("flags_shape")
+        ints = (_SPAN - {"confidence", "flagged", "near_chunk_boundary", "edit_distance", "key_length"}) | (
+            keys & {"audio_start_ms", "audio_end_ms"}
+        )
+        if not all(_int(span[k]) for k in ints):
+            raise _fail("flags_shape")
+        if not _int(span["edit_distance"], 1) or not _int(span["key_length"], 1):
+            raise _fail("flags_shape")
+        if not isinstance(span["confidence"], str) or _CONFIDENCE.fullmatch(span["confidence"]) is None:
+            raise _fail("flags_shape")
+        if type(span["flagged"]) is not bool or type(span["near_chunk_boundary"]) is not bool:
+            raise _fail("flags_shape")
+
+
+def _display(edit_distance: int, key_length: int) -> str:
+    fraction = Fraction(edit_distance, key_length)
+    scaled = fraction * 10000
+    quotient, remainder = divmod(scaled.numerator, scaled.denominator)
+    if remainder * 2 > scaled.denominator or (
+        remainder * 2 == scaled.denominator and quotient % 2 == 1
+    ):
+        quotient += 1
+    text = format(Decimal(quotient).scaleb(-4), "f")
+    if "." in text:
+        text = text.rstrip("0").rstrip(".")
+    return text
+
+
+def validate_flags_document(
+    document: Mapping[str, Any],
+    *,
+    normaliser: str,
+    threshold: Decimal,
+    model: str,
+    export: TokenSequence | None = None,
+) -> None:
+    _structure(document)
+    if document["normaliser"] != normaliser or document["flag_min_confidence"] != format_threshold(
+        threshold
+    ):
+        raise _fail("flags_binding_mismatch")
+    if document["stt"]["model"] != model:
+        raise _fail("flags_binding_mismatch")
+    alignment, tokens, spans = document["alignment"], document["tokens"], document["spans"]
+    hits, subs, dels, ins = (alignment[k] for k in ("hits", "substitutions", "deletions", "insertions"))
+    if hits + subs + dels != tokens["export"] or hits + subs + ins != tokens["stt"]:
+        raise _fail("flags_counts")
+    totals = [0, 0, 0]
+    flagged_tokens = 0
+    previous: tuple[int, int, int, int] | None = None
+    last_end: dict[int, int] = {}
+    stt_cursor = 0
+    for span in spans:
+        s, d, i = span["substitutions"], span["deletions"], span["insertions"]
+        totals[0] += s
+        totals[1] += d
+        totals[2] += i
+        if span["start"] > span["end"] or span["export_tokens"] != s + d:
+            raise _fail("flags_span")
+        if (span["start"] == span["end"]) != (span["export_tokens"] == 0):
+            raise _fail("flags_span")
+        if span["stt_token_end"] - span["stt_token_start"] != s + i:
+            raise _fail("flags_span")
+        if span["edit_distance"] > span["key_length"]:
+            raise _fail("flags_span")
+        if span["confidence"] != _display(span["edit_distance"], span["key_length"]):
+            raise _fail("flags_span")
+        exact = span["edit_distance"] >= threshold * span["key_length"]
+        if span["flagged"] is not exact:
+            raise _fail("flags_span")
+        if "audio_start_ms" in span and span["audio_start_ms"] > span["audio_end_ms"]:
+            raise _fail("flags_span")
+        key = (span["turn_seq"], span["start"], span["end"], span["stt_token_start"])
+        if previous is not None and key < previous:
+            raise _fail("flags_order")
+        previous = key
+        if span["start"] != span["end"]:
+            if span["start"] < last_end.get(span["turn_seq"], 0):
+                raise _fail("flags_order")
+            last_end[span["turn_seq"]] = span["end"]
+        if span["stt_token_start"] < stt_cursor or span["stt_token_end"] > tokens["stt"]:
+            raise _fail("flags_order")
+        stt_cursor = span["stt_token_end"]
+        if span["flagged"]:
+            flagged_tokens += span["export_tokens"]
+    if totals != [subs, dels, ins]:
+        raise _fail("flags_counts")
+    if tokens["flagged_export"] != flagged_tokens:
+        raise _fail("flags_counts")
+    if export is not None:
+        by_seq = {turn.seq: turn for turn in export.turns}
+        for span in spans:
+            turn = by_seq.get(span["turn_seq"])
+            if turn is None or span["end"] > len(turn.text):
+                raise _fail("flags_export_mismatch")
+            edges = {(t.start, t.end) for t in export.tokens if t.turn_seq == span["turn_seq"]}
+            starts = {a for a, _ in edges}
+            ends = {b for _, b in edges}
+            if span["start"] == span["end"]:
+                if span["start"] not in ends | starts:
+                    raise _fail("flags_export_mismatch")
+            elif span["start"] not in starts or span["end"] not in ends:
+                raise _fail("flags_export_mismatch")
