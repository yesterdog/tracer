+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Result mapping: the three MetricResult records of a recorded call (ADR 0023 rules 11 to 15)."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Any
+
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.artifact import Artifact  # noqa: F401
+from tracer_evalschema.base import compute_metadata_flags
+from tracer_evalschema.events import EvidenceRef
+from tracer_evalschema.ids import ArtifactId, MetricResultId
+from tracer_evalschema.language import primary_language
+from tracer_evalschema.metrics import MetricDefinition, MetricDefinitionRef, rule_passes
+from tracer_evalschema.results import MetricResult, ResultError, applicability
+from tracer_evalschema.run import Run
+from tracer_evalschema.transcript import Transcript, Turn
+
+from tracer_evalcore.align import AlignmentTooLargeError, align
+from tracer_evalcore.definitions import (
+    RecordedConfiguration,
+    ScoringParameters,
+    parameters_of,
+)
+from tracer_evalcore.flags import (
+    STT_DISAGREEMENT,
+    LevenshteinTooLargeError,
+    SpanFlag,
+    flag_spans,
+)
+from tracer_evalcore.flagsdoc import (
+    FLAGS_METADATA_KEY,
+    FlagsDocumentError,
+    build_flags_document,
+    validate_flags_document,
+)
+from tracer_evalcore.registry import (
+    COUNT_KEY,
+    DEFAULT_REGISTRY,
+    MER_KEY,
+    SHARE_KEY,
+    SHIPPED_KEYS,
+    ScorerRegistry,
+    scorer_info,
+)
+from tracer_evalcore.spans import extract_spans
+from tracer_evalcore.tokens import TextTurn, TimedSegment, TokenSequence, tokenise_turns
+
+__all__ = ["score_results"]
+
+
+@dataclass(frozen=True)
+class _Computed:
+    values: dict[str, Any]
+    evidence: list[EvidenceRef]
+    document: dict[str, Any]
+
+
+@dataclass(frozen=True)
+class _Failed:
+    code: str
+    message: str
+
+
+def _text_turns(turns: Sequence[Turn], *, segments: bool) -> list[TextTurn]:
+    ordered = sorted(turns, key=lambda t: t.seq)
+    result = []
+    for turn in ordered:
+        parts = ()
+        if segments and turn.segments:
+            parts = tuple(TimedSegment(s.text, s.start_ms, s.end_ms) for s in turn.segments)
+        result.append(TextTurn(turn.seq, turn.text, parts))
+    return result
+
+
+def _language_gate(
+    stt_turns: Sequence[Turn], definition: MetricDefinition
+) -> _Failed | None:
+    if not stt_turns:
+        return None
+    covered = {primary_language(tag) for tag in definition.languages}
+    untagged = sum(1 for t in stt_turns if t.language is None or t.language.lower() == "und")
+    if untagged:
+        return _Failed(
+            "stt_language_not_observed",
+            f"{untagged} of {len(stt_turns)} stt turns carry no observed language",
+        )
+    other = sum(1 for t in stt_turns if primary_language(t.language or "") not in covered)
+    if other:
+        return _Failed(
+            "stt_unsupported_language",
+            f"{other} of {len(stt_turns)} stt turns carry a language other than the covered one",
+        )
+    return None
+
+
+def _compute(
+    *,
+    parameters: ScoringParameters,
+    export: Transcript,
+    export_turns: Sequence[Turn],
+    stt: Transcript,
+    stt_turns: Sequence[Turn],
+    audio_artifact_id: ArtifactId | None,
+    definition: MetricDefinition,
+    share_definition: MetricDefinition,
+) -> _Computed | _Failed:
+    gate = _language_gate(stt_turns, definition)
+    if gate is not None:
+        return gate
+    export_seq = tokenise_turns(_text_turns(export_turns, segments=False), parameters.normaliser)
+    if not export_seq.tokens:
+        return _Failed("no_tokens", "the export has no token")
+    stt_seq = tokenise_turns(_text_turns(stt_turns, segments=True), parameters.normaliser)
+    if not stt_seq.tokens:
+        return _Failed("no_tokens", "the stt transcript has no token")
+    try:
+        alignment = align(export_seq, stt_seq)
+        spans = extract_spans(alignment, export_seq, stt_seq)
+        flags = flag_spans(
+            spans,
+            export_seq,
+            stt_seq,
+            signal=STT_DISAGREEMENT,
+            flag_min_confidence=parameters.flag_min_confidence,
+        )
+    except AlignmentTooLargeError as exc:
+        return _Failed("alignment_too_large", str(exc))
+    except LevenshteinTooLargeError as exc:
+        return _Failed("levenshtein_too_large", str(exc))
+    if stt.provider is None or stt.model is None:
+        return _Failed("stt_provenance_missing", "the stt transcript names no provider or model")
+    document = build_flags_document(
+        normaliser=parameters.normaliser,
+        provider=stt.provider,
+        model=stt.model,
+        threshold=parameters.flag_min_confidence,
+        alignment=alignment,
+        export=export_seq,
+        stt=stt_seq,
+        flags=flags,
+    )
+    try:
+        validate_flags_document(
+            document,
+            normaliser=parameters.normaliser,
+            threshold=parameters.flag_min_confidence,
+            model=stt.model,
+            export=export_seq,
+        )
+    except FlagsDocumentError as exc:
+        return _Failed("flags_document_refused", f"the flags document was refused: {exc.code}")
+    if compute_metadata_flags({FLAGS_METADATA_KEY: document}):
+        return _Failed(
+            "flags_document_refused", "the flags document was refused: flags_metadata_flagged"
+        )
+    flagged = [f for f in flags if f.flagged]
+    values = {
+        MER_KEY: alignment.mer,
+        COUNT_KEY: len(flagged),
+        SHARE_KEY: sum(f.span.export_tokens for f in flagged) / len(export_seq.tokens),
+    }
+    return _Computed(values, _evidence(flagged, export_turns, audio_artifact_id), document)
+
+
+def _evidence(
+    flagged: Sequence[SpanFlag], export_turns: Sequence[Turn], audio_artifact_id: ArtifactId | None
+) -> list[EvidenceRef]:
+    by_seq = {t.seq: t for t in export_turns}
+    refs: list[EvidenceRef] = []
+    for seq in sorted({f.span.turn_seq for f in flagged}):
+        refs.append(EvidenceRef(kind="turn", ref_id=by_seq[seq].id))
+    seen: set[tuple[int, int]] = set()
+    if audio_artifact_id is not None:
+        for flag in flagged:
+            start, end = flag.span.audio_start_ms, flag.span.audio_end_ms
+            if start is None or end is None or (start, end) in seen:
+                continue
+            seen.add((start, end))
+            refs.append(
+                EvidenceRef(kind="artifact_range", ref_id=audio_artifact_id, start_ms=start, end_ms=end)
+            )
+    return refs
+
+
+def score_results(
+    *,
+    configuration: RecordedConfiguration,
+    run: Run,
+    export: Transcript | None,
+    export_turns: Sequence[Turn],
+    stt: Transcript | None,
+    stt_turns: Sequence[Turn],
+    audio_artifact_id: ArtifactId | None,
+    created_at: datetime,
+    registry: ScorerRegistry = DEFAULT_REGISTRY,
+) -> tuple[MetricResult, ...]:
+    parameters = parameters_of(configuration.snapshot)
+    held = [t for t in (export, stt) if t is not None]
+    transcript_ids = [t.id for t in held] or None
+    agent_turns = [t for t in export_turns if t.role == "agent"] if export is not None else []
+    agent_turns += [t for t in stt_turns if t.role == "agent"] if stt is not None else []
+    definitions = {key: configuration.definition(key) for key in SHIPPED_KEYS}
+    answer = applicability(definitions[MER_KEY], run, turns=agent_turns, transcripts=held)
+    computed: _Computed | _Failed | None = None
+    if answer.na_reason is None:
+        assert export is not None and stt is not None  # noqa: S101
+        computed = _compute(
+            parameters=parameters,
+            export=export,
+            export_turns=export_turns,
+            stt=stt,
+            stt_turns=stt_turns,
+            audio_artifact_id=audio_artifact_id,
+            definition=definitions[MER_KEY],
+            share_definition=definitions[SHARE_KEY],
+        )
+    results: list[MetricResult] = []
+    for key in SHIPPED_KEYS:
+        definition = definitions[key]
+        fields: dict[str, Any] = {
+            "id": MetricResultId.new(),
+            "schema_version": SCHEMA_VERSION,
+            "created_at": created_at,
+            "metric": MetricDefinitionRef(
+                id=definition.id, version=definition.version, content_digest=definition.content_digest
+            ),
+            "transcript_ids": transcript_ids,
+            "value": None,
+        }
+        if answer.na_reason is not None:
+            results.append(
+                MetricResult(
+                    **fields,
+                    status="not_applicable",
+                    na_reason=answer.na_reason,
+                    missing_kinds=list(answer.missing_kinds),
+                    language_source=answer.language_source,
+                    declared_language_transcript_ids=list(answer.declared_language_transcript_ids),
+                )
+            )
+            continue
+        info = scorer_info(registry.get(definition.implementation_ref or ""))
+        provenance = {
+            "language_source": answer.language_source,
+            "declared_language_transcript_ids": list(answer.declared_language_transcript_ids),
+            "scorer": info,
+        }
+        if isinstance(computed, _Failed):
+            results.append(
+                MetricResult(
+                    **fields,
+                    status="error",
+                    error=ResultError(code=computed.code, message=computed.message),
+                    **provenance,
+                )
+            )
+            continue
+        assert computed is not None  # noqa: S101
+        value = computed.values[key]
+        passed = None if definition.pass_rule is None else rule_passes(definition.pass_rule, value)
+        fields["value"] = value
+        results.append(
+            MetricResult(
+                **fields,
+                status="scored",
+                passed=passed,
+                evidence_refs=list(computed.evidence),
+                metadata={FLAGS_METADATA_KEY: computed.document},
+                **provenance,
+            )
+        )
+    return tuple(results)
+
+
+_ = TokenSequence
