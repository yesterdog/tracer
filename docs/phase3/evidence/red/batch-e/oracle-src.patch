+    "    var node = event.target;\n"
+    "    while (node && node.nodeType === 1) {\n"
+    '      if (node.hasAttribute("data-seek-start-ms")) {\n'
+    '        var start = Number(node.getAttribute("data-seek-start-ms"));\n'
+    "        if (isFinite(start)) { player.currentTime = start / 1000; player.play(); }\n"
+    "        return;\n"
+    "      }\n"
+    "      node = node.parentNode;\n"
+    "    }\n"
+    "  });\n"
+    "})();\n"
+)
+
+STYLE = (
+    "body { font-family: sans-serif; margin: 1.5rem; max-width: 60rem; }\n"
+    "table { border-collapse: collapse; }\n"
+    "td, th { border: 1px solid #888; padding: 0.2rem 0.5rem; text-align: left; }\n"
+    "mark.flag { background: #ffe066; }\n"
+    "mark.gap { background: #ffb3b3; }\n"
+    ".role { font-weight: bold; margin-right: 0.5rem; }\n"
+    ".warning { border: 2px solid #b00; padding: 0.5rem; }\n"
+    "svg rect { fill: #446; }\n"
+)
+
+_URL_CHARS = re.compile(r"[A-Za-z0-9._~%/-]+")
+
+
+def _is_mapping_free(value: object) -> bool:
+    return isinstance(value, str)
+
+
+@dataclass(frozen=True)
+class RelativeAudio:
+    """A relative, URL-encoded reference to the audio file."""
+
+    src: str
+
+    def __post_init__(self) -> None:
+        value = self.src
+        if (
+            not isinstance(value, str)
+            or _URL_CHARS.fullmatch(value) is None
+            or value.startswith("/")
+            or "//" in value
+        ):
+            raise ValueError("the audio reference must be a relative, URL-encoded path")
+
+
+@dataclass(frozen=True)
+class EmbeddedAudio:
+    """The bytes of the WAV file, to be embedded as a data URI (opt-in)."""
+
+    data: bytes
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.data, bytes):
+            raise TypeError("the audio data must be bytes")
+        if not self.data:
+            raise ValueError("the audio data is empty")
+
+
+def relative_audio_src(audio_path: Any, report_dir: Any) -> str:
+    relative = os.path.relpath(os.fspath(audio_path), os.fspath(report_dir))
+    return urllib.parse.quote(relative.replace(os.sep, "/"), safe="/")
+
+
+def csp_hash_source(text: str) -> str:
+    digest = hashlib.sha256(text.encode("utf-8")).digest()
+    return "'sha256-" + base64.b64encode(digest).decode("ascii") + "'"
+
+
+def content_security_policy(style_text: str, script_text: str, *, embedded: bool) -> str:
+    media = "data:" if embedded else "'self'"
+    return (
+        f"default-src 'none'; style-src {csp_hash_source(style_text)}; "
+        f"script-src {csp_hash_source(script_text)}; media-src {media}; "
+        "base-uri 'none'; form-action 'none'"
+    )
+
+
+def safe_html(text: str) -> str:
+    """display_safe, then a visible marker for every other control character, then escaping."""
+    if not isinstance(text, str):
+        raise TypeError("safe_html takes text")
+    shown = display_safe(text)
+    marked = "".join(
+        f"[U+{ord(c):04X}]" if unicodedata.category(c) == "Cc" or c in "\u2028\u2029" else c
+        for c in shown
+    )
+    return html.escape(marked, quote=True)
+
+
+def outcome_of(bundle: RunBundle) -> str:
+    if stt_failure_detail(bundle) is not None:
+        return "stt_failed"
+    if bundle.results and all(r.status == "scored" for r in bundle.results):
+        return "scored"
+    return "not_scored"
+
+
+def _e(text: str) -> str:
+    return html.escape(text, quote=True)
+
+
+def _ut(tag: str, classes: str, text: str, attrs: str = "") -> str:
+    return f'<{tag} class="{classes} ut"{attrs}>{safe_html(text)}</{tag}>'
+
+
+def _segments(turn: Any, spans: list[tuple[int, dict[str, Any]]]) -> str:
+    text = turn.text
+    parts: list[str] = []
+    position = 0
+    for index, span in spans:
+        start, end = span["start"], span["end"]
+        if start > position:
+            parts.append(_ut("span", "seg", text[position:start]))
+        data = (
+            f' data-span="{index}" data-turn="{turn.seq}" data-start="{start}" data-end="{end}"'
+            f' data-confidence="{_e(span["confidence"])}"'
+        )
+        if start == end:
+            parts.append(f'<mark class="flag gap"{data}>[+]</mark>')
+        else:
+            parts.append(_ut("mark", "flag", text[start:end], data))
+        position = end
+    if position < len(text):
+        parts.append(_ut("span", "seg", text[position:]))
+    return "".join(parts)
+
+
+def _stt_pieces(bundle: Any, document: dict[str, Any]) -> tuple[Any, Any]:
+    stt = next((t for t in bundle.transcripts if t.source == "our_stt"), None)
+    if stt is None:
+        return [], ()
+    turns = sorted((t for t in bundle.turns if t.transcript_id == stt.id), key=lambda t: t.seq)
+    sequence = tokenise_turns([TextTurn(t.seq, t.text) for t in turns], document["normaliser"])
+    return turns, sequence.tokens
+
+
+def _heard(span: dict[str, Any], turns: Any, tokens: Any) -> str:
+    first, last = span["stt_token_start"], span["stt_token_end"]
+    if first == last:
+        return '<span class="none">nothing heard</span>'
+    pieces: dict[int, list[int]] = {}
+    for token in tokens[first:last]:
+        box = pieces.setdefault(token.turn_index, [token.start, token.end])
+        box[0], box[1] = min(box[0], token.start), max(box[1], token.end)
+    parts = []
+    for turn_index, (start, end) in pieces.items():
+        turn = turns[turn_index]
+        attrs = f' data-stt-turn="{turn.seq}" data-stt-start="{start}" data-stt-end="{end}"'
+        parts.append(_ut("span", "heard-piece", turn.text[start:end], attrs))
+    return "".join(parts)
+
+
+def _exported(span: dict[str, Any], export_texts: dict[int, str]) -> str:
+    if span["start"] == span["end"]:
+        return '<span class="none">not in export</span>'
+    text = export_texts[span["turn_seq"]][span["start"] : span["end"]]
+    return _ut("span", "export-piece", text)
+
+
+def _span_rows(
+    document: dict[str, Any], roles: dict[int, str], export_texts: dict[int, str], stt: Any
+) -> str:
+    rows = []
+    for index, span in enumerate(document["spans"]):
+        if not span["flagged"]:
+            continue
+        if "audio_start_ms" in span:
+            audio = (
+                f'<button type="button" class="seek" data-seek-start-ms="{span["audio_start_ms"]}"'
+                f' data-seek-end-ms="{span["audio_end_ms"]}">play {span["audio_start_ms"]} to '
+                f'{span["audio_end_ms"]} ms</button>'
+            )
+        else:
+            audio = "no audio range"
+        rows.append(
+            f'<tr class="flag-row" data-span="{index}" data-turn-seq="{span["turn_seq"]}" '
+            f'data-stt-token-start="{span["stt_token_start"]}" data-stt-token-end="{span["stt_token_end"]}">'
+            f'<td class="turn">turn {span["turn_seq"]}</td>'
+            f'<td class="role">{_e(roles.get(span["turn_seq"], "unknown"))}</td>'
+            f'<td class="offsets">{span["start"]}-{span["end"]}</td>'
+            f'<td class="confidence">{_e(span["confidence"])}</td>'
+            f'<td class="edit">edit distance {span["edit_distance"]} of {span["key_length"]}</td>'
+            f'<td class="boundary">{"yes" if span["near_chunk_boundary"] else "no"}</td>'
+            f'<td class="exportside">{_exported(span, export_texts)}</td>'
+            f'<td class="heard">{_heard(span, *stt)}</td>'
+            f'<td class="audio">{audio}</td></tr>'
+        )
+    return "".join(rows)
+
+
+def _histogram(document: dict[str, Any]) -> str:
+    spans_in = [0] * 10
+    flagged_in = [0] * 10
+    for span in document["spans"]:
+        index = min(9, span["edit_distance"] * 10 // span["key_length"])
+        spans_in[index] += 1
+        flagged_in[index] += 1 if span["flagged"] else 0
+    biggest = max(spans_in) or 1
+    rows = []
+    for index in range(10):
+        high = f"0.{index + 1}" if index < 9 else "1.0"
+        width = max(1, spans_in[index] * 100 // biggest)
+        bar = (
+            f'<svg width="{width}" height="10" role="img" aria-label="{spans_in[index]} spans">'
+            f'<rect x="0" y="0" width="{width}" height="10"></rect></svg>'
+            if spans_in[index]
+            else ""
+        )
+        rows.append(
+            f'<tr class="bin" data-bin="{index}" data-low="0.{index}" data-high="{high}" '
+            f'data-spans="{spans_in[index]}" data-flagged="{flagged_in[index]}">'
+            f"<td>0.{index} to {high}</td><td>{spans_in[index]} spans</td>"
+            f"<td>{flagged_in[index]} flagged</td><td>{bar}</td></tr>"
+        )
+    return (
+        '<table id="histogram"><thead><tr><th>confidence</th><th>spans</th><th>flagged</th>'
+        "<th></th></tr></thead><tbody>" + "".join(rows) + "</tbody></table>"
+        f'<p id="histogram-total">spans: {len(document["spans"])}</p>'
+    )
+
+
+def _instant(value: Any) -> str:
+    from datetime import UTC
+
+    return value.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def render_report(bundle: RunBundle, *, audio: RelativeAudio | EmbeddedAudio) -> str:
+    if not isinstance(bundle, RunBundle):
+        raise TypeError("render_report takes a RunBundle")
+    if not isinstance(audio, RelativeAudio | EmbeddedAudio):
+        raise TypeError("audio must be a RelativeAudio or an EmbeddedAudio")
+    embedded = isinstance(audio, EmbeddedAudio)
+    outcome = outcome_of(bundle)
+    facts = facts_of(bundle)
+    document = facts.document if outcome == "scored" else None
+    export = next(t for t in bundle.transcripts if t.source == "agent_export")
+    export_turns = sorted(
+        (t for t in bundle.turns if t.transcript_id == export.id), key=lambda t: t.seq
+    )
+    roles = {t.seq: t.role for t in export_turns}
+    lines = dict(summary_lines(bundle, outcome))
+    scorer = facts.results[MER_KEY].scorer.version if MER_KEY in facts.results and facts.results[
+        MER_KEY
+    ].scorer else tracer_evalcore.__version__
+    body: list[str] = []
+    body.append(
+        '<main id="report"><header><h1>Tracer: agreement between two transcripts of one '
+        "recorded call</h1>"
+        f'<p id="status" data-outcome="{outcome}">result: '
+        f'{"scored" if outcome == "scored" else "not scored"}</p></header>'
+    )
+    body.append(
+        '<section id="what-this-is"><p>This page compares the transcript export of an agent for '
+        "one recorded call with a speech-to-text transcript of the same audio. Neither text is "
+        "treated as the reference, and nothing here says which one is right. No call was "
+        "simulated: this is a recorded call. The page points at the spans of the export where "
+        "the two disagree, so that a person reads less.</p></section>"
+    )
+    declared = export.declared_language.language if export.declared_language else None
+    if declared is not None:
+        body.append(
+            f'<p id="declared-language" data-language="{_e(declared)}">'
+            f"language declared by user: {_e(declared)}</p>"
+        )
+    artifact = bundle.artifacts[0] if bundle.artifacts else None
+    body.append('<section id="audio">')
+    if artifact is not None:
+        fmt = artifact.audio_format
+        body.append(
+            f'<p id="audio-facts" data-sha256="{artifact.sha256}" data-bytes="{artifact.size}">'
+            f"audio: {fmt.container if fmt else 'unknown'}, "
+            f'{fmt.sample_rate_hz if fmt else 0} Hz, {fmt.channels if fmt else 0} channel(s), '
+            f"{artifact.size} bytes, sha256 {artifact.sha256}</p>"
+        )
+        if embedded:
+            body.append(
+                '<p id="embed-warning" class="warning">This file contains the call audio and '
+                "personal data. Treat it like the recording: do not share it.</p>"
+            )
+            source = "data:audio/wav;base64," + base64.b64encode(audio.data).decode("ascii")
+        else:
+            source = audio.src
+        body.append(f'<audio id="player" controls preload="none" src="{_e(source)}"></audio>')
+    body.append("</section>")
+    privacy = export.privacy
+    if privacy is not None and privacy.human_subject:
+        retention = privacy.retention
+        until = _instant(retention.retain_until) if retention.retain_until else "not set"
+        body.append(
+            f'<p id="privacy">personal data: yes. consent: {_e(privacy.consent.status)}. '
+            f'delete on expiry: {"yes" if retention.delete_on_expiry else "no"}. '
+            f"retain until: {until}.</p>"
+        )
+    # provenance
+    prov: list[str] = [f'<dt>scorer version</dt><dd id="scorer-version">{_e(scorer)}</dd>']
+    if document is not None:
+        stt = document["stt"]
+        prov += [
+            f'<dt>signal</dt><dd id="signal">{_e(document["signal"])}</dd>',
+            f'<dt>stt provider</dt>{_ut("dd", "", stt["provider"], " id=" + chr(34) + "stt-provider" + chr(34))}',
+            f'<dt>stt model</dt>{_ut("dd", "", stt["model"], " id=" + chr(34) + "stt-model" + chr(34))}',
+            f'<dt>model source</dt><dd id="stt-model-source">{_e(stt["model_source"])}</dd>',
+            f'<dt>normaliser</dt><dd id="normaliser">{_e(document["normaliser"])}</dd>',
+            f'<dt>threshold</dt><dd id="threshold">{_e(document["flag_min_confidence"])}</dd>',
+        ]
+    body.append('<section><h2>How this was computed</h2><dl id="provenance">' + "".join(prov) + "</dl></section>")
+    if document is not None:
+        alignment = document["alignment"]
+        mer = facts.results[MER_KEY].value
+        share = facts.results[SHARE_KEY]
+        tokens = document["tokens"]
+        body.append('<section id="summary"><h2>Numbers</h2>')
+        body.append(
+            f'<p id="agreement" data-value="{mer!r}" data-hits="{alignment["hits"]}" '
+            f'data-substitutions="{alignment["substitutions"]}" data-deletions="{alignment["deletions"]}" '
+            f'data-insertions="{alignment["insertions"]}">'
+            f'agreement distance (MER): {_e(lines["agreement distance (MER)"])}</p>'
+        )
+        body.append(f'<p id="tokens">tokens: {_e(lines["tokens"])}</p>')
+        body.append(
+            f'<p id="flag-count" data-value="{facts.results[COUNT_KEY].value}">'
+            f'flags: {_e(lines["flags"])}</p>'
+        )
+        body.append(
+            f'<p id="flagged-share" data-numerator="{tokens["flagged_export"]}" '
+            f'data-denominator="{tokens["export"]}">flagged share of export tokens: '
+            f'{_e(lines["flagged share of export tokens"])}</p>'
+        )
+        body.append(f'<p id="flag-turns">export turns with a flag: {_e(lines["export turns with a flag"])}</p>')
+        budget = budget_facts(bundle, facts)
+        if budget is not None:
+            text, no_limit, met = budget
+            met_attr = "" if met is None else f' data-met="{"true" if met else "false"}"'
+            body.append(
+                f'<p id="review-budget" data-max="{_e(text)}" data-no-limit="'
+                f'{"true" if no_limit else "false"}"{met_attr}>review budget: '
+                f'{_e(lines["review budget"])}</p>'
+            )
+        del share
+        body.append("</section>")
+    else:
+        items = [f"<li>not scored: {_e(r)}</li>" for r in not_scored_reasons(bundle)]
+        detail = stt_failure_detail(bundle)
+        if detail is not None:
+            items.append(f'<li>detail: {_ut("span", "", detail)}</li>')
+        body.append('<section id="not-scored"><ul>' + "".join(items) + "</ul></section>")
+    # histogram and flags
+    if document is not None:
+        body.append(
+            '<section><h2>Confidence of the spans</h2><p>Histogram of the confidence of every '
+            "span found, flagged or not. The confidence is an uncalibrated disagreement strength "
+            "and not a probability.</p>" + _histogram(document) + "</section>"
+        )
+        rows = _span_rows(
+            document, roles, {t.seq: t.text for t in export_turns}, _stt_pieces(bundle, document)
+        )
+        if rows:
+            flags = (
+                '<table id="flags-table"><thead><tr><th>turn</th><th>role</th><th>offsets</th>'
+                "<th>confidence</th><th>edit</th><th>chunk edge</th><th>agent export</th><th>STT heard</th><th>audio</th></tr></thead>"
+                f"<tbody>{rows}</tbody></table>"
+            )
+        else:
+            flags = "<p>no span reached the threshold</p>"
+        body.append(f'<section id="flags"><h2>Flagged spans</h2>{flags}</section>')
+    # transcript
+    spans_by_turn: dict[int, list[tuple[int, dict[str, Any]]]] = {}
+    if document is not None:
+        for index, span in enumerate(document["spans"]):
+            if span["flagged"]:
+                spans_by_turn.setdefault(span["turn_seq"], []).append((index, span))
+    items = []
+    for turn in export_turns:
+        spans = sorted(spans_by_turn.get(turn.seq, []), key=lambda p: (p[1]["start"], p[1]["end"]))
+        items.append(
+            f'<li class="turn" id="turn-{turn.seq}" data-seq="{turn.seq}" data-role="{_e(turn.role)}" '
+            f'data-flags="{len(spans)}"><span class="role">{_e(turn.role)}</span>'
+            f'<div class="text">{_segments(turn, spans)}</div></li>'
+        )
+    body.append(f'<section><h2>Export</h2><ol id="transcript">{"".join(items)}</ol></section>')
+    # usage
+    note = ""
+    cost = cost_text(bundle)
+    if cost.startswith("not available"):
+        note = (
+            '<p id="usage-note">A user price file must also price requests as well as '
+            "audio_input_seconds, or no cost can be computed.</p>"
+        )
+    usage = usage_text(bundle)
+    requests = usage.split(" requests")[0] if usage != "none" else "none"
+    seconds = usage.split(", ")[1].split(" audio")[0] if usage != "none" else "none"
+    body.append(
+        '<section id="usage"><h2>Usage and cost</h2><table><tbody>'
+        f'<tr id="usage-row-requests"><th>requests</th><td id="usage-requests">{requests}</td></tr>'
+        f'<tr><th>audio seconds</th><td id="usage-audio-seconds">{seconds}</td></tr>'
+        f'<tr><th>cost</th><td id="usage-cost">{_e(cost)}</td></tr></tbody></table>{note}</section>'
+    )
+    # warnings
+    warnings = bundle.run.ingest_warnings
+    witems = "".join(
+        f'<li><code>{_e(w.code)}</code> {_ut("span", "", str(w.path or "") + " " + str(w.message or ""))}</li>'
+        for w in warnings
+    )
+    body.append(
+        f'<section id="warnings" data-count="{len(warnings)}"><p id="warning-count">ingest warnings: '
+        f"{len(warnings)}</p><ul>{witems}</ul></section>"
+    )
+    body.append(
+        '<section id="snapshot-note"><p>The stored configuration of this run holds a check named '
+        "recorded_call_no_outcome_check. It is never run and produces no result. It exists only "
+        "because schema 0.0.1 requires such a check, and it is not a judgement of the agent.</p>"
+        "</section>"
+    )
+    body.append(
+        f'<footer><p>run created {_instant(bundle.run.created_at)}</p></footer></main>'
+    )
+    csp = content_security_policy(STYLE, SEEK_SCRIPT, embedded=embedded)
+    head = (
+        '<meta charset="utf-8">'
+        f'<meta http-equiv="Content-Security-Policy" content="{_e(csp)}">'
+        '<meta name="tracer-report" content="1">'
+        "<title>Tracer report</title>"
+        f"<style>{STYLE}</style>"
+    )
+    return (
+        '<!DOCTYPE html>\n<html lang="en"><head>' + head + "</head><body>"
+        + "".join(body)
+        + f"<script>{SEEK_SCRIPT}</script></body></html>\n"
+    )
