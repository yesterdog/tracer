+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The facts of a run that the command prints and the report shows, from the bundle alone."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+from typing import Any
+
+from tracer_evalcore.registry import COUNT_KEY, MER_KEY, SHARE_KEY
+from tracer_evalschema.primitives import canonical_decimal_text
+
+__all__ = [
+    "Facts",
+    "budget_facts",
+    "cost_text",
+    "facts_of",
+    "not_scored_reasons",
+    "render_summary",
+    "stt_failure_detail",
+    "usage_text",
+]
+
+_ERROR_REASONS = {
+    "stt_unsupported_language": "unsupported language detected",
+    "stt_language_not_observed": "language not observed in the stt transcript",
+    "alignment_too_large": "input too large to compare",
+    "levenshtein_too_large": "input too large to compare",
+    "stt_provenance_missing": "speech-to-text provenance missing",
+    "flags_document_refused": "flags document refused",
+}
+_NA_REASONS = {
+    "unsupported_language": "unsupported language detected",
+    "language_not_observed": "language not observed",
+}
+
+
+@dataclass(frozen=True)
+class Facts:
+    keys: dict[str, Any]
+    results: dict[str, Any]
+    document: dict[str, Any] | None
+
+
+def facts_of(bundle: Any) -> Facts:
+    keys = {d.id: d.key for d in bundle.snapshot.metric_definitions}
+    results = {keys[r.metric.id]: r for r in bundle.results if r.metric.id in keys}
+    document = None
+    for result in bundle.results:
+        if result.status == "scored":
+            document = result.metadata["tracer.flags"]
+            break
+    return Facts(keys, results, document)
+
+
+def stt_failure_detail(bundle: Any) -> str | None:
+    for warning in bundle.run.ingest_warnings:
+        if warning.code == "stt_failed":
+            return str(warning.message)
+    return None
+
+
+def not_scored_reasons(bundle: Any) -> tuple[str, ...]:
+    if stt_failure_detail(bundle) is not None:
+        return ("speech-to-text failed",)
+    reasons: list[str] = []
+    for result in bundle.results:
+        if result.status == "scored":
+            continue
+        if result.status == "not_applicable":
+            if result.na_reason == "missing_input":
+                reason = "missing input " + ", ".join(result.missing_kinds or [])
+            else:
+                reason = _NA_REASONS.get(result.na_reason, str(result.na_reason).replace("_", " "))
+        else:
+            code = result.error.code
+            if code == "no_tokens":
+                side = "export" if result.error.message.startswith("the export") else (
+                    "stt transcript"
+                )
+                reason = f"no tokens in the {side}"
+            else:
+                reason = _ERROR_REASONS.get(code, code)
+        if reason not in reasons:
+            reasons.append(reason)
+    return tuple(reasons)
+
+
+def usage_text(bundle: Any) -> str:
+    if not bundle.usage_records:
+        return "none"
+    requests = 0
+    seconds = Decimal(0)
+    for record in bundle.usage_records:
+        for quantity in record.quantities:
+            if quantity.unit == "requests":
+                requests += int(quantity.count)
+            elif quantity.unit == "audio_input_seconds":
+                seconds += Decimal(str(quantity.count))
+    return f"{requests} requests, {canonical_decimal_text(seconds)} audio seconds"
+
+
+def cost_text(bundle: Any) -> str:
+    summaries = [s for s in bundle.cost_summaries if s.domain == "evaluation"]
+    if not summaries:
+        return "not available (no cost record)"
+    summary = summaries[0]
+    records = [r for r in bundle.cost_records if r.domain == "evaluation"]
+    if summary.completeness == "complete" and summary.total is not None:
+        return f"{summary.total.amount} {summary.total.currency} (computed from the supplied USD price)"
+    if summary.completeness == "partial" and summary.total is not None:
+        return (
+            f"partial: {summary.total.amount} {summary.total.currency} "
+            f"({len(summary.included)} of {len(records)} usage records priced)"
+        )
+    reasons = sorted({r.na_reason for r in records if r.na_reason})
+    return f"not available ({', '.join(reasons) if reasons else 'no cost record'})"
+
+
+def _number(value: Any) -> str:
+    return repr(value) if isinstance(value, float) else str(value)
+
+
+def budget_facts(bundle: Any, facts: Facts) -> tuple[str, bool, bool | None] | None:
+    """``(max text, no limit, met)`` of the review budget rule, or None when there is none."""
+    for definition in bundle.snapshot.metric_definitions:
+        if definition.key == SHARE_KEY and definition.pass_rule is not None:
+            rule = definition.pass_rule
+            no_limit = Decimal(str(rule.max)) == 1 and rule.inclusive is True
+            result = facts.results.get(SHARE_KEY)
+            met = None if no_limit or result is None else result.passed
+            return _number(rule.max), no_limit, met
+    return None
+
+
+def _flag_lines(bundle: Any, facts: Facts) -> list[tuple[str, str]]:
+    assert facts.document is not None
+    document = facts.document
+    alignment = document["alignment"]
+    hits, subs = alignment["hits"], alignment["substitutions"]
+    dels, ins = alignment["deletions"], alignment["insertions"]
+    edits = subs + dels + ins
+    mer = facts.results[MER_KEY].value
+    flags = facts.results[COUNT_KEY].value
+    share = facts.results[SHARE_KEY].value
+    tokens = document["tokens"]
+    export = next(t for t in bundle.transcripts if t.source == "agent_export")
+    turns = [t for t in bundle.turns if t.transcript_id == export.id]
+    flagged_turns = len({s["turn_seq"] for s in document["spans"] if s["flagged"]})
+    lines = [
+        (
+            "agreement distance (MER)",
+            f"{_number(mer)} ({edits} of {hits + edits}; H {hits}, S {subs}, D {dels}, I {ins})",
+        ),
+        ("tokens", f"{tokens['export']} in the export, {tokens['stt']} in the stt transcript"),
+        ("flags", f"{flags} (confidence at or above {document['flag_min_confidence']})"),
+        (
+            "flagged share of export tokens",
+            f"{tokens['flagged_export']} of {tokens['export']} ({_number(share)})",
+        ),
+        ("export turns with a flag", f"{flagged_turns} of {len(turns)}"),
+    ]
+    budget = budget_facts(bundle, facts)
+    if budget is not None:
+        text, no_limit, met = budget
+        if no_limit:
+            lines.append(("review budget", f"{text} (no limit)"))
+        else:
+            lines.append(
+                ("review budget", f"{text} (flagged share is {'within' if met else 'over'} it)")
+            )
+    return lines
+
+
+def summary_lines(bundle: Any, outcome: str) -> list[tuple[str, str]]:
+    facts = facts_of(bundle)
+    export = next(t for t in bundle.transcripts if t.source == "agent_export")
+    lines: list[tuple[str, str]] = []
+    scored = outcome == "scored" and facts.document is not None
+    lines.append(("result", "scored" if scored else "not scored"))
+    lines.append(("language declared by user", export.declared_language.language))
+    if scored:
+        assert facts.document is not None
+        stt = facts.document["stt"]
+        lines.append(("stt provider", stt["provider"]))
+        lines.append(("stt model", f"{stt['model']} (as requested)"))
+        lines.append(("normaliser", facts.document["normaliser"]))
+        lines.extend(_flag_lines(bundle, facts))
+    else:
+        for reason in not_scored_reasons(bundle):
+            lines.append(("not scored", reason))
+        detail = stt_failure_detail(bundle)
+        if detail is not None:
+            lines.append(("detail", "".join(c if 32 <= ord(c) < 127 else "?" for c in detail)))
+    lines.append(("stt usage", usage_text(bundle)))
+    lines.append(("cost", cost_text(bundle)))
+    lines.append(("ingest warnings", str(len(bundle.run.ingest_warnings))))
+    return lines
+
+
+def render_summary(bundle: Any, *, outcome: str, stt_failure: Any = None) -> str:
+    """The lines the command prints for a run, before its bundle, store and report lines."""
+    return "".join(f"{label}: {value}\n" for label, value in summary_lines(bundle, outcome))
