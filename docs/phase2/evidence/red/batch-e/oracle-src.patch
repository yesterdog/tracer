+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""``verify_database``: the admin check of a store (P2-26). ORACLE VERSION (qa scratch)."""
+
+from __future__ import annotations
+
+import uuid
+from collections import Counter
+from dataclasses import dataclass, field
+from typing import Any
+
+import sqlalchemy as sa
+from sqlalchemy.engine import Engine
+
+from tracer_evalschema import digest, loader
+from tracer_evalschema.errors import DigestMismatch
+
+from . import codecs, repository
+from .errors import StoreIntegrityError
+from .schema import metadata
+from .tables import ENTITY_TABLES
+
+__all__ = ["VERIFY_NOTES", "VERIFY_PROBLEMS", "VerifyFinding", "VerifyReport", "verify_database"]
+
+VERIFY_PROBLEMS = (
+    "doc_invalid",
+    "digest_mismatch",
+    "doc_sha256_mismatch",
+    "projection_mismatch",
+    "side_rows_mismatch",
+)
+VERIFY_NOTES = ("doc_text_not_canonical", "bundle_member_absent")
+
+
+@dataclass(frozen=True)
+class VerifyFinding:
+    kind: str
+    id: str
+    version: int | None
+    problem: str
+    location: str | None
+
+
+@dataclass(frozen=True)
+class VerifyReport:
+    findings: tuple[VerifyFinding, ...]
+    informational: tuple[VerifyFinding, ...]
+    checked: dict[str, int] = field(default_factory=dict)
+
+    @property
+    def ok(self) -> bool:
+        return not self.findings
+
+
+def _key(f: VerifyFinding) -> tuple[Any, ...]:
+    return (f.kind, f.id, -1 if f.version is None else f.version, f.problem, f.location or "")
+
+
+def _wire(table: str, value: uuid.UUID) -> str:
+    spec = codecs._BY_TABLE[table]
+    return str(spec.model.model_fields["id"].annotation(value))  # type: ignore[misc,operator]
+
+
+def _side_key(row: dict[str, Any]) -> tuple[Any, ...]:
+    return tuple(sorted((k, repr(v)) for k, v in row.items()))
+
+
+_OWNER = {
+    "snapshot_member": ("snapshot_id", "id"),
+    "snapshot_profile_ref": ("snapshot_id", "id"),
+    "dataset_member": None,
+    "external_ref_index": ("entity_id", "id"),
+    "run_bundle_member": ("bundle_id", "id"),
+    "run_bundle_withheld": ("bundle_id", "id"),
+    "export_bundle_run": ("export_id", "id"),
+    "export_bundle_item": ("export_id", "id"),
+    "export_bundle_profile": ("export_id", "id"),
+}
+
+
+def _side_where(conn: sa.Connection, side: str, row: dict[str, Any]) -> list[dict[str, Any]]:
+    t = metadata.tables[side]
+    if side == "dataset_member":
+        clause = sa.and_(t.c.dataset_id == row["id"], t.c.dataset_version == row["version"])
+    else:
+        column, source = _OWNER[side]  # type: ignore[misc]
+        clause = t.c[column] == row[source]
+    return [dict(r) for r in conn.execute(sa.select(t).where(clause)).mappings()]
+
+
+def verify_database(engine: Engine) -> VerifyReport:
+    if not isinstance(engine, Engine):
+        raise TypeError("the first argument must be the Engine of create_store_engine")
+    reader: Engine = engine
+    if engine.dialect.name == "postgresql":
+        reader = engine.execution_options(isolation_level="REPEATABLE READ")
+    findings: list[VerifyFinding] = []
+    notes: list[VerifyFinding] = []
+    checked: dict[str, int] = {}
+    with reader.begin() as conn:
+        for entity in ENTITY_TABLES.values():
+            table = entity.name
+            spec = codecs._BY_TABLE[table]
+            versioned = "version" in entity.c
+            checked[table] = 0
+            for row in [dict(r) for r in conn.execute(sa.select(entity)).mappings()]:
+                checked[table] += 1
+                version = row["version"] if versioned else None
+
+                def add(problem: str, location: str | None, row: dict[str, Any] = row, version: Any = version, table: str = table) -> None:
+                    findings.append(VerifyFinding(table, _wire(table, row["id"]), version, problem, location))
+
+                if table == "run_bundle":
+                    _bundle(conn, row, add, notes)
+                    continue
+                text = row.get("doc")
+                try:
+                    model = codecs._load(spec, text)  # type: ignore[arg-type]
+                except DigestMismatch:
+                    add("digest_mismatch", "doc")
+                    continue
+                except Exception:
+                    add("doc_invalid", "doc")
+                    continue
+                run_id = row.get("run_id") if spec.storage_run_id else None
+                try:
+                    expected = codecs._row(spec, model, run_id)
+                except Exception:
+                    add("doc_invalid", "doc")
+                    continue
+                if not codecs._same(row["doc_sha256"], expected["doc_sha256"]):
+                    add("doc_sha256_mismatch", "doc_sha256")
+                for column in sorted(expected):
+                    if column in ("doc", "doc_sha256"):
+                        continue
+                    if not codecs._same(row.get(column), expected[column]):
+                        add("projection_mismatch", column)
+                if text != expected["doc"]:
+                    notes.append(VerifyFinding(table, _wire(table, row["id"]), version, "doc_text_not_canonical", "doc"))
+                encoded = codecs._encode(spec, model, run_id)
+                for side, wanted in encoded.side_rows.items():
+                    have = _side_where(conn, side, row)
+                    if Counter(map(_side_key, have)) != Counter(map(_side_key, [dict(w) for w in wanted])):
+                        add("side_rows_mismatch", side)
+        conn.rollback()
+    return VerifyReport(
+        tuple(sorted(findings, key=_key)), tuple(sorted(notes, key=_key)), checked
+    )
+
+
+def _bundle(conn: sa.Connection, row: dict[str, Any], add: Any, notes: list[VerifyFinding]) -> None:
+    """A run bundle: the envelope is checked by itself, then the whole bundle when it assembles."""
+    from datetime import datetime
+
+    text = row.get("doc")
+    try:
+        envelope = loader.loads_strict(text)  # type: ignore[arg-type]
+        if not isinstance(envelope, dict):
+            raise ValueError
+        sha = bytes.fromhex(digest.sha256_hex(digest.jcs_bytes(envelope)))
+        created = datetime.fromisoformat(str(envelope["created_at"]).replace("Z", "+00:00"))
+        wire = str(envelope["id"])
+        version = envelope["schema_version"]
+    except Exception:
+        add("doc_invalid", "doc")
+        return
+    reported: set[str] = set()
+
+    def once(problem: str, column: str) -> None:
+        if column not in reported:
+            reported.add(column)
+            add(problem, column if problem == "projection_mismatch" else ("doc_sha256" if problem == "doc_sha256_mismatch" else "doc"))
+
+    if sha != bytes(row["doc_sha256"]):
+        once("doc_sha256_mismatch", "doc_sha256")
+    if wire != _wire("run_bundle", row["id"]):
+        once("projection_mismatch", "id")
+    if version != row["schema_version"]:
+        once("projection_mismatch", "schema_version")
+    if not codecs._same(row["created_at"], created):
+        once("projection_mismatch", "created_at")
+    mt, wt = metadata.tables["run_bundle_member"], metadata.tables["run_bundle_withheld"]
+    members = repository._sorted_members(
+        [dict(r) for r in conn.execute(sa.select(mt).where(mt.c.bundle_id == row["id"])).mappings()]
+    )
+    withheld = [dict(r) for r in conn.execute(sa.select(wt).where(wt.c.bundle_id == row["id"])).mappings()]
+    try:
+        records = repository._read_records(conn, members)
+    except Exception:
+        return  # a member that does not verify is reported under its own table
+    missing = {m["kind"] for m in members if (m["kind"], m["record_id"], m["record_version"]) not in records}
+    if missing:
+        for kind in sorted(missing):
+            notes.append(VerifyFinding("run_bundle", _wire("run_bundle", row["id"]), None, "bundle_member_absent", kind))
+        return
+    try:
+        bundle = codecs.decode_run_bundle(
+            row, members=members, withheld=withheld,
+            resolve=lambda kind, record_id, version: records[kind, record_id, version],
+        )
+    except StoreIntegrityError as exc:
+        if exc.column == "doc":
+            once("doc_invalid", "doc")
+        elif exc.column == "doc_sha256":
+            once("doc_sha256_mismatch", "doc_sha256")
+        else:
+            once("projection_mismatch", exc.column)
+        return
+    except Exception:
+        once("doc_invalid", "doc")
+        return
+    if text != codecs._document(codecs._S_RUN_BUNDLE, bundle)[0]:
+        notes.append(VerifyFinding("run_bundle", _wire("run_bundle", row["id"]), None, "doc_text_not_canonical", "doc"))
