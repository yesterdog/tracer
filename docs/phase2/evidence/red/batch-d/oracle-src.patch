@@ -1,3 +1,80 @@
 # SPDX-License-Identifier: Apache-2.0
 # Copyright 2026 The Tracer contributors
-"""Alembic environment (filled by the migrations batch)."""
+"""Alembic environment. The engine comes from the caller (``config.attributes["engine"]``) or, on
+the command line, from ``-x url=<database URL>``; nothing is read from ``alembic.ini``."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from alembic import context
+from sqlalchemy.engine import Connection, Engine
+
+from tracer_evaldb import create_store_engine, metadata
+from tracer_evaldb.errors import MigrationIntegrityError, StoreConfigurationError
+
+config = context.config
+
+
+def _engine() -> tuple[Engine, bool]:
+    engine = config.attributes.get("engine")
+    if engine is not None:
+        return engine, False
+    url = context.get_x_argument(as_dictionary=True).get("url")
+    if not url:
+        raise StoreConfigurationError("no engine given: pass -x url=<database URL>")
+    return create_store_engine(url), True
+
+
+def _include_object(obj: Any, name: str | None, type_: str, reflected: bool, compare_to: Any) -> bool:
+    return not (type_ == "table" and name == "alembic_version")
+
+
+def _foreign_key_check(context_: Any, **_kw: Any) -> None:
+    rows = context_.connection.exec_driver_sql("PRAGMA foreign_key_check").all()
+    if rows:
+        raise MigrationIntegrityError(sorted({str(row[0]) for row in rows}))
+
+
+def run() -> None:
+    engine, owned = _engine()
+    try:
+        with engine.connect() as connection:
+            sqlite = connection.dialect.name == "sqlite"
+            dbapi = connection.connection.dbapi_connection
+            if sqlite:
+                # outside any transaction: the pragma is a no-op inside one (ADR 0021 rule 7)
+                dbapi.execute("PRAGMA foreign_keys=OFF")  # type: ignore[union-attr]
+            try:
+                _migrate(connection, sqlite)
+            finally:
+                if sqlite:
+                    if connection.in_transaction():
+                        connection.rollback()
+                    dbapi.execute("PRAGMA foreign_keys=ON")  # type: ignore[union-attr]
+    finally:
+        if owned:
+            engine.dispose()
+
+
+def _migrate(connection: Connection, sqlite: bool) -> None:
+    def on_apply(*, ctx: Any, step: Any, heads: Any, run_args: Any) -> None:
+        if sqlite:
+            _foreign_key_check(ctx)
+
+    context.configure(
+        connection=connection,
+        target_metadata=metadata,
+        render_as_batch=True,
+        transactional_ddl=True,
+        transaction_per_migration=True,
+        compare_type=True,
+        compare_server_default=True,
+        include_object=_include_object,
+        on_version_apply=on_apply,
+    )
+    with context.begin_transaction():
+        context.run_migrations()
+
+
+run()
diff -ruN a/packages/evaldb/src/tracer_evaldb/migrations/helpers.py b/packages/evaldb/src/tracer_evaldb/migrations/helpers.py
--- a/packages/evaldb/src/tracer_evaldb/migrations/helpers.py	1970-01-01 05:30:00
+++ b/packages/evaldb/src/tracer_evaldb/migrations/helpers.py	2026-10-24 17:51:44
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Helpers for revisions (ADR 0021 rules 7, 9 to 12): batch alters that keep STRICT, WITHOUT ROWID
+and the immutability triggers, trigger-free windows for data rewrites, and the document rewrite."""
+
+from __future__ import annotations
+
+import contextlib
+import json
+from collections.abc import Callable, Iterator
+from typing import Any
+
+import sqlalchemy as sa
+from alembic import op
+from alembic.operations.base import BatchOperations
+
+from tracer_evalschema import digest as ev_digest
+from tracer_evalschema.errors import DigestMismatch
+from tracer_evaldb import tables, triggers
+from tracer_evaldb.errors import DigestChangingUpgrade, IrreversibleMigration, MixedSchemaVersions
+
+__all__ = ["batch_alter_table", "rewrite_documents", "rewriting"]
+
+PIN = "schema_version_pinned"
+_VERSIONED = frozenset(
+    {
+        "agent_target",
+        "persona",
+        "test_profile",
+        "evaluator",
+        "metric_definition",
+        "metric_binding",
+        "rubric",
+        "pricing_catalog",
+        "dataset",
+    }
+)
+_DIGESTED = _VERSIONED | {"config_snapshot"}
+
+
+def _dialect() -> str:
+    return op.get_bind().dialect.name
+
+
+def _drop_triggers(table: str) -> None:
+    dialect = _dialect()
+    for name, _operation, _function in triggers._operations(table):
+        if dialect == "sqlite":
+            op.execute(f'DROP TRIGGER IF EXISTS "{name}"')
+        else:
+            op.execute(f'DROP TRIGGER IF EXISTS "{name}" ON "{table}"')
+
+
+def _create_triggers(table: str) -> None:
+    for statement in triggers.create_statements(table, _dialect()):
+        op.execute(statement)
+
+
+@contextlib.contextmanager
+def batch_alter_table(table_name: str, **kwargs: Any) -> Iterator[BatchOperations]:
+    """``op.batch_alter_table`` that keeps STRICT and WITHOUT ROWID on SQLite and creates the
+    table's immutability triggers again when it ends (a recreate drops them)."""
+    if _dialect() == "sqlite":
+        kwargs.setdefault("table_kwargs", {"sqlite_strict": True, "sqlite_with_rowid": False})
+    with op.batch_alter_table(table_name, **kwargs) as batch:
+        yield batch
+    if _dialect() == "sqlite":
+        _drop_triggers(table_name)
+        _create_triggers(table_name)
+
+
+@contextlib.contextmanager
+def rewriting(*table_names: str) -> Iterator[None]:
+    """Drop the immutability triggers of these tables, let the caller rewrite rows, and create the
+    triggers again. All inside the revision's transaction."""
+    for table in table_names:
+        _drop_triggers(table)
+    yield
+    for table in table_names:
+        _create_triggers(table)
+
+
+def _entity_tables() -> list[str]:
+    return [table.name for table in tables.ENTITY_TABLES.values()]
+
+
+def rewrite_documents(
+    old_version: str,
+    new_version: str,
+    *,
+    forward: Callable[[str, str], str],
+    backward: Callable[[str, str], str],
+    validate: Callable[[str, str], None],
+) -> None:
+    bind = op.get_bind()
+    names = _entity_tables()
+    plan: list[tuple[str, dict[str, Any], str, bytes]] = []
+    for table in names:
+        keys = ["id", "version"] if table in _VERSIONED else ["id"]
+        extra = ", content_digest_value" if table in _DIGESTED else ""
+        columns = ", ".join(f'"{k}"' for k in keys)
+        rows = bind.execute(sa.text(f'SELECT {columns}, doc{extra} FROM "{table}"')).mappings().all()
+        for row in rows:
+            text = row["doc"]
+            new_text = forward(table, text)
+            if backward(table, new_text) != text:
+                raise IrreversibleMigration(table)
+            parsed = json.loads(new_text)
+            if parsed.get("schema_version") != new_version:
+                raise MixedSchemaVersions(table)
+            if table in _DIGESTED:
+                before = json.loads(text).get("content_digest")
+                if parsed.get("content_digest") != before:
+                    raise DigestChangingUpgrade(table)
+            try:
+                validate(table, new_text)
+            except DigestMismatch:
+                raise DigestChangingUpgrade(table) from None
+            digest = bytes.fromhex(ev_digest.sha256_hex(ev_digest.jcs_bytes(parsed)))
+            plan.append((table, {k: row[k] for k in keys}, new_text, digest))
+
+    all_tables = [*names, "tracer_meta"]
+    for table in all_tables:
+        with batch_alter_table(table) as batch:
+            batch.drop_constraint(PIN, type_="check")
+    with rewriting(*all_tables):
+        for table, key, new_text, digest in plan:
+            where = " AND ".join(f'"{k}" = :k_{k}' for k in key)
+            bind.execute(
+                sa.text(
+                    f'UPDATE "{table}" SET doc = :doc, doc_sha256 = :sha, '
+                    f"schema_version = :version WHERE {where}"
+                ),
+                {"doc": new_text, "sha": digest, "version": new_version}
+                | {f"k_{k}": v for k, v in key.items()},
+            )
+        bind.execute(
+            sa.text("UPDATE tracer_meta SET schema_version = :version"), {"version": new_version}
+        )
+    for table in all_tables:
+        with batch_alter_table(table) as batch:
+            batch.create_check_constraint(PIN, f"schema_version = '{new_version}'")
