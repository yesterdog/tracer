diff -ruN a/packages/evaldb/src/tracer_evaldb/deletion.py b/packages/evaldb/src/tracer_evaldb/deletion.py
--- a/packages/evaldb/src/tracer_evaldb/deletion.py	1970-01-01 05:30:00
+++ b/packages/evaldb/src/tracer_evaldb/deletion.py	2026-10-24 17:25:32
@@ -0,0 +1,327 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Deletion roots, application-level cascades and the deletion audit (ADR 0020)."""
+
+from __future__ import annotations
+
+import contextlib
+import datetime as dt
+import json
+import uuid
+from collections.abc import Iterator, Mapping, Sequence
+from dataclasses import dataclass
+from types import MappingProxyType
+from typing import Any
+
+import sqlalchemy as sa
+from sqlalchemy.engine import Connection, Engine
+
+from tracer_evalschema import ids as ev_ids
+from tracer_evalschema.credentials import credential_reason
+from tracer_evalschema.text import _check_label
+
+from .errors import RecordNotStored, SnapshotInUse, StoreConstraintViolation
+from .repository import _engine, _uuid_of, translate_integrity_error
+from .schema import metadata
+
+__all__ = [
+    "DELETION_REASONS",
+    "DeletionResult",
+    "delete_dataset_item",
+    "delete_definition",
+    "delete_export",
+    "delete_project",
+    "delete_run",
+    "delete_snapshot",
+    "delete_test_profile",
+]
+
+DELETION_REASONS = ("operator_request", "retention_policy", "data_subject_request")
+RUN_KEYS = (
+    "run",
+    "artifact",
+    "transcript",
+    "turn",
+    "exchange",
+    "tool_call_event",
+    "stage_span",
+    "metric_result",
+    "run_verdict",
+    "usage_record",
+    "cost_record",
+    "cost_summary",
+    "run_bundle",
+    "config_snapshot",
+    "dataset_item",
+    "export_bundle",
+)
+_RUN_OWNED = RUN_KEYS[1:13]
+DEFINITION_KINDS = (
+    "agent_target",
+    "persona",
+    "evaluator",
+    "metric_definition",
+    "metric_binding",
+    "rubric",
+    "pricing_catalog",
+    "dataset",
+)
+
+
+@dataclass(frozen=True)
+class DeletionResult:
+    root_kind: str
+    counts: Mapping[str, int]
+    audit_uuid: uuid.UUID
+
+
+def _t(name: str) -> sa.Table:
+    return metadata.tables[name]
+
+
+def _arguments(actor: object, reason: object) -> tuple[str, str]:
+    if not isinstance(actor, str):
+        raise TypeError("actor must be a str")
+    if not isinstance(reason, str):
+        raise TypeError("reason must be a str")
+    if reason not in DELETION_REASONS:
+        raise ValueError(f"reason must be one of: {', '.join(DELETION_REASONS)}")
+    if not actor:
+        raise ValueError("actor must not be empty")
+    try:
+        _check_label(actor)
+    except ValueError:
+        raise ValueError("actor is not a valid label (rule: no control, separator or invisible)") from None
+    flagged = credential_reason(actor)
+    if flagged is not None:
+        raise ValueError(f"actor looks like a credential (rule: {flagged})")
+    return actor, reason
+
+
+class _Root:
+    """The state of one deletion: its counts, and the audit uuid once the audit row is written."""
+
+    def __init__(self, kind: str, keys: Sequence[str]) -> None:
+        self.kind = kind
+        self.keys = tuple(keys)
+        self.counts: dict[str, int] = {}
+        self.audit_uuid: uuid.UUID | None = None
+
+    def result(self) -> DeletionResult:
+        assert self.audit_uuid is not None
+        full = {key: self.counts.get(key, 0) for key in self.keys}
+        return DeletionResult(self.kind, MappingProxyType(full), self.audit_uuid)
+
+
+@contextlib.contextmanager
+def _root(engine: Engine, actor: str, reason: str, kind: str, keys: Sequence[str]) -> Iterator[tuple[Connection, _Root]]:
+    root = _Root(kind, keys)
+    options = {"tracer_sqlite_begin": "BEGIN IMMEDIATE"}
+    try:
+        with engine.connect().execution_options(**options) as connection:
+            with connection.begin():
+                yield connection, root
+                unexpected = set(root.counts) - set(root.keys)
+                assert not unexpected, unexpected
+                full = {key: root.counts.get(key, 0) for key in root.keys}
+                root.audit_uuid = ev_ids.uuid7()
+                connection.execute(
+                    sa.insert(_t("deletion_audit")).values(
+                        audit_uuid=root.audit_uuid,
+                        deleted_at=dt.datetime.now(dt.UTC),
+                        actor=actor,
+                        reason=reason,
+                        root_kind=kind,
+                        counts=json.dumps(full, sort_keys=True, separators=(",", ":")),
+                    )
+                )
+    except sa.exc.IntegrityError as error:
+        raise translate_integrity_error(error) from None
+
+
+def _lock(connection: Connection, statement: Any) -> Any:
+    if connection.dialect.name == "postgresql":
+        statement = statement.with_for_update()
+    return statement
+
+
+def _run_flow(connection: Connection, run_uuid: uuid.UUID, counts: dict[str, int]) -> None:
+    run = _t("run")
+    row = connection.execute(_lock(connection, sa.select(run.c.config_snapshot_id).where(run.c.id == run_uuid))).first()
+    snapshot_id = row[0]
+    snap = _t("config_snapshot")
+    connection.execute(_lock(connection, sa.select(snap.c.id).where(snap.c.id == snapshot_id))).all()
+    artifact, transcript = _t("artifact"), _t("transcript")
+    a_ids = list(connection.execute(sa.select(artifact.c.id).where(artifact.c.run_id == run_uuid)).scalars())
+    t_ids = list(connection.execute(sa.select(transcript.c.id).where(transcript.c.run_id == run_uuid)).scalars())
+    item = _t("dataset_item")
+    conditions = []
+    if a_ids:
+        conditions.append(item.c.artifact_id.in_(a_ids))
+    if t_ids:
+        conditions.append(item.c.transcript_id.in_(t_ids))
+    item_ids: list[uuid.UUID] = []
+    if conditions:
+        item_ids = list(connection.execute(_lock(connection, sa.select(item.c.id).where(sa.or_(*conditions)))).scalars())
+    link_run, link_item = _t("export_bundle_run"), _t("export_bundle_item")
+    export_ids = set(connection.execute(sa.select(link_run.c.export_id).where(link_run.c.run_id == run_uuid)).scalars())
+    if item_ids:
+        export_ids |= set(connection.execute(sa.select(link_item.c.export_id).where(link_item.c.item_id.in_(item_ids))).scalars())
+    export = _t("export_bundle")
+    if export_ids:
+        connection.execute(_lock(connection, sa.select(export.c.id).where(export.c.id.in_(export_ids)))).all()
+        connection.execute(sa.delete(export).where(export.c.id.in_(export_ids)))
+    if item_ids:
+        connection.execute(sa.delete(item).where(item.c.id.in_(item_ids)))
+    for table in _RUN_OWNED:
+        t = _t(table)
+        n = connection.execute(sa.select(sa.func.count()).select_from(t).where(t.c.run_id == run_uuid)).scalar_one()
+        counts[table] = counts.get(table, 0) + int(n)
+    connection.execute(sa.delete(run).where(run.c.id == run_uuid))
+    counts["run"] = counts.get("run", 0) + 1
+    counts["dataset_item"] = counts.get("dataset_item", 0) + len(item_ids)
+    counts["export_bundle"] = counts.get("export_bundle", 0) + len(export_ids)
+    still = connection.execute(sa.select(sa.func.count()).select_from(run).where(run.c.config_snapshot_id == snapshot_id)).scalar_one()
+    if not still:
+        connection.execute(sa.delete(snap).where(snap.c.id == snapshot_id))
+        counts["config_snapshot"] = counts.get("config_snapshot", 0) + 1
+
+
+def delete_run(engine: Engine, run_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    run_uuid = _uuid_of(run_id, ev_ids.RunId)
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, "run", RUN_KEYS) as (connection, root):
+        counts = root.counts
+        run = _t("run")
+        found = connection.execute(_lock(connection, sa.select(run.c.id).where(run.c.id == run_uuid))).first()
+        if found is None:
+            raise RecordNotStored("run", ev_ids.RunId(run_uuid))
+        _run_flow(connection, run_uuid, counts)
+    return root.result()
+
+
+def delete_project(engine: Engine, project_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    project_uuid = _uuid_of(project_id, ev_ids.ProjectId)
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, "project", ("project", *RUN_KEYS)) as (connection, root):
+        counts = root.counts
+        project, run = _t("project"), _t("run")
+        found = connection.execute(_lock(connection, sa.select(project.c.id).where(project.c.id == project_uuid))).first()
+        if found is None:
+            raise RecordNotStored("project", ev_ids.ProjectId(project_uuid))
+        run_ids = list(connection.execute(_lock(connection, sa.select(run.c.id).where(run.c.project_id == project_uuid).order_by(run.c.id))).scalars())
+        snapshots = _t("config_snapshot")
+        wanted = set(connection.execute(sa.select(run.c.config_snapshot_id).where(run.c.project_id == project_uuid)).scalars())
+        if wanted:
+            connection.execute(_lock(connection, sa.select(snapshots.c.id).where(snapshots.c.id.in_(wanted)))).all()
+        for run_uuid in run_ids:
+            _run_flow(connection, run_uuid, counts)
+        connection.execute(sa.delete(project).where(project.c.id == project_uuid))
+        counts["project"] = 1
+    return root.result()
+
+
+def delete_test_profile(engine: Engine, profile_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    profile_uuid = _uuid_of(profile_id, ev_ids.TestProfileId)
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, "test_profile", ("test_profile", "export_bundle")) as (connection, root):
+        counts = root.counts
+        profile, link, export = _t("test_profile"), _t("export_bundle_profile"), _t("export_bundle")
+        rows = connection.execute(_lock(connection, sa.select(profile.c.id).where(profile.c.id == profile_uuid))).all()
+        if not rows:
+            raise RecordNotStored("test_profile", ev_ids.TestProfileId(profile_uuid))
+        export_ids = set(connection.execute(sa.select(link.c.export_id).where(link.c.profile_id == profile_uuid)).scalars())
+        if export_ids:
+            connection.execute(_lock(connection, sa.select(export.c.id).where(export.c.id.in_(export_ids)))).all()
+            connection.execute(sa.delete(export).where(export.c.id.in_(export_ids)))
+        connection.execute(sa.delete(profile).where(profile.c.id == profile_uuid))
+        counts["test_profile"] = len(rows)
+        counts["export_bundle"] = len(export_ids)
+    return root.result()
+
+
+_ID_CLASSES = {
+    "agent_target": ev_ids.AgentTargetId,
+    "persona": ev_ids.PersonaId,
+    "evaluator": ev_ids.EvaluatorId,
+    "metric_definition": ev_ids.MetricDefinitionId,
+    "metric_binding": ev_ids.MetricBindingId,
+    "rubric": ev_ids.RubricId,
+    "pricing_catalog": ev_ids.PricingCatalogId,
+    "dataset": ev_ids.DatasetId,
+}
+
+
+def delete_definition(engine: Engine, kind: str, definition_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    if kind == "test_profile":
+        raise ValueError("use delete_test_profile for a test profile")
+    if not isinstance(kind, str) or kind not in DEFINITION_KINDS:
+        raise ValueError(f"kind must be one of: {', '.join(DEFINITION_KINDS)}")
+    def_uuid = _uuid_of(definition_id, _ID_CLASSES[kind])
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, kind, (kind,)) as (connection, root):
+        counts = root.counts
+        table = _t(kind)
+        rows = connection.execute(_lock(connection, sa.select(table.c.id).where(table.c.id == def_uuid))).all()
+        if not rows:
+            raise RecordNotStored(kind, _ID_CLASSES[kind](def_uuid))
+        connection.execute(sa.delete(table).where(table.c.id == def_uuid))
+        counts[kind] = len(rows)
+    return root.result()
+
+
+def delete_dataset_item(engine: Engine, item_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    item_uuid = _uuid_of(item_id, ev_ids.DatasetItemId)
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, "dataset_item", ("dataset_item", "export_bundle")) as (connection, root):
+        counts = root.counts
+        item, link, export = _t("dataset_item"), _t("export_bundle_item"), _t("export_bundle")
+        found = connection.execute(_lock(connection, sa.select(item.c.id).where(item.c.id == item_uuid))).first()
+        if found is None:
+            raise RecordNotStored("dataset_item", ev_ids.DatasetItemId(item_uuid))
+        export_ids = set(connection.execute(sa.select(link.c.export_id).where(link.c.item_id == item_uuid)).scalars())
+        if export_ids:
+            connection.execute(_lock(connection, sa.select(export.c.id).where(export.c.id.in_(export_ids)))).all()
+            connection.execute(sa.delete(export).where(export.c.id.in_(export_ids)))
+        connection.execute(sa.delete(item).where(item.c.id == item_uuid))
+        counts["dataset_item"] = 1
+        counts["export_bundle"] = len(export_ids)
+    return root.result()
+
+
+def delete_export(engine: Engine, export_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    export_uuid = _uuid_of(export_id, ev_ids.ExportBundleId)
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, "export_bundle", ("export_bundle",)) as (connection, root):
+        counts = root.counts
+        export = _t("export_bundle")
+        found = connection.execute(_lock(connection, sa.select(export.c.id).where(export.c.id == export_uuid))).first()
+        if found is None:
+            raise RecordNotStored("export_bundle", ev_ids.ExportBundleId(export_uuid))
+        connection.execute(sa.delete(export).where(export.c.id == export_uuid))
+        counts["export_bundle"] = 1
+    return root.result()
+
+
+def delete_snapshot(engine: Engine, snapshot_id: Any, *, actor: str, reason: str) -> DeletionResult:
+    _engine(engine)
+    snapshot_uuid = _uuid_of(snapshot_id, ev_ids.ConfigSnapshotId)
+    actor, reason = _arguments(actor, reason)
+    with _root(engine, actor, reason, "config_snapshot", ("config_snapshot",)) as (connection, root):
+        counts = root.counts
+        snap, run = _t("config_snapshot"), _t("run")
+        found = connection.execute(_lock(connection, sa.select(snap.c.id).where(snap.c.id == snapshot_uuid))).first()
+        if found is None:
+            raise RecordNotStored("config_snapshot", ev_ids.ConfigSnapshotId(snapshot_uuid))
+        users = connection.execute(sa.select(sa.func.count()).select_from(run).where(run.c.config_snapshot_id == snapshot_uuid)).scalar_one()
+        if users:
+            raise SnapshotInUse(ev_ids.ConfigSnapshotId(snapshot_uuid))
+        connection.execute(sa.delete(snap).where(snap.c.id == snapshot_uuid))
+        counts["config_snapshot"] = 1
+    return root.result()
diff -ruN a/packages/evaldb/src/tracer_evaldb/engine.py b/packages/evaldb/src/tracer_evaldb/engine.py
