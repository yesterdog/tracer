+            '\trecord_id BLOB NOT NULL, \n'
+            '\tPRIMARY KEY (bundle_id, ordinal), \n'
+            '\tCONSTRAINT fk_run_bundle_withheld_bundle_id FOREIGN KEY(bundle_id) REFERENCES '
+            'run_bundle (id) ON DELETE CASCADE, \n'
+            "\tCONSTRAINT kind_closed CHECK (kind IN ('artifact', 'transcript', 'turn', "
+            "'exchange', 'tool_call', 'span', 'result', 'usage_record', 'cost_record')), \n"
+            '\tCONSTRAINT bundle_id_uuid_v7 CHECK ((bundle_id IS NULL OR (length(bundle_id) = '
