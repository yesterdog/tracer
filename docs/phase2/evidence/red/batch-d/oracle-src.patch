+++ b/packages/evaldb/src/tracer_evaldb/engine.py	2026-10-24 17:03:31
@@ -127,7 +127,9 @@
 
     @event.listens_for(engine, "begin")
     def _begin(connection: Connection) -> None:
-        connection.exec_driver_sql("BEGIN")
+        # A write root (deletion) asks for BEGIN IMMEDIATE so that it holds the write lock first.
+        statement = connection.get_execution_options().get("tracer_sqlite_begin", "BEGIN")
+        connection.exec_driver_sql(statement)
 
     _probe(engine).close()
     return engine
