diff -ruN a/packages/evaldb/src/tracer_evaldb/migrate.py b/packages/evaldb/src/tracer_evaldb/migrate.py
--- a/packages/evaldb/src/tracer_evaldb/migrate.py	1970-01-01 05:30:00
+++ b/packages/evaldb/src/tracer_evaldb/migrate.py	2026-10-24 18:09:39
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Programmatic migrations (ADR 0021 rules 3 and 4): ``upgrade``, ``downgrade``, the revision
+queries. Nothing here runs by itself; ``open_store`` never calls it."""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Sequence
+from importlib import resources
+from typing import TYPE_CHECKING
+
+import sqlalchemy as sa
+from sqlalchemy.engine import Engine
+
+if TYPE_CHECKING:  # alembic is imported inside the functions: `import tracer_evaldb` loads none of it
+    from alembic.config import Config
+    from alembic.script import ScriptDirectory
+
+from .errors import DowngradeDataLoss, StoreRevisionUnknown
+
+__all__ = [
+    "alembic_config",
+    "current_revision",
+    "downgrade",
+    "head_revision",
+    "upgrade",
+]
+
+
+def _engine(engine: object) -> Engine:
+    if not isinstance(engine, Engine):
+        raise TypeError("the first argument must be the Engine of create_store_engine")
+    return engine
+
+
+def alembic_config(
+    engine: Engine | None = None,
+    *,
+    version_locations: Sequence[str | os.PathLike[str]] = (),
+) -> "Config":
+    """A ``Config`` for the shipped migrations (and any extra revision directories)."""
+    from alembic.config import Config
+
+    config = Config()
+    location = str(resources.files("tracer_evaldb") / "migrations")
+    config.set_main_option("script_location", location)
+    if version_locations:
+        shipped = os.path.join(location, "versions")
+        paths = [shipped, *(os.fspath(p) for p in version_locations)]
+        config.set_main_option("version_locations", os.pathsep.join(paths))
+        config.set_main_option("path_separator", "os")
+    if engine is not None:
+        config.attributes["engine"] = _engine(engine)
+    return config
+
+
+def head_revision() -> str:
+    """The head of the migrations this evaldb ships."""
+    from alembic.script import ScriptDirectory
+
+    head = ScriptDirectory.from_config(alembic_config()).get_current_head()
+    assert head is not None
+    return head
+
+
+def current_revision(engine: Engine) -> str | None:
+    """The revision the database is at, or ``None`` for a database that was never migrated."""
+    from alembic.migration import MigrationContext
+
+    with _engine(engine).connect() as connection:
+        found = MigrationContext.configure(connection).get_current_revision()
+        connection.rollback()
+    return found
+
+
+def is_known(script: "ScriptDirectory", revision: str) -> bool:
+    """True when the shipped (and extra) revisions include ``revision``."""
+    try:
+        return script.get_revision(revision) is not None
+    except Exception:
+        return False
+
+
+def _check_revision(revision: object) -> str:
+    if not isinstance(revision, str):
+        raise TypeError("revision must be a str")
+    if not revision:
+        raise ValueError("revision must not be empty")
+    return revision
+
+
+def upgrade(
+    engine: Engine,
+    revision: str = "head",
+    *,
+    version_locations: Sequence[str | os.PathLike[str]] = (),
+) -> None:
+    """Migrate the database up to ``revision``. Each revision runs in its own transaction."""
+    from alembic import command
+    from alembic.script import ScriptDirectory
+
+    _engine(engine)
+    revision = _check_revision(revision)
+    config = alembic_config(engine, version_locations=version_locations)
+    script = ScriptDirectory.from_config(config)
+    current = current_revision(engine)
+    if current is not None and not is_known(script, current):
+        raise StoreRevisionUnknown(current)
+    try:
+        script.get_revision(revision)
+    except Exception:
+        raise ValueError("unknown target revision") from None
+    command.upgrade(config, revision)
+
+
+def _data_loss(engine: Engine, script: "ScriptDirectory", current: str, target: str) -> list[str]:
+    undone = []
+    resolved = None if target == "base" else script.get_revision(target)
+    for rev in script.iterate_revisions(current, target):
+        if resolved is not None and rev.revision == resolved.revision:
+            continue
+        undone.append(rev)
+    lost: set[str] = set()
+    with engine.connect() as connection:
+        inspector = sa.inspect(connection)
+        for rev in undone:
+            for entry in getattr(rev.module, "DOWNGRADE_DROPS", ()):
+                table, _, column = entry.partition(".")
+                if not inspector.has_table(table):
+                    continue
+                quoted = f'"{table}"'
+                where = f' WHERE "{column}" IS NOT NULL' if column else ""
+                found = connection.exec_driver_sql(f"SELECT count(*) FROM {quoted}{where}").scalar()
+                if found:
+                    lost.add(table)
+        connection.rollback()
+    return sorted(lost)
+
+
+def downgrade(
+    engine: Engine,
+    revision: str,
+    *,
+    allow_data_loss: bool = False,
+    version_locations: Sequence[str | os.PathLike[str]] = (),
+) -> None:
+    """Migrate the database down to ``revision`` (``"base"`` for nothing). A downgrade that would
+    drop rows is refused before anything changes unless ``allow_data_loss`` is true."""
+    from alembic import command
+    from alembic.script import ScriptDirectory
+
+    _engine(engine)
+    revision = _check_revision(revision)
+    if type(allow_data_loss) is not bool:
+        raise TypeError("allow_data_loss must be a bool")
+    config = alembic_config(engine, version_locations=version_locations)
+    script = ScriptDirectory.from_config(config)
+    current = current_revision(engine)
+    if current is None:
+        return
+    if not is_known(script, current):
+        raise StoreRevisionUnknown(current)
+    try:
+        if revision != "base":
+            script.get_revision(revision)
+    except Exception:
+        raise ValueError("unknown target revision") from None
+    if not allow_data_loss:
+        lost = _data_loss(engine, script, current, revision)
+        if lost:
+            raise DowngradeDataLoss(lost)
+    command.downgrade(config, revision)
