+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+[build-system]
+requires = ["hatchling==1.32.4"]
+build-backend = "hatchling.build"
+
+[project]
+name = "tracer-evaldb"
+version = "0.0.1"
+description = "Relational storage (SQLite and Postgres) for Tracer evaluation entities."
+readme = "README.md"
+requires-python = ">=3.11"
+license = "Apache-2.0"
+license-files = ["LICENSE", "NOTICE"]
+dependencies = [
+    "tracer-evalschema==0.0.1",
+    "sqlalchemy>=2.1.6,<3",
+    "alembic>=1.20.1,<2",
+]
