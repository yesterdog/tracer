+          PG_PASSWORD="$(openssl rand -hex 24)"
+          echo "::add-mask::$PG_PASSWORD"
+          echo "PG_PASSWORD=$PG_PASSWORD" >> "$GITHUB_ENV"
+          docker run --detach --name pg -e POSTGRES_PASSWORD="$PG_PASSWORD" -p 127.0.0.1:5432:5432 ${{ matrix.image }}
+          for i in $(seq 1 60); do docker exec pg pg_isready -U postgres && break; sleep 1; done
