diff --color -ruN a/packages/evaldb/src/tracer_evaldb/columns.py b/packages/evaldb/src/tracer_evaldb/columns.py
--- a/packages/evaldb/src/tracer_evaldb/columns.py	1970-01-01 05:30:00
+++ b/packages/evaldb/src/tracer_evaldb/columns.py	2026-10-24 11:11:08
@@ -0,0 +1,229 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Column types of the store (oracle implementation of docs/phase2/api-surface-batch-a.md)."""
+
+from __future__ import annotations
+
+import uuid
+from datetime import UTC, datetime
+from decimal import Decimal
+from typing import Any
+
+import sqlalchemy as sa
+from sqlalchemy import event
+from sqlalchemy.dialects import postgresql
+from sqlalchemy.ext.compiler import compiles
+from sqlalchemy.sql.expression import ColumnElement
+from sqlalchemy.types import TypeDecorator
+
+__all__ = [
+    "BoolCol",
+    "DecimalCol",
+    "DocCol",
+    "InstantCol",
+    "KeyCol",
+    "Sha256Col",
+    "UuidCol",
+]
+
+
+class _Check(ColumnElement[bool]):
+    inherit_cache = False
+
+    def __init__(self, kind: str, column: Any) -> None:
+        self.kind = kind
+        self.column = column
+        self.type = sa.Boolean()
+
+
+@compiles(_Check, "sqlite")
+def _check_sqlite(element: _Check, compiler: Any, **kw: Any) -> str:
+    col = compiler.process(element.column, **kw)
+    if element.kind == "uuid_v7":
+        return f"({col} IS NULL OR (length({col}) = 16 AND substr(hex({col}), 13, 1) = '7'))"
+    if element.kind == "sha256":
+        return f"length({col}) = 32"
+    return f"{col} IN (0, 1)"
+
+
+@compiles(_Check, "postgresql")
+def _check_postgresql(element: _Check, compiler: Any, **kw: Any) -> str:
+    col = compiler.process(element.column, **kw)
+    if element.kind == "uuid_v7":
+        return f"substr({col}::text, 15, 1) = '7'"
+    if element.kind == "sha256":
+        return f"octet_length({col}) = 32"
+    return "true"
+
+
+@compiles(_Check)
+def _check_default(element: _Check, compiler: Any, **kw: Any) -> str:
+    return "true"
+
+
+def _text(value: Any) -> str:
+    if type(value) is not str:
+        raise ValueError("a text value is required")
+    if "\x00" in value:
+        raise ValueError("U+0000 is not storable")
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        raise ValueError("the text is not valid Unicode") from None
+    return value
+
+
+class UuidCol(TypeDecorator[uuid.UUID]):
+    impl = sa.LargeBinary
+    cache_ok = True
+    check_kind = "uuid_v7"
+
+    def load_dialect_impl(self, dialect: Any) -> Any:
+        if dialect.name == "postgresql":
+            return dialect.type_descriptor(postgresql.UUID(as_uuid=True))
+        return dialect.type_descriptor(sa.LargeBinary())
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        if type(value) is not uuid.UUID:
+            raise ValueError("a uuid.UUID is required")
+        return value if dialect.name == "postgresql" else value.bytes
+
+    def process_result_value(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        return value if isinstance(value, uuid.UUID) else uuid.UUID(bytes=bytes(value))
+
+
+class Sha256Col(TypeDecorator[bytes]):
+    impl = sa.LargeBinary
+    cache_ok = True
+    check_kind = "sha256"
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        if type(value) is not bytes or len(value) != 32:
+            raise ValueError("32 bytes are required")
+        return value
+
+    def process_result_value(self, value: Any, dialect: Any) -> Any:
+        return None if value is None else bytes(value)
+
+
+class InstantCol(TypeDecorator[datetime]):
+    impl = sa.Text
+    cache_ok = True
+
+    def load_dialect_impl(self, dialect: Any) -> Any:
+        if dialect.name == "postgresql":
+            return dialect.type_descriptor(postgresql.TIMESTAMP(timezone=True))
+        return dialect.type_descriptor(sa.Text())
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        if type(value) is not datetime or value.tzinfo is None or value.utcoffset() is None:
+            raise ValueError("a timezone-aware datetime is required")
+        try:
+            utc = value.astimezone(UTC)
+        except OverflowError:
+            raise ValueError("the instant is outside years 1 to 9999") from None
+        if dialect.name == "postgresql":
+            return utc
+        return (
+            f"{utc.year:04d}-{utc.month:02d}-{utc.day:02d}T{utc.hour:02d}:{utc.minute:02d}:"
+            f"{utc.second:02d}.{utc.microsecond:06d}Z"
+        )
+
+    def process_result_value(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        if isinstance(value, datetime):
+            return value.astimezone(UTC)
+        return datetime(
+            int(value[0:4]),
+            int(value[5:7]),
+            int(value[8:10]),
+            int(value[11:13]),
+            int(value[14:16]),
+            int(value[17:19]),
+            int(value[20:26]),
+            tzinfo=UTC,
+        )
+
+
+class DecimalCol(TypeDecorator[Decimal]):
+    impl = sa.Text
+    cache_ok = True
+
+    def load_dialect_impl(self, dialect: Any) -> Any:
+        if dialect.name == "postgresql":
+            return dialect.type_descriptor(sa.Numeric(asdecimal=True))
+        return dialect.type_descriptor(sa.Text())
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        if type(value) is not Decimal:
+            raise ValueError("a decimal.Decimal is required")
+        if not value.is_finite():
+            raise ValueError("NaN and infinity are not storable")
+        if value.is_zero() and value.is_signed():
+            raise ValueError("negative zero is not storable")
+        return value if dialect.name == "postgresql" else format(value, "f")
+
+    def process_result_value(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        return value if isinstance(value, Decimal) else Decimal(value)
+
+
+class DocCol(TypeDecorator[str]):
+    impl = sa.Text
+    cache_ok = True
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        return None if value is None else _text(value)
+
+
+class KeyCol(TypeDecorator[str]):
+    impl = sa.Text
+    cache_ok = True
+
+    def load_dialect_impl(self, dialect: Any) -> Any:
+        if dialect.name == "postgresql":
+            return dialect.type_descriptor(sa.Text(collation="C"))
+        return dialect.type_descriptor(sa.Text())
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        return None if value is None else _text(value)
+
+
+class BoolCol(TypeDecorator[bool]):
+    impl = sa.Integer
+    cache_ok = True
+    check_kind = "bool"
+
+    def load_dialect_impl(self, dialect: Any) -> Any:
+        if dialect.name == "postgresql":
+            return dialect.type_descriptor(sa.Boolean())
+        return dialect.type_descriptor(sa.Integer())
+
+    def process_bind_param(self, value: Any, dialect: Any) -> Any:
+        if value is None:
+            return None
+        if type(value) is not bool:
+            raise ValueError("a bool or None is required")
+        return value if dialect.name == "postgresql" else int(value)
+
+    def process_result_value(self, value: Any, dialect: Any) -> Any:
+        return None if value is None else bool(value)
+
+
+@event.listens_for(sa.Column, "after_parent_attach")
+def _attach_checks(column: Any, table: Any) -> None:
+    kind = getattr(column.type, "check_kind", None)
+    if kind is not None and isinstance(table, sa.Table):
+        table.append_constraint(sa.CheckConstraint(_Check(kind, column), name=None))
diff --color -ruN a/packages/evaldb/src/tracer_evaldb/engine.py b/packages/evaldb/src/tracer_evaldb/engine.py
--- a/packages/evaldb/src/tracer_evaldb/engine.py	1970-01-01 05:30:00
+++ b/packages/evaldb/src/tracer_evaldb/engine.py	2026-10-24 11:08:43
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""``create_store_engine``: SQLAlchemy engines configured the way the store needs them."""
+
+from __future__ import annotations
+
+import sqlite3
+from typing import Any
+
+import sqlalchemy as sa
+from sqlalchemy import event
+from sqlalchemy.engine import URL, Engine, make_url
+
+from .errors import (
+    StoreConfigurationError,
+    StoreConnectionError,
+    UnsupportedServerEncoding,
+    UnsupportedSqliteVersion,
+)
+
+_SQLITE_MINIMUM = (3, 37, 0)
+
+
+def create_store_engine(url: str | URL, *, busy_timeout_ms: int = 5000) -> Engine:
+    if type(busy_timeout_ms) is not int or busy_timeout_ms < 0:
+        raise StoreConfigurationError("busy_timeout_ms must be a non-negative integer")
+    try:
+        parsed = url if isinstance(url, URL) else make_url(url)
+        backend, driver = parsed.get_backend_name(), parsed.get_driver_name()
+    except Exception:
+        raise StoreConfigurationError("the database URL could not be parsed") from None
+    if (backend, driver) == ("sqlite", "pysqlite"):
+        return _sqlite(parsed, busy_timeout_ms)
+    if (backend, driver) == ("postgresql", "pg8000"):
+        return _postgres(parsed)
+    raise StoreConfigurationError(
+        "unsupported database URL: use sqlite:///<path> or postgresql+pg8000://..."
+    )
+
+
+def _probe(engine: Engine) -> Any:
+    try:
+        return engine.connect()
+    except Exception:
+        engine.dispose()
+        raise StoreConnectionError("could not connect to the database") from None
+
+
+def _sqlite(url: URL, busy_timeout_ms: int) -> Engine:
+    if sqlite3.sqlite_version_info < _SQLITE_MINIMUM:
+        raise UnsupportedSqliteVersion(
+            f"SQLite {sqlite3.sqlite_version} is too old; 3.37 or newer is required"
+        )
+    engine = sa.create_engine(url)
+
+    @event.listens_for(engine, "connect")
+    def _on_connect(dbapi_connection: Any, record: Any) -> None:
+        dbapi_connection.isolation_level = None  # no implicit transaction handling by sqlite3
+        cursor = dbapi_connection.cursor()
+        cursor.execute("PRAGMA foreign_keys=ON")
+        cursor.execute(f"PRAGMA busy_timeout={int(busy_timeout_ms)}")
+        cursor.close()
+
+    @event.listens_for(engine, "begin")
+    def _on_begin(conn: Any) -> None:
+        conn.exec_driver_sql("BEGIN")
+
+    _probe(engine).close()
+    return engine
+
+
+def _postgres(url: URL) -> Engine:
+    try:
+        engine = sa.create_engine(url)
+    except Exception:
+        raise StoreConfigurationError("the postgres driver is not available") from None
+
+    @event.listens_for(engine, "connect")
+    def _on_connect(dbapi_connection: Any, record: Any) -> None:
+        cursor = dbapi_connection.cursor()
+        cursor.execute("SET TIME ZONE 'UTC'")
+        cursor.close()
+        dbapi_connection.commit()
+
+    with _probe(engine) as conn:
+        encoding = conn.exec_driver_sql("SHOW server_encoding").scalar_one()
+    if encoding != "UTF8":
+        engine.dispose()
+        raise UnsupportedServerEncoding(
+            f"the database server_encoding is {encoding}; UTF8 is required"
+        )
+    return engine
diff --color -ruN a/packages/evaldb/src/tracer_evaldb/errors.py b/packages/evaldb/src/tracer_evaldb/errors.py
