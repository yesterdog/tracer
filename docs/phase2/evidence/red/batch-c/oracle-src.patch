-__all__ = ["create_store_engine"]
+__all__ = ["INTEGRITY_SQLSTATE_CLASS", "create_store_engine", "is_integrity_sqlstate", "sqlstate_of"]
 
+INTEGRITY_SQLSTATE_CLASS = "23"
+
+
+def sqlstate_of(exception: BaseException) -> str | None:
+    """The SQLSTATE a pg8000 error carries (``args[0]["C"]``), or None."""
+    args = getattr(exception, "args", ())
+    if args and isinstance(args[0], dict):
+        code = args[0].get("C")
+        return code if isinstance(code, str) else None
+    return None
+
+
+def is_integrity_sqlstate(code: str | None) -> bool:
+    """True for every SQLSTATE of class 23 (integrity constraint violation)."""
+    return isinstance(code, str) and len(code) == 5 and code.startswith(INTEGRITY_SQLSTATE_CLASS)
+
+
+def _translate(context: Any) -> Exception | None:
+    """``handle_error`` hook: pg8000 reports every server error as ``ProgrammingError``; a
+    SQLSTATE of class 23 becomes ``sqlalchemy.exc.IntegrityError`` (the DBAPI error is kept as
+    ``orig``), as on SQLite."""
+    original = context.original_exception
+    if original is None or not is_integrity_sqlstate(sqlstate_of(original)):
+        return None
+    return sa.exc.IntegrityError(
+        context.statement, context.parameters, _without_row_content(original), hide_parameters=True
+    )
+
+
+# The fields of a pg8000 error that name the failure and nothing of the row: severity, SQLSTATE,
+# message, schema, table, column, data type and constraint. The detail ("Failing row contains
+# (...)", "Key (id)=(...)") quotes values and is dropped.
+_KEEP = ("S", "V", "C", "M", "s", "t", "c", "d", "n")
+
+
+def _without_row_content(original: BaseException) -> BaseException:
+    args = original.args
+    if args and isinstance(args[0], dict):
+        kept = {key: value for key, value in args[0].items() if key in _KEEP}
+        try:
+            return type(original)(kept)
+        except Exception:
+            return original
+    return original
+
+
 # STRICT tables (3.37) are part of the storage design.
 _SQLITE_MINIMUM = (3, 37, 0)
 
