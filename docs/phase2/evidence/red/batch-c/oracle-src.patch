--- a/packages/evaldb/src/tracer_evaldb/triggers.py
+++ b/packages/evaldb/src/tracer_evaldb/triggers.py
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Immutability triggers (ADR 0020 Decision 7), created with the tables by ``create_all``.
+
+Every table of the store has a ``BEFORE UPDATE`` trigger that raises; ``deletion_audit`` also has a
+``BEFORE DELETE`` trigger. The message names the table and holds no value. On Postgres the two
+trigger functions are created before the first table and raise SQLSTATE 23001; on SQLite the
+triggers call ``RAISE(ABORT, ...)``.
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+from sqlalchemy import event
+from sqlalchemy.schema import DDL
+
+from .schema import metadata
+
+__all__ = [
+    "DELETE_PROTECTED_TABLES",
+    "DELETE_TRIGGER_FUNCTION",
+    "UPDATE_TRIGGER_FUNCTION",
+    "delete_trigger_name",
+    "update_trigger_name",
+]
+
+UPDATE_TRIGGER_FUNCTION = "tracer_reject_update"
+DELETE_TRIGGER_FUNCTION = "tracer_reject_delete"
+DELETE_PROTECTED_TABLES = ("deletion_audit",)
+
+
+def update_trigger_name(table: str) -> str:
+    return f"trg_{table}_no_update"
+
+
+def delete_trigger_name(table: str) -> str:
+    return f"trg_{table}_no_delete"
+
+
+def _function_ddl(name: str, verb: str) -> DDL:
+    return DDL(
+        f"CREATE OR REPLACE FUNCTION {name}() RETURNS trigger LANGUAGE plpgsql AS $$ "
+        f"BEGIN RAISE EXCEPTION USING MESSAGE = 'table ' || TG_TABLE_NAME || ' is immutable: "
+        f"{verb} refused', ERRCODE = '23001'; END; $$"
+    ).execute_if(dialect="postgresql")
+
+
+event.listen(metadata, "before_create", _function_ddl(UPDATE_TRIGGER_FUNCTION, "UPDATE"))
+event.listen(metadata, "before_create", _function_ddl(DELETE_TRIGGER_FUNCTION, "DELETE"))
+
+
+def _attach(table: sa.Table) -> None:
+    name, upd = table.name, update_trigger_name(table.name)
+    event.listen(
+        table,
+        "after_create",
+        DDL(
+            f"CREATE TRIGGER {upd} BEFORE UPDATE ON {name} BEGIN "
+            f"SELECT RAISE(ABORT, 'table {name} is immutable: UPDATE refused'); END"
+        ).execute_if(dialect="sqlite"),
+    )
+    event.listen(
+        table,
+        "after_create",
+        DDL(
+            f"CREATE TRIGGER {upd} BEFORE UPDATE ON {name} FOR EACH ROW "
+            f"EXECUTE FUNCTION {UPDATE_TRIGGER_FUNCTION}()"
+        ).execute_if(dialect="postgresql"),
+    )
+    if name in DELETE_PROTECTED_TABLES:
+        dele = delete_trigger_name(name)
+        event.listen(
+            table,
+            "after_create",
+            DDL(
+                f"CREATE TRIGGER {dele} BEFORE DELETE ON {name} BEGIN "
+                f"SELECT RAISE(ABORT, 'table {name} is immutable: DELETE refused'); END"
+            ).execute_if(dialect="sqlite"),
+        )
+        event.listen(
+            table,
+            "after_create",
+            DDL(
+                f"CREATE TRIGGER {dele} BEFORE DELETE ON {name} FOR EACH ROW "
+                f"EXECUTE FUNCTION {DELETE_TRIGGER_FUNCTION}()"
+            ).execute_if(dialect="postgresql"),
+        )
+
+
+for _table in metadata.tables.values():
+    _attach(_table)
