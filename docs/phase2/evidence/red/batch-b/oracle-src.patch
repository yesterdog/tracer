diff -ruN a/tracer_evaldb/codecs.py b/tracer_evaldb/codecs.py
--- a/packages/evaldb/src/tracer_evaldb/codecs.py	1970-01-01 05:30:00
+++ b/packages/evaldb/src/tracer_evaldb/codecs.py	2026-10-24 14:13:40
@@ -0,0 +1,401 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""ORACLE (scratch, qa): the codecs of the batch B contract, hand-written and minimal."""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+from decimal import Decimal
+from typing import Any
+
+from tracer_evalschema import digest as ev_digest
+from tracer_evalschema import loader as ev_loader
+from tracer_evalschema import registry
+from tracer_evalschema.errors import DigestMismatch, NonIJsonValueError
+
+from .errors import StoreError, StoreIntegrityError, StoreValueOutOfRange
+from .tables import ENTITY_TABLES, NULLABLE, PRIV, SPEC, VERSIONED  # noqa: F401
+
+__all__ = ["EncodedEntity", "decode", "encode"]
+
+_INT64 = (-(2**63), 2**63 - 1)
+_CLASSES = {c.__name__: c for c in registry.entity_classes().values()}
+_ENVELOPE = {"id", "schema_version", "created_at", "metadata", "metadata_flags"}
+_STORAGE_RUN_ID = {"artifact", "transcript", "turn", "exchange", "tool_call_event", "stage_span",
+                   "metric_result", "run_verdict", "cost_record", "cost_summary"}  # fmt: skip
+_BIGINT_COLUMNS = {"version", "seq", "index", "start_ms", "byte_length", "required_total",
+                   "failed", "not_applicable", "errored", "passed"}  # fmt: skip
+_BUNDLE_KINDS = (
+    ("run", "run", False), ("snapshot", "snapshot", False),
+    ("pricing_catalog", "pricing_catalogs", True), ("test_profile", "test_profiles", True),
+    ("artifact", "artifacts", False), ("transcript", "transcripts", False),
+    ("turn", "turns", False), ("exchange", "exchanges", False),
+    ("tool_call", "tool_calls", False), ("span", "spans", False),
+    ("result", "results", False), ("verdict", "verdict", False),
+    ("usage_record", "usage_records", False), ("cost_record", "cost_records", False),
+    ("cost_summary", "cost_summaries", False),
+)  # fmt: skip
+
+
+@dataclass(frozen=True)
+class EncodedEntity:
+    table: str
+    row: Mapping[str, Any]
+    side_rows: Mapping[str, Sequence[Mapping[str, Any]]]
+
+
+def _priv(marker: Any, prefix: str) -> dict[str, Any]:
+    names = [f"{prefix}{p}" for p in PRIV]
+    if marker is None:
+        return dict.fromkeys(names)
+    consent, ret = marker.consent, marker.retention
+    values = (
+        marker.human_subject,
+        marker.human_subject_reason,
+        None if consent is None else consent.status,
+        None if ret is None else ret.retain_until,
+        None if ret is None else ret.delete_on_expiry,
+        None if ret is None else ret.policy_ref,
+    )
+    return dict(zip(names, values, strict=True))
+
+
+def _ref(ref: Any) -> tuple[Any, Any]:
+    return (None, None) if ref is None else (ref.id.uuid, ref.version)
+
+
+def _money(m: Any) -> tuple[Any, Any]:
+    return (None, None) if m is None else (Decimal(m.amount), m.currency)
+
+
+def _projection(table: str, m: Any, run_id: uuid.UUID | None) -> dict[str, Any]:
+    if table == "agent_target":
+        return {"transport": m.endpoint.transport}
+    if table == "persona":
+        return {"language": m.language}
+    if table == "evaluator":
+        tp = _ref(m.test_profile)
+        return {"persona_id": m.persona.id.uuid, "persona_version": m.persona.version,
+                "test_profile_id": tp[0], "test_profile_version": tp[1]}  # fmt: skip
+    if table == "metric_definition":
+        return {"key": m.key, "kind": m.kind, "value_type": m.value_type}
+    if table == "metric_binding":
+        return {"evaluator_id": m.evaluator_id.uuid, "metric_id": m.metric.id.uuid,
+                "metric_version": m.metric.version}  # fmt: skip
+    if table == "project":
+        return {"name": m.name}
+    if table == "config_snapshot":
+        pc = _ref(m.pricing_catalog)
+        return {
+            "content_digest_scheme": m.content_digest.scheme,
+            "content_digest_value": bytes.fromhex(m.content_digest.value),
+            "evaluator_id": m.evaluator.id.uuid, "evaluator_version": m.evaluator.version,
+            "rubric_id": m.rubric.id.uuid, "rubric_version": m.rubric.version,
+            "pricing_catalog_id": pc[0], "pricing_catalog_version": pc[1],
+        }  # fmt: skip
+    if table == "run":
+        marker = None if m.caller_external_id is None else m.caller_external_id.privacy
+        return {
+            "project_id": m.project_id.uuid, "config_snapshot_id": m.config_snapshot_id.uuid,
+            "agent_target_id": m.agent_target.id.uuid, "agent_target_version": m.agent_target.version,
+            "mode": m.mode, "caller_origin": m.caller_origin, "observed_tier": m.observed_tier,
+            "started_at": m.started_at, **_priv(marker, "caller_"),
+        }  # fmt: skip
+    if table == "artifact":
+        return {"run_id": run_id, "sha256": bytes.fromhex(m.sha256),
+                "turn_ref": None if m.turn_ref is None else m.turn_ref.uuid,
+                **_priv(m.privacy, "")}  # fmt: skip
+    if table == "transcript":
+        return {"run_id": run_id, "source": m.source, "detected_language": m.detected_language,
+                **_priv(m.privacy, "")}  # fmt: skip
+    if table == "turn":
+        return {"run_id": run_id, "transcript_id": m.transcript_id.uuid, "seq": m.seq,
+                "role": m.role, "start_ms": m.start_ms}  # fmt: skip
+    if table == "exchange":
+        return {"run_id": run_id, "index": m.index}
+    if table == "tool_call_event":
+        return {"run_id": run_id, "source": m.source}
+    if table == "stage_span":
+        return {"run_id": run_id, "stage": m.stage}
+    if table == "metric_result":
+        return {"run_id": run_id, "metric_id": m.metric.id.uuid, "metric_version": m.metric.version,
+                "status": m.status, "na_reason": m.na_reason, "passed": m.passed}  # fmt: skip
+    if table == "run_verdict":
+        return {"run_id": run_id, "status": m.status, "required_total": m.required_total,
+                "passed": m.passed, "failed": m.failed, "not_applicable": m.not_applicable,
+                "errored": m.errored}  # fmt: skip
+    if table == "usage_record":
+        return {"run_id": m.run_id.uuid, "domain": m.domain, "source": m.source,
+                "occurred_at": m.occurred_at}  # fmt: skip
+    if table == "cost_record":
+        a, cur = _money(m.amount)
+        return {"run_id": run_id, "status": m.status, "basis": m.basis, "amount": a,
+                "currency": cur, "na_reason": m.na_reason}  # fmt: skip
+    if table == "cost_summary":
+        t, cur = _money(m.total)
+        return {"run_id": run_id, "completeness": m.completeness, "total": t, "currency": cur}
+    if table == "dataset_item":
+        return {
+            "artifact_id": None if m.artifact_id is None else m.artifact_id.uuid,
+            "transcript_id": None if m.transcript_id is None else m.transcript_id.uuid,
+            "source_run_id": None if m.source_run_id is None else m.source_run_id.uuid,
+            "language": m.language, **_priv(m.privacy, ""),
+        }  # fmt: skip
+    if table == "run_bundle":
+        return {"run_id": m.run.id.uuid}
+    if table == "export_bundle":
+        return {"purpose": m.purpose, "byte_length": len(m.model_dump_json().encode("utf-8"))}
+    return {}
+
+
+def _doc(table: str, m: Any) -> tuple[str, Any]:
+    if table == "run_bundle":
+        return m.model_dump_json(include=_ENVELOPE), m.model_dump(mode="json", include=_ENVELOPE)
+    return m.model_dump_json(), m.model_dump(mode="json")
+
+
+def _row(table: str, m: Any, run_id: uuid.UUID | None) -> dict[str, Any]:
+    text, dump = _doc(table, m)
+    try:
+        sha = bytes.fromhex(ev_digest.sha256_hex(ev_digest.jcs_bytes(dump)))
+    except NonIJsonValueError:
+        # an integer above 2**53 - 1 in a projected column is named; otherwise the document
+        for column, value in _projection(table, m, run_id).items():
+            if type(value) is int and abs(value) > 2**53 - 1:
+                raise StoreValueOutOfRange(table, column) from None
+        if table in VERSIONED and abs(m.version) > 2**53 - 1:
+            raise StoreValueOutOfRange(table, "version") from None
+        raise StoreValueOutOfRange(table, "doc") from None
+    row: dict[str, Any] = {
+        "id": m.id.uuid, "schema_version": m.schema_version, "created_at": m.created_at,
+        "doc": text, "doc_sha256": sha,
+    }  # fmt: skip
+    if table in VERSIONED:
+        row.update(
+            version=m.version, content_digest_scheme=m.content_digest.scheme,
+            content_digest_value=bytes.fromhex(m.content_digest.value),
+        )  # fmt: skip
+    row.update(_projection(table, m, run_id))
+    for column, value in row.items():
+        if type(value) is int and abs(value) > 2**53 - 1:
+            raise StoreValueOutOfRange(table, column)
+    return row
+
+
+def _ref_key(ref: Any) -> bytes:
+    return bytes.fromhex(ev_digest.sha256_hex(ev_digest.jcs_bytes([ref.system, ref.kind, ref.value])))
+
+
+def _external(kind: str, entity: uuid.UUID, refs: Sequence[Any], run_id: uuid.UUID) -> list[dict[str, Any]]:
+    seen: set[bytes] = set()
+    rows = []
+    for ref in refs:
+        key = _ref_key(ref)
+        if key not in seen:
+            seen.add(key)
+            rows.append({"entity_kind": kind, "entity_id": entity, "key_sha256": key,
+                         "run_id": run_id})  # fmt: skip
+    return rows
+
+
+def _side(table: str, m: Any, run_id: uuid.UUID | None) -> dict[str, list[dict[str, Any]]]:
+    if table == "config_snapshot":
+        sid = m.id.uuid
+        members = [("evaluator", 0, m.evaluator), ("persona", 0, m.persona), ("rubric", 0, m.rubric),
+                   *(("metric_definition", i, d) for i, d in enumerate(m.metric_definitions)),
+                   *(("metric_binding", i, b) for i, b in enumerate(m.metric_bindings))]  # fmt: skip
+        tp = m.evaluator.test_profile
+        return {
+            "snapshot_member": [{"snapshot_id": sid, "kind": k, "ordinal": o, "def_id": e.id.uuid,
+                                 "def_version": e.version} for k, o, e in members],  # fmt: skip
+            "snapshot_profile_ref": [] if tp is None else [
+                {"snapshot_id": sid, "profile_id": tp.id.uuid, "profile_version": tp.version}
+            ],
+        }  # fmt: skip
+    if table == "dataset":
+        return {"dataset_member": [{"dataset_id": m.id.uuid, "dataset_version": m.version,
+                                    "ordinal": i, "item_id": x.uuid}
+                                   for i, x in enumerate(m.item_ids)]}  # fmt: skip
+    if table == "run":
+        return {"external_ref_index": _external("run", m.id.uuid, m.external_refs, m.id.uuid)}
+    if table == "stage_span":
+        assert run_id is not None
+        return {"external_ref_index": _external("span", m.id.uuid, [m.span_ref], run_id)}
+    if table == "transcript":
+        assert run_id is not None
+        refs = [] if m.provider_call_ref is None else [m.provider_call_ref]
+        return {"external_ref_index": _external("transcript", m.id.uuid, refs, run_id)}
+    if table == "usage_record":
+        refs = [] if m.provider_call_ref is None else [m.provider_call_ref]
+        return {"external_ref_index": _external("usage_record", m.id.uuid, refs, m.run_id.uuid)}
+    if table == "run_bundle":
+        bid = m.id.uuid
+        members = []
+        for kind, name, versioned in _BUNDLE_KINDS:
+            value = getattr(m, name)
+            records = [] if value is None else value if isinstance(value, list) else [value]
+            for ordinal, record in enumerate(records):
+                members.append({"bundle_id": bid, "kind": kind, "ordinal": ordinal,
+                                "record_id": record.id.uuid,
+                                "record_version": record.version if versioned else None})  # fmt: skip
+        withheld = [{"bundle_id": bid, "ordinal": i, "kind": w.kind, "record_id": w.record_id.uuid}
+                    for i, w in enumerate(m.withheld)]  # fmt: skip
+        return {"run_bundle_member": members, "run_bundle_withheld": withheld}
+    if table == "export_bundle":
+        eid = m.id.uuid
+        runs = list(dict.fromkeys(rb.run.id.uuid for rb in m.run_bundles))
+        items = list(dict.fromkeys(i.id.uuid for i in m.dataset_items))
+        profiles = list(dict.fromkeys(
+            [p.id.uuid for rb in m.run_bundles for p in rb.test_profiles]
+            + [s.aad_fields.subject_id.uuid for s in m.sealed_payloads
+               if s.aad_fields.payload_type == "test_profile"]
+        ))  # fmt: skip
+        return {
+            "export_bundle_run": [{"export_id": eid, "run_id": r} for r in runs],
+            "export_bundle_item": [{"export_id": eid, "item_id": i} for i in items],
+            "export_bundle_profile": [{"export_id": eid, "profile_id": p} for p in profiles],
+        }  # fmt: skip
+    return {}
+
+
+def _encode(entity: str, model: Any, run_id: uuid.UUID | None) -> EncodedEntity:
+    table = SPEC[entity][0]
+    if not isinstance(model, _CLASSES[entity]):
+        raise TypeError(f"encode_{table} takes a {entity}")
+    if table in _STORAGE_RUN_ID and type(run_id) is not uuid.UUID:
+        raise TypeError("run_id must be a uuid.UUID")
+    return EncodedEntity(table, _row(table, model, run_id), _side(table, model, run_id))
+
+
+def _fail(table: str, column: str | None, row: Mapping[str, Any]) -> StoreIntegrityError:
+    ident = row.get("id")
+    return StoreIntegrityError(table, column=column, entity_id=None if ident is None else str(ident))
+
+
+def _decode(entity: str, row: Mapping[str, Any], *, cls_override: Any = None) -> Any:
+    table = SPEC[entity][0]
+    cls = _CLASSES[entity]
+    try:
+        text = row["doc"]
+        if not isinstance(text, str):
+            raise TypeError
+        if entity == "ExportBundle":
+            model = ev_loader.load_bundle(cls, text)
+        else:
+            model = ev_loader.load_model(cls, text)
+    except DigestMismatch:
+        if table in VERSIONED or table == "config_snapshot":
+            raise
+        raise _fail(table, "doc", row) from None
+    except Exception:
+        raise _fail(table, "doc", row) from None
+    run_id = row.get("run_id") if table in _STORAGE_RUN_ID else None
+    try:
+        expected = _row(table, model, run_id)
+    except StoreError:
+        raise _fail(table, "doc", row) from None
+    order = ["id", "schema_version", "created_at", "doc_sha256", "version", "content_digest_scheme",
+             "content_digest_value"]  # fmt: skip
+    order += [k for k in expected if k not in order and k != "doc"]
+    for column in order:
+        if column not in expected:
+            continue
+        got, want = row.get(column), expected[column]
+        same = got == want and type(got) is type(want)
+        if isinstance(want, Decimal) and isinstance(got, Decimal):
+            same = format(got, "f") == format(want, "f")
+        if not same:
+            raise _fail(table, column, row)
+    return model
+
+
+def encode(model: Any, *, run_id: uuid.UUID | None = None) -> EncodedEntity:
+    entity = type(model).__name__
+    if entity not in SPEC:
+        raise TypeError("not an entity")
+    if SPEC[entity][0] in _STORAGE_RUN_ID:
+        return _encode(entity, model, run_id)
+    if run_id is not None:
+        raise TypeError("this entity takes no run_id")
+    return _encode(entity, model, None)
+
+
+def decode(table: str, row: Mapping[str, Any]) -> Any:
+    entity = next(e for e, (t, _) in SPEC.items() if t == table)
+    if table == "run_bundle":
+        raise TypeError("use decode_run_bundle")
+    return _decode(entity, row)
+
+
+def decode_run_bundle(
+    row: Mapping[str, Any],
+    *,
+    members: Sequence[Mapping[str, Any]],
+    withheld: Sequence[Mapping[str, Any]],
+    resolve: Callable[[str, uuid.UUID, int | None], Any],
+) -> Any:
+    cls = _CLASSES["RunBundle"]
+    try:
+        envelope = ev_loader.loads_strict(row["doc"])
+    except Exception:
+        raise _fail("run_bundle", "doc", row) from None
+    docs: dict[str, list[Any]] = {name: [] for _, name, _ in _BUNDLE_KINDS}
+    for kind, name, _ in _BUNDLE_KINDS:
+        chosen = sorted((m for m in members if m["kind"] == kind), key=lambda m: m["ordinal"])
+        docs[name] = [resolve(kind, m["record_id"], m["record_version"]) for m in chosen]
+    order = sorted(withheld, key=lambda w: w["ordinal"])
+    try:
+        bundle = cls.model_validate(
+            {
+                **envelope,
+                "run": docs["run"][0], "snapshot": docs["snapshot"][0],
+                **{n: v for n, v in docs.items() if n not in ("run", "snapshot", "verdict")},
+                "verdict": docs["verdict"][0] if docs["verdict"] else None,
+                "withheld": [_withheld(w) for w in order],
+            }
+        )
+    except Exception:
+        raise _fail("run_bundle", "doc", row) from None
+    expected = _row("run_bundle", bundle, None)
+    for column in ("id", "schema_version", "created_at", "doc_sha256", "run_id"):
+        if row.get(column) != expected[column]:
+            raise _fail("run_bundle", column, row)
+    return bundle
+
+
+def _withheld(w: Mapping[str, Any]) -> Any:
+    prefix = {"artifact": "art", "transcript": "tsc", "turn": "turn", "exchange": "exc",
+              "tool_call": "tcl", "span": "spn", "result": "res", "usage_record": "use",
+              "cost_record": "cst"}[w["kind"]]  # fmt: skip
+    return {"kind": w["kind"], "record_id": f"{prefix}_{w['record_id']}"}
+
+
+def _make(entity: str, table: str) -> tuple[Callable[..., Any], Callable[..., Any]]:
+    if table in _STORAGE_RUN_ID:
+        def enc(model: Any, *, run_id: uuid.UUID) -> EncodedEntity:
+            return _encode(entity, model, run_id)
+    else:
+        def enc(model: Any) -> EncodedEntity:  # type: ignore[misc]
+            return _encode(entity, model, None)
+
+    def dec(row: Mapping[str, Any]) -> Any:
+        return _decode(entity, row)
+
+    enc.__name__, dec.__name__ = f"encode_{table}", f"decode_{table}"
+    return enc, dec
+
+
+for _entity, (_table, _cols) in SPEC.items():
+    if _table == "run_bundle":
+        def encode_run_bundle(model: Any) -> EncodedEntity:
+            return _encode("RunBundle", model, None)
+
+        globals()["encode_run_bundle"] = encode_run_bundle
+        __all__ += ["encode_run_bundle", "decode_run_bundle"]
+        continue
+    _e, _d = _make(_entity, _table)
+    globals()[f"encode_{_table}"] = _e
+    globals()[f"decode_{_table}"] = _d
+    __all__ += [f"encode_{_table}", f"decode_{_table}"]
