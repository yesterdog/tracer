@@ -0,0 +1,390 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""ORACLE (scratch, qa): the 37 tables of ADR 0019, written by hand for the batch B tests."""
+
+from __future__ import annotations
+
+import json
+from importlib import resources
+from typing import Any
+
+import sqlalchemy as sa
+from sqlalchemy.ext.compiler import compiles
+from sqlalchemy.sql.compiler import SQLCompiler
+from sqlalchemy.sql.elements import ColumnElement
+
+from . import columns as c
+from .schema import metadata
+
+__all__ = ["ENTITY_TABLES", "SIDE_TABLES"]
+
+_TYPES = {
+    "UuidCol": c.UuidCol,
+    "Sha256Col": c.Sha256Col,
+    "InstantCol": c.InstantCol,
+    "DecimalCol": c.DecimalCol,
+    "DocCol": c.DocCol,
+    "KeyCol": c.KeyCol,
+    "BigIntCol": c.BigIntCol,
+    "BoolCol": c.BoolCol,
+}
+_BIGINT = {"version", "seq", "index", "start_ms", "byte_length", "required_total", "failed",
+           "not_applicable", "errored", "ordinal", "singleton"}  # fmt: skip
+
+
+def _logical(table: str, name: str) -> str:
+    if name in ("doc", "counts"):
+        return "DocCol"
+    if name in ("doc_sha256", "sha256", "content_digest_value", "key_sha256"):
+        return "Sha256Col"
+    if name in ("schema_version", "evaldb_version"):
+        return "KeyCol"
+    if name == "passed":
+        return "BoolCol" if table == "metric_result" else "BigIntCol"
+    if name.endswith(("human_subject", "delete_on_expiry")):
+        return "BoolCol"
+    if name == "id" or name.endswith("_id") or name in ("audit_uuid", "turn_ref"):
+        return "UuidCol"
+    if name in _BIGINT or name.endswith("_version"):
+        return "BigIntCol"
+    if name in ("created_at", "started_at", "occurred_at", "deleted_at") or name.endswith(
+        "retain_until"
+    ):
+        return "InstantCol"
+    if name in ("amount", "total"):
+        return "DecimalCol"
+    return "KeyCol"
+
+
+# ------------------------------------------------------------------------------ checks
+
+
+class _PerDialect(ColumnElement[bool]):
+    inherit_cache = False
+    type = sa.Boolean()
+    _traverse_internals: list[Any] = []  # noqa: RUF012
+
+    def __init__(self, sqlite: str, postgresql: str) -> None:
+        self.sqlite = sqlite
+        self.postgresql = postgresql
+
+
+@compiles(_PerDialect, "sqlite")
+def _sqlite(element: _PerDialect, compiler: SQLCompiler, **kw: Any) -> str:
+    return element.sqlite
+
+
+@compiles(_PerDialect, "postgresql")
+def _postgresql(element: _PerDialect, compiler: SQLCompiler, **kw: Any) -> str:
+    return element.postgresql
+
+
+def _check(sql: str, name: str) -> sa.CheckConstraint:
+    return sa.CheckConstraint(sa.text(sql), name=name)
+
+
+def _nonneg(column: str, name: str) -> sa.CheckConstraint:
+    return sa.CheckConstraint(
+        _PerDialect(f"{column} NOT GLOB '-*'", f"{column} >= 0"), name=name
+    )
+
+
+def _schema_enum(file: str, *path: str | int) -> tuple[str, ...]:
+    root = resources.files("tracer_evalschema") / "schemas" / file
+    node: Any = json.loads(root.read_text(encoding="utf-8"))
+    for step in path:
+        node = node[step]
+    return tuple(node["enum"] if isinstance(node, dict) else node)
+
+
+def _prop(file: str, name: str, optional: bool = False) -> tuple[str, ...]:
+    if optional:
+        return _schema_enum(file, "properties", name, "anyOf", 0)
+    return _schema_enum(file, "properties", name)
+
+
+def _sets() -> dict[tuple[str, str], tuple[str, ...]]:
+    s: dict[tuple[str, str], tuple[str, ...]] = {}
+    s["agent_target", "transport"] = tuple(
+        _schema_enum("AgentTarget.schema.json", "$defs", k, "properties", "transport")[0]
+        for k in ("WebSocketEndpoint", "WebRtcEndpoint", "SipEndpoint")
+    )
+    s["metric_definition", "kind"] = _prop("MetricDefinition.schema.json", "kind")
+    s["metric_definition", "value_type"] = _prop("MetricDefinition.schema.json", "value_type")
+    for col in ("mode", "caller_origin", "observed_tier"):
+        s["run", col] = _prop("Run.schema.json", col)
+    s["transcript", "source"] = _prop("Transcript.schema.json", "source")
+    s["tool_call_event", "source"] = _prop("ToolCallEvent.schema.json", "source")
+    s["usage_record", "source"] = _prop("UsageRecord.schema.json", "source")
+    s["usage_record", "domain"] = _prop("UsageRecord.schema.json", "domain")
+    s["turn", "role"] = _prop("Turn.schema.json", "role")
+    s["stage_span", "stage"] = _prop("StageSpan.schema.json", "stage")
+    s["metric_result", "status"] = _prop("MetricResult.schema.json", "status")
+    s["metric_result", "na_reason"] = _prop("MetricResult.schema.json", "na_reason", True)
+    s["run_verdict", "status"] = _prop("RunVerdict.schema.json", "status")
+    s["cost_record", "status"] = _prop("CostRecord.schema.json", "status")
+    s["cost_record", "basis"] = _prop("CostRecord.schema.json", "basis", True)
+    s["cost_record", "na_reason"] = _prop("CostRecord.schema.json", "na_reason", True)
+    usd = _schema_enum("CostRecord.schema.json", "$defs", "Money", "properties", "currency")
+    s["cost_record", "currency"] = usd
+    s["cost_summary", "currency"] = usd
+    s["cost_summary", "completeness"] = _prop("CostSummary.schema.json", "completeness")
+    s["export_bundle", "purpose"] = _prop("ExportBundle.schema.json", "purpose")
+    consent = _schema_enum("Artifact.schema.json", "$defs", "ConsentRecord", "properties", "status")
+    reason = _schema_enum(
+        "Artifact.schema.json", "$defs", "PrivacyMarker", "properties",
+        "human_subject_reason", "anyOf", 0,
+    )  # fmt: skip
+    for t, p in (("artifact", ""), ("transcript", ""), ("dataset_item", ""), ("run", "caller_")):
+        s[t, f"{p}consent_status"] = consent
+        s[t, f"{p}human_subject_reason"] = reason
+    scheme = _schema_enum("Persona.schema.json", "$defs", "ContentDigest", "properties", "scheme")
+    for t in (*VERSIONED, "config_snapshot"):
+        s[t, "content_digest_scheme"] = scheme
+    return s
+
+
+VERSIONED = ("agent_target", "persona", "test_profile", "evaluator", "metric_definition",
+             "metric_binding", "rubric", "pricing_catalog", "dataset")  # fmt: skip
+PRIV = ("human_subject", "human_subject_reason", "consent_status", "retain_until",
+        "delete_on_expiry", "policy_ref")  # fmt: skip
+
+# entity: (table, projected columns, nullable columns)
+SPEC: dict[str, tuple[str, tuple[str, ...]]] = {
+    "AgentTarget": ("agent_target", ("transport",)),
+    "Persona": ("persona", ("language",)),
+    "TestProfile": ("test_profile", ()),
+    "Evaluator": ("evaluator", ("persona_id", "persona_version", "test_profile_id",
+                                "test_profile_version")),  # fmt: skip
+    "MetricDefinition": ("metric_definition", ("key", "kind", "value_type")),
+    "MetricBinding": ("metric_binding", ("evaluator_id", "metric_id", "metric_version")),
+    "Rubric": ("rubric", ()),
+    "PricingCatalog": ("pricing_catalog", ()),
+    "Dataset": ("dataset", ()),
+    "Project": ("project", ("name",)),
+    "ConfigSnapshot": ("config_snapshot", ("content_digest_scheme", "content_digest_value",
+                                           "evaluator_id", "evaluator_version", "rubric_id",
+                                           "rubric_version", "pricing_catalog_id",
+                                           "pricing_catalog_version")),  # fmt: skip
+    "Run": ("run", ("project_id", "config_snapshot_id", "agent_target_id", "agent_target_version",
+                    "mode", "caller_origin", "observed_tier", "started_at",
+                    *(f"caller_{p}" for p in PRIV))),  # fmt: skip
+    "Artifact": ("artifact", ("run_id", "sha256", "turn_ref", *PRIV)),
+    "Transcript": ("transcript", ("run_id", "source", "detected_language", *PRIV)),
+    "Turn": ("turn", ("run_id", "transcript_id", "seq", "role", "start_ms")),
+    "Exchange": ("exchange", ("run_id", "index")),
+    "ToolCallEvent": ("tool_call_event", ("run_id", "source")),
+    "StageSpan": ("stage_span", ("run_id", "stage")),
+    "MetricResult": ("metric_result", ("run_id", "metric_id", "metric_version", "status",
+                                       "na_reason", "passed")),  # fmt: skip
+    "RunVerdict": ("run_verdict", ("run_id", "status", "required_total", "passed", "failed",
+                                   "not_applicable", "errored")),  # fmt: skip
+    "UsageRecord": ("usage_record", ("run_id", "domain", "source", "occurred_at")),
+    "CostRecord": ("cost_record", ("run_id", "status", "basis", "amount", "currency", "na_reason")),
+    "CostSummary": ("cost_summary", ("run_id", "completeness", "total", "currency")),
+    "DatasetItem": ("dataset_item", ("artifact_id", "transcript_id", "source_run_id", "language",
+                                     *PRIV)),  # fmt: skip
+    "RunBundle": ("run_bundle", ("run_id",)),
+    "ExportBundle": ("export_bundle", ("purpose", "byte_length")),
+}
+NULLABLE: dict[str, set[str]] = {
+    "evaluator": {"test_profile_id", "test_profile_version"},
+    "config_snapshot": {"pricing_catalog_id", "pricing_catalog_version"},
+    "run": {"started_at", *(f"caller_{p}" for p in PRIV)},
+    "artifact": {"turn_ref", *PRIV[1:]},
+    "transcript": {"detected_language", *PRIV[1:]},
+    "turn": {"start_ms"},
+    "metric_result": {"na_reason", "passed"},
+    "usage_record": {"occurred_at"},
+    "cost_record": {"amount", "basis", "currency", "na_reason"},
+    "cost_summary": {"total", "currency"},
+    "dataset_item": {"artifact_id", "transcript_id", "source_run_id", *PRIV},
+    "run_bundle_member": {"record_version"},
+}
+RUN_FK = {"artifact", "transcript", "turn", "exchange", "tool_call_event", "stage_span",
+          "metric_result", "run_verdict", "usage_record", "cost_record", "cost_summary",
+          "run_bundle"}  # fmt: skip
+SETS = _sets()
+
+
+def _columns(table: str, names: tuple[str, ...]) -> list[sa.Column[Any]]:
+    result: list[sa.Column[Any]] = []
+    for name in names:
+        kind = _TYPES[_logical(table, name)]
+        fks: list[sa.ForeignKey] = []
+        if name == "run_id" and table in RUN_FK:
+            fks.append(sa.ForeignKey("run.id", ondelete="CASCADE"))
+        result.append(
+            sa.Column(name, kind(), *fks, nullable=name in NULLABLE.get(table, set()))
+        )
+    return result
+
+
+def _privacy_check(table: str, prefix: str) -> sa.CheckConstraint:
+    hs, reason, consent, retain, doe, policy = (f"{prefix}{p}" for p in PRIV)
+    none = " AND ".join(f"{x} IS NULL" for x in (reason, consent, retain, doe, policy))
+    sql = (
+        f"({hs} IS NULL AND {none}) OR "
+        f"({hs} IS TRUE AND {consent} IS NOT NULL AND {doe} IS NOT NULL) OR "
+        f"({hs} IS FALSE AND {none})"
+    )
+    return _check(sql, f"{prefix}privacy_projection")
+
+
+def _sets_for(table: str, names: tuple[str, ...]) -> list[sa.CheckConstraint]:
+    out = []
+    for name in names:
+        members = SETS.get((table, name))
+        if members is not None:
+            listing = ", ".join("'" + m.replace("'", "''") + "'" for m in members)
+            out.append(_check(f"{name} IN ({listing})", f"{name}_closed"))
+    return out
+
+
+def _entity_table(entity: str) -> sa.Table:
+    table, projected = SPEC[entity]
+    versioned = table in VERSIONED
+    names = ("id", *(("version",) if versioned else ()), "schema_version", "created_at", "doc",
+             "doc_sha256", *(("content_digest_scheme", "content_digest_value") if versioned else ()),
+             *projected)  # fmt: skip
+    items: list[Any] = [*_columns(table, names)]
+    items.append(sa.PrimaryKeyConstraint("id", "version") if versioned else sa.PrimaryKeyConstraint("id"))
+    items.append(_check("schema_version = '0.0.1'", "schema_version_pinned"))
+    if versioned:
+        items.append(_check("version >= 1", "version_ge_1"))
+    items += _sets_for(table, names)
+    if table == "run":
+        items.append(sa.ForeignKeyConstraint(["project_id"], ["project.id"], ondelete="CASCADE"))
+        items.append(
+            sa.ForeignKeyConstraint(["config_snapshot_id"], ["config_snapshot.id"], ondelete="RESTRICT")
+        )
+        items.append(_privacy_check(table, "caller_"))
+    if table in ("artifact", "transcript", "dataset_item"):
+        items.append(_privacy_check(table, ""))
+    if table == "turn":
+        items.append(sa.UniqueConstraint("transcript_id", "seq"))
+    if table == "metric_result":
+        items.append(_check("status <> 'not_applicable' OR passed IS NULL", "na_has_null_passed"))
+    if table == "cost_record":
+        items.append(_nonneg("amount", "amount_non_negative"))
+        items.append(
+            _check(
+                "status <> 'not_available' OR (amount IS NULL AND basis IS NULL AND currency IS NULL)",
+                "not_available_is_empty",
+            )
+        )
+        items.append(_check("(amount IS NULL) = (currency IS NULL)", "currency_with_amount"))
+    if table == "cost_summary":
+        items.append(_nonneg("total", "total_non_negative"))
+        items.append(_check("(total IS NULL) = (currency IS NULL)", "currency_with_total"))
+    if table == "evaluator":
+        items.append(_check("(test_profile_id IS NULL) = (test_profile_version IS NULL)", "profile_pair"))
+    if table == "config_snapshot":
+        items.append(
+            _check("(pricing_catalog_id IS NULL) = (pricing_catalog_version IS NULL)", "catalog_pair")
+        )
+    return sa.Table(table, metadata, *items, sqlite_strict=True, sqlite_with_rowid=False)
+
+
+def _side(
+    name: str,
+    cols: tuple[str, ...],
+    pk: tuple[str, ...],
+    *extra: Any,
+    nullable: tuple[str, ...] = (),
+) -> sa.Table:
+    NULLABLE.setdefault(name, set()).update(nullable)
+    items: list[Any] = [*_columns(name, cols), sa.PrimaryKeyConstraint(*pk), *extra]
+    return sa.Table(name, metadata, *items, sqlite_strict=True, sqlite_with_rowid=False)
+
+
+def _in(column: str, members: tuple[str, ...], label: str) -> sa.CheckConstraint:
+    listing = ", ".join(f"'{m}'" for m in members)
+    return _check(f"{column} IN ({listing})", label)
+
+
+_ENTITY: dict[str, sa.Table] = {e: _entity_table(e) for e in SPEC}
+
+_MEMBER_KINDS = ("run", "snapshot", "pricing_catalog", "test_profile", "artifact", "transcript",
