+class StoreIntegrityError(StoreError):
+    """A stored row fails a check against its own document. Names the table, the column and the
+    ID, never a value."""
+
+    def __init__(self, table: str, *, column: str | None = None, entity_id: str | None = None):
+        self.table = table
+        self.column = column
+        self.entity_id = entity_id
+        text = f"stored row of table {table!r} failed an integrity check"
+        if column is not None:
+            text += f" (column {column!r})"
+        if entity_id is not None:
+            text += f" (id {entity_id})"
+        super().__init__(text)
+
+
+class StoreValueOutOfRange(StoreError, ValueError):
+    """A value does not fit the 64-bit column it is projected to. Names the table and column."""
+
+    def __init__(self, table: str, column: str):
+        self.table = table
+        self.column = column
+        super().__init__(f"a value for column {column!r} of table {table!r} is outside 64 bits")
