 from sqlalchemy.types import TypeDecorator, TypeEngine
 
 __all__ = [
+    "BigIntCol",
     "BoolCol",
     "DecimalCol",
     "DocCol",
@@ -68,6 +69,14 @@
     """The value is a boolean (SQLite stores 0 or 1)."""
 
 
+class _InstantShape(_CheckElement):
+    """SQLite: the fixed-width instant text. Postgres: nothing to check."""
+
+
+class _DecimalShape(_CheckElement):
+    """SQLite: plain decimal text. Postgres: nothing to check."""
+
+
 @compiles(_UuidV7, "sqlite")
 def _uuid_v7_sqlite(element: _UuidV7, compiler: SQLCompiler, **kw: Any) -> str:
     col = compiler.process(element.column, **kw)
@@ -100,6 +109,40 @@
     return f"{compiler.process(element.column, **kw)} IN (TRUE, FALSE)"
 
 
+_DIGITS = "[0-9]"
+_INSTANT_GLOB = (
+    f"{_DIGITS * 4}-[0-1]{_DIGITS}-[0-3]{_DIGITS}T[0-2]{_DIGITS}:[0-5]{_DIGITS}:[0-5]{_DIGITS}."
+    f"{_DIGITS * 6}Z"
+)
+
+
+@compiles(_InstantShape, "sqlite")
+def _instant_sqlite(element: _InstantShape, compiler: SQLCompiler, **kw: Any) -> str:
+    col = compiler.process(element.column, **kw)
+    return f"({col} IS NULL OR (length({col}) = 27 AND {col} GLOB '{_INSTANT_GLOB}'))"
+
+
+@compiles(_InstantShape, "postgresql")
+def _instant_postgresql(element: _InstantShape, compiler: SQLCompiler, **kw: Any) -> str:
+    return "TRUE"
+
+
+@compiles(_DecimalShape, "sqlite")
+def _decimal_sqlite(element: _DecimalShape, compiler: SQLCompiler, **kw: Any) -> str:
+    c = compiler.process(element.column, **kw)
+    return (
+        f"({c} IS NULL OR (length({c}) > 0 AND ({c} GLOB '[0-9]*' OR {c} GLOB '-[0-9]*') "
