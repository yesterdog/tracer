            {"role": "tool_call", "name": "book", "arguments": {"n": 1}, "cancelled": True},
            {"role": "tool_call", "name": "book", "arguments": {"n": 2}, "cancelled": False},
            {"role": "tool_call", "name": "book", "arguments": {"n": 3}},
