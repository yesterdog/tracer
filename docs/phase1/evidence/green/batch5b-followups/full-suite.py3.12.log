            llm_span([("input", first)], span_id="b1b1b1b1b1b1b1b1", start_ns=1_792_757_168_100_000_000),
            llm_span([("input", second)], span_id="b2b2b2b2b2b2b2b2", start_ns=1_792_757_168_200_000_000),
            llm_span([("input", conflicting)], span_id="b3b3b3b3b3b3b3b3", start_ns=1_792_757_168_300_000_000),
        )
