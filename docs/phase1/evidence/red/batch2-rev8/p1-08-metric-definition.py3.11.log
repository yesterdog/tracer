    def test_per_turn_share_bounds_0_1() -> None:
        """P-58 (ADR 0010 I7): for a ``per_turn_share`` definition the pass rule is a range whose
        bounds lie in [0, 1] (the share is a fraction); other definitions are not bounded."""
        for good in (
            {"min": 0.8},
            {"min": 0},
            {"min": 1},
            {"max": 1},
            {"min": 0.25, "max": 0.75},
            {"min": 0, "max": 1},
        ):
