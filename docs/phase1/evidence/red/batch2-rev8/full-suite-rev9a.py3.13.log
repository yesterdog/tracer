        docs = {
            "boolean": judge_definition(),
            "numeric": latency_definition(),
            "rating": _rating(),
            "enum": _enum(),
        }
        fits = {"boolean": "equals_true", "numeric": "range", "rating": "range", "enum": "one_of"}
        for value_type, doc in docs.items():
