                ("gen_ai.provider.name", "kokoro"),
                ("gen_ai.request.model", placeholder),
                ("text", "Hello"),
                ("metrics.character_count", 5),
            ],
        )
        doc = doc_of(tts)
        result = run_f1(doc)
        assert [s.model for s in result.stage_spans] == [None]
