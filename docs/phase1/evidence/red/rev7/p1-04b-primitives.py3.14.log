            ("0", 0, "0"),
            ("1.5", 4, "1.5000"),
            ("7", 0, "7"),
            ("0.000000000000000001", 18, "0.000000000000000001"),
            ("0.000000000000000001", 2, "0.00"),
            ("1000000", 2, "1000000.00"),
