    def test_cost_record_shape_and_enums() -> None:
        """Proposed name (ADR 0014 Decision 12, ADR 0003 Decision 1): a cost record is an entity
        (``cst``) with exactly the entity fields plus ``domain``, ``usage_record_ids``, ``status``,
