+def _not_applicable_turns(
+    definition: MetricDefinition, run: Run, turns: Sequence[Turn], transcripts: Sequence[Transcript]
+) -> int:
+    return sum(
+        1
+        for turn in turns
+        if applicability(definition, run, turns=[turn], transcripts=transcripts).na_reason
+        is not None
+    )
+
+
+def _compare_counts(
+    position: int,
+    result: MetricResult,
+    definition: MetricDefinition,
+    run: Run,
+    turns: Sequence[Turn],
+    transcripts: Sequence[Transcript],
+) -> None:
+    summary = result.per_turn
+    if summary is None:
+        return
+    if summary.total_turns != len(turns):
+        raise _applicability_error(position, result, "per_turn.total_turns")
+    if summary.counts.not_applicable != _not_applicable_turns(definition, run, turns, transcripts):
+        raise _applicability_error(position, result, "per_turn.counts.not_applicable")
 
 
