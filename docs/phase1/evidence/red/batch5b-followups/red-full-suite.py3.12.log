            _plain_digest_doc(key_ref=dict(DIGEST_KEY_REF)),
            _keyed_digest_doc(value="A" * 64),
            _keyed_digest_doc(value="0" * 63),
            _keyed_digest_doc(extra="x"),
            "a" * 64,
            1,
            {},
            [],
        ]
        for bad in shapes:
