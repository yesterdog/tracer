diff --git a/packages/evalcore/src/tracer_evalcore/_engine_errors.py b/packages/evalcore/src/tracer_evalcore/_engine_errors.py
new file mode 100644
index 0000000..d309580
--- /dev/null
+++ b/packages/evalcore/src/tracer_evalcore/_engine_errors.py
@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""Facts-only error base of the TTS and LLM engine boundaries (ADR 0026 rule 4).
+
+An error holds machine facts, never a provider message, a body, a header, a key or text: every
+fact is validated against a fixed shape, and a value that does not fit is refused without being
+quoted.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Final
+
+from tracer_evalcore.errors import EvalcoreError
+
+__all__ = ["FactError"]
+
+_CODE: Final = re.compile(r"[a-z][a-z0-9_]{0,63}")
+_REQUEST_ID: Final = re.compile(r"[A-Za-z0-9_.:-]{1,128}")
+
+
+def _is_int(value: object) -> bool:
+    return type(value) is int
+
+
+class FactError(EvalcoreError):
+    """Base of the engine errors; the facts are keyword-only attributes."""
+
+    def __init__(
+        self,
+        *,
+        index: int | None = None,
+        status: int | None = None,
+        kind: str | None = None,
+        code: str | None = None,
+        request_id: str | None = None,
+        attempts: int | None = None,
+        reason: str | None = None,
+    ) -> None:
+        if index is not None and not (_is_int(index) and index >= 0):
+            raise ValueError("index: not a non-negative integer")
+        if status is not None and not (_is_int(status) and 100 <= status <= 599):
+            raise ValueError("status: not an HTTP status")
+        if attempts is not None and not (_is_int(attempts) and attempts >= 1):
+            raise ValueError("attempts: not a positive integer")
+        for name, value in (("kind", kind), ("code", code), ("reason", reason)):
+            if value is not None and not (type(value) is str and _CODE.fullmatch(value)):
+                raise ValueError(f"{name}: not a short machine code")
+        if request_id is not None and not (
+            type(request_id) is str and _REQUEST_ID.fullmatch(request_id)
+        ):
+            raise ValueError("request_id: not a request identifier")
+        self.index = index
+        self.status = status
+        self.kind = kind
+        self.code = code
+        self.request_id = request_id
+        self.attempts = attempts
+        self.reason = reason
+        parts: list[str] = []
+        if index is not None:
+            parts.append(f"request {index}")
+        if status is not None:
+            parts.append(f"HTTP {status}")
+        if kind is not None:
+            parts.append(f"transport {kind}")
+        if code is not None:
+            parts.append(f"code {code}")
+        if reason is not None:
+            parts.append(f"reason {reason}")
+        if request_id is not None:
+            parts.append(f"request id {request_id}")
+        if attempts is not None:
+            parts.append(f"{attempts} attempt(s)")
+        super().__init__(f"{type(self).__name__}: " + ", ".join(parts) if parts else "")
+
+    def __reduce__(self) -> tuple[Any, ...]:
+        return (_rebuild, (type(self), dict(self.__dict__)))
+
+
+def _rebuild(cls: type[FactError], facts: dict[str, Any]) -> FactError:
+    return cls(**facts)
diff --git a/packages/evalcore/src/tracer_evalcore/brain.py b/packages/evalcore/src/tracer_evalcore/brain.py
new file mode 100644
index 0000000..430f505
--- /dev/null
+++ b/packages/evalcore/src/tracer_evalcore/brain.py
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The caller brain boundary (ADR 0026 rule 4, ADR 0028 rule 1): scripted, LLM or replay."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Final, Protocol, runtime_checkable
+
+from tracer_evalcore.simtypes import CALLER_MODES, MAX_LINE_CHARS
+
+__all__ = [
+    "BRAIN_END_REASONS",
+    "BrainDecision",
+    "CallerBrain",
+    "require_caller_brain",
+]
+
+BRAIN_END_REASONS: Final = (
+    "script_complete",
+    "caller_end_call",
+    "max_turns",
+    "brain_invalid_output",
+    "spend_cap",
+)
+
+
+@dataclass(frozen=True)
+class BrainDecision:
+    """The next caller line, or the end of the call with one of the brain's end reasons."""
+
+    line: str | None
+    end_reason: str | None
+    invalid_outputs: int
+    regenerations: int
+
+    def __post_init__(self) -> None:
+        if (self.line is None) == (self.end_reason is None):
+            raise ValueError("a decision holds a line or an end reason, exactly one")
+        if self.line is not None and (
+            type(self.line) is not str or not 1 <= len(self.line) <= MAX_LINE_CHARS
+        ):
+            raise ValueError("line: empty or longer than the limit")
+        if self.end_reason is not None and self.end_reason not in BRAIN_END_REASONS:
+            raise ValueError("end_reason: not one of the brain's")
+        for name, value in (("invalid_outputs", self.invalid_outputs),
+                            ("regenerations", self.regenerations)):  # fmt: skip
+            if type(value) is not int or value < 0:
+                raise ValueError(f"{name}: not a non-negative integer")
+        if self.regenerations > self.invalid_outputs:
+            raise ValueError("regenerations: more than invalid outputs")
+
+
+@runtime_checkable
+class CallerBrain(Protocol):
+    """What decides the next caller line; ``mode`` is one of ``CALLER_MODES``."""
+
+    mode: str
+
+    def next_line(self, turn_index: int, agent_text: str | None) -> BrainDecision: ...
+
+
+def require_caller_brain(candidate: object) -> CallerBrain:
+    """Return the candidate when it is a brain of a known mode, else refuse it."""
+    if not isinstance(candidate, CallerBrain):
+        raise TypeError("not a caller brain")
+    if candidate.mode not in CALLER_MODES:
+        raise ValueError("mode: not one of the caller modes")
+    return candidate
diff --git a/packages/evalcore/src/tracer_evalcore/llm.py b/packages/evalcore/src/tracer_evalcore/llm.py
new file mode 100644
index 0000000..24a8213
--- /dev/null
+++ b/packages/evalcore/src/tracer_evalcore/llm.py
@@ -0,0 +1,188 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The language-model engine boundary (ADR 0026 rule 4, ADR 0024 amendment A3, ADR 0028).
+
+The shape of the speech-to-text boundary. A request is fully explicit: a model, ``max_tokens``,
+a seed (or ``None``) and a reasoning effort (or ``None``) have no default.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Final, Protocol, runtime_checkable
+
+from tracer_evalcore._engine_errors import FactError
+from tracer_evalcore.stt import UsageSink
+from tracer_evalschema.ids import RunId
+from tracer_evalschema.usage import UsageRecord
+
+__all__ = [
+    "LLM_ROLES",
+    "LlmAuthError",
+    "LlmCapReachedError",
+    "LlmConfigurationError",
+    "LlmContext",
+    "LlmEngine",
+    "LlmError",
+    "LlmKeyMissingError",
+    "LlmMessage",
+    "LlmOutcome",
+    "LlmRateLimited",
+    "LlmRequest",
+    "LlmRequestRejected",
+    "LlmResponseInvalid",
+    "LlmServerError",
+    "LlmTransportError",
+    "UsageSink",
+    "UsageStreamingLlmEngine",
+    "complete_once",
+]
+
+LLM_ROLES: Final = ("system", "user", "assistant")
+_NAME: Final = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,63}")
+_EFFORT: Final = re.compile(r"[a-z][a-z0-9_]{0,31}")
+_MAX_SAFE: Final = 2**53 - 1
+
+
+class LlmError(FactError):
+    """Base of every language-model failure."""
+
+
+class LlmAuthError(LlmError):
+    """HTTP 401 or 403, or the provider's invalid-key code. Never retried."""
+
+
+class LlmRequestRejected(LlmError):
+    """Any other 4xx except 429. Never retried."""
+
+
+class LlmRateLimited(LlmError):
+    """429 after the last attempt."""
+
+
+class LlmServerError(LlmError):
+    """5xx after the last attempt."""
+
+
+class LlmTransportError(LlmError):
+    """A connect, read or write error or a timeout after the last attempt."""
+
+
+class LlmResponseInvalid(LlmError):
+    """A response that is not the documented success shape. Never retried."""
+
+
+class LlmCapReachedError(LlmError):
+    """The request would cross a spend cap; it was not sent."""
+
+
+class LlmConfigurationError(LlmError, ValueError):
+    """The run is configured so that no request may be sent."""
+
+
+class LlmKeyMissingError(LlmConfigurationError):
+    """The API key is missing, empty or unusable."""
+
+
+@dataclass(frozen=True)
+class LlmMessage:
+    role: str
+    content: str
+
+    def __post_init__(self) -> None:
+        if self.role not in LLM_ROLES:
+            raise ValueError("role: not an accepted value")
+        if type(self.content) is not str or not self.content:
+            raise ValueError("content: empty")
+
+
+@dataclass(frozen=True)
+class LlmRequest:
+    """One request; no field has a default (ADR 0026 rule 12, ADR 0028 rule 5)."""
+
+    index: int
+    messages: tuple[LlmMessage, ...]
+    model: str
+    max_tokens: int
+    seed: int | None
+    reasoning_effort: str | None
+
+    def __post_init__(self) -> None:
+        if type(self.index) is not int or self.index < 0:
+            raise ValueError("index: not a non-negative integer")
+        if type(self.messages) is not tuple or not self.messages:
+            raise ValueError("messages: not a non-empty tuple")
+        if not all(isinstance(m, LlmMessage) for m in self.messages):
+            raise TypeError("messages: not LlmMessage records")
+        if type(self.model) is not str or not _NAME.fullmatch(self.model):
+            raise ValueError("model: not an accepted value")
+        if type(self.max_tokens) is not int or not 1 <= self.max_tokens <= _MAX_SAFE:
+            raise ValueError("max_tokens: outside 1 to 2**53 - 1")
+        if self.seed is not None and (
+            type(self.seed) is not int or not 0 <= self.seed <= _MAX_SAFE
+        ):
+            raise ValueError("seed: not a non-negative integer or None")
+        if self.reasoning_effort is not None and (
+            type(self.reasoning_effort) is not str or not _EFFORT.fullmatch(self.reasoning_effort)
+        ):
+            raise ValueError("reasoning_effort: not an accepted value or None")
+
+
+@dataclass(frozen=True)
+class LlmContext:
+    run_id: RunId
+    created_at: datetime
+
+
+@dataclass(frozen=True)
+class LlmOutcome:
+    """A reply text or a failure, never both; ``usage`` holds one record per answered request."""
+
+    text: str | None
+    usage: tuple[UsageRecord, ...]
+    failure: LlmError | None
+
+    def __post_init__(self) -> None:
+        if (self.text is None) == (self.failure is None):
+            raise ValueError("an outcome holds a text or a failure, exactly one")
+        for record in self.usage:
+            if not isinstance(record, UsageRecord):
+                raise TypeError("usage: not a UsageRecord")
+            if record.stage != "sim_caller_llm" or record.domain != "evaluation":
+                raise ValueError("usage: not a sim_caller_llm record of the evaluation domain")
+
+
+@runtime_checkable
+class LlmEngine(Protocol):
+    """One request in, a typed outcome out."""
+
+    def complete(self, request: LlmRequest, context: LlmContext) -> LlmOutcome: ...
+
+
+@runtime_checkable
+class UsageStreamingLlmEngine(Protocol):
+    """An engine that hands out the usage of each answered request before it returns."""
+
+    streams_usage: bool
+
+    def complete(
+        self, request: LlmRequest, context: LlmContext, *, on_usage: UsageSink | None = None
+    ) -> LlmOutcome: ...
+
+
+def complete_once(
+    engine: LlmEngine | UsageStreamingLlmEngine,
+    request: LlmRequest,
+    context: LlmContext,
+    *,
+    on_usage: UsageSink,
+) -> LlmOutcome:
+    """Send one request; its usage reaches ``on_usage`` before this function returns."""
+    if isinstance(engine, UsageStreamingLlmEngine) and engine.streams_usage is True:
+        return engine.complete(request, context, on_usage=on_usage)
+    outcome = engine.complete(request, context)
+    for record in outcome.usage:
+        on_usage(record)
+    return outcome
