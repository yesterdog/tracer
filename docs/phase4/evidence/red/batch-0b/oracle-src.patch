+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+[project]
+name = "tracer-samplebot"
+version = "0.0.0"
+description = "Pipecat sample agents for the loopback interop tests (not published, never imported by a tracer package)."
+readme = "README.md"
+requires-python = ">=3.11"
+license = "Apache-2.0"
+dependencies = [
+    "pipecat-ai[websocket,runner,webrtc]==1.14.0",
+]
+
+[tool.uv]
+package = false
