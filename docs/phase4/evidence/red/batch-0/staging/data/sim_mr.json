    {
      "id": "sim-mr-s3",
      "title": "complaint and thanks",
      "provenance": "synthetic_hand_written",
      "needs_native_review": true,
      "persona": {"language": "mr", "accent": null},
      "scripted_turns": [
        {"index": 0, "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u092e\u0932\u093e \u090f\u0915 \u0924\u0915\u094d\u0930\u093e\u0930 \u0928\u094b\u0902\u0926\u0935\u093e\u092f\u091a\u0940 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 1, "text": "\u092e\u093e\u091d\u0947 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u093e\u0932\u092a\u093e\u0938\u0942\u0928 \u092c\u0902\u0926 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 2, "text": "\u092e\u0940 \u0926\u094b\u0928 \u0935\u0947\u0933\u093e \u092b\u094b\u0928 \u0915\u0947\u0932\u093e, \u092a\u0923 \u0915\u094b\u0923\u0940 \u0909\u0924\u094d\u0924\u0930 \u0926\u093f\u0932\u0947 \u0928\u093e\u0939\u0940.", "language": "mr"},
        {"index": 3, "text": "\u092e\u093e\u091d\u093e \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 9876543210 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 4, "text": "\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0927\u0940\u092a\u0930\u094d\u092f\u0902\u0924 \u0938\u0941\u091f\u0947\u0932?", "language": "mr"},
        {"index": 5, "text": "\u0920\u0940\u0915 \u0906\u0939\u0947, \u092e\u0932\u093e \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0938\u093e\u0902\u0917\u093e.", "language": "mr"},
        {"index": 6, "text": "\u0927\u0928\u094d\u092f\u0935\u093e\u0926, \u0924\u0941\u092e\u091a\u0940 \u092e\u0926\u0924 \u091d\u093e\u0932\u0940.", "language": "mr"},
        {"index": 7, "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930.", "language": "mr"}
