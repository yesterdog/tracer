      "agent_replies": [
        {"id": "sim-mr-s1-a00", "index": 0, "role": "agent", "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u092e\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u0936\u0940 \u092e\u0926\u0924 \u0915\u0930\u0942?", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a01", "index": 1, "role": "agent", "text": "\u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0938\u093e\u0902\u0917\u093e.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a02", "index": 2, "role": "agent", "text": "\u0927\u0928\u094d\u092f\u0935\u093e\u0926. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092e\u094b\u092c\u093e\u0908\u0932\u0935\u0930 \u0913\u091f\u0940\u092a\u0940 \u092a\u093e\u0920\u0935\u0932\u093e \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a03", "index": 3, "role": "agent", "text": "\u0915\u0943\u092a\u092f\u093e \u0913\u091f\u0940\u092a\u0940 \u0938\u093e\u0902\u0917\u093e.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a04", "index": 4, "role": "agent", "text": "\u0913\u091f\u0940\u092a\u0940 \u092c\u0930\u094b\u092c\u0930 \u0906\u0939\u0947. \u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u0909\u0918\u0921\u0932\u0947 \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a05", "index": 5, "role": "agent", "text": "\u092e\u093e\u0917\u091a\u094d\u092f\u093e \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u091a\u0947 \u092c\u093f\u0932 790 \u0930\u0941\u092a\u092f\u0947 \u0939\u094b\u0924\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a06", "index": 6, "role": "agent", "text": "\u0915\u0943\u092a\u092f\u093e \u0925\u094b\u0921\u093e \u0935\u0947\u0933 \u0925\u093e\u0902\u092c\u093e.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a07", "index": 7, "role": "agent", "text": "\u0939\u094b\u092f, \u092c\u093f\u0932\u093e\u0924\u0940\u0932 \u091a\u0942\u0915 \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947. \u0928\u0935\u0947 \u092c\u093f\u0932 790 \u0930\u0941\u092a\u092f\u0947 \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a08", "index": 8, "role": "agent", "text": "\u0906\u092a\u0932\u0947 \u0938\u094d\u0935\u093e\u0917\u0924 \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s1-a09", "index": 9, "role": "agent", "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true}
      ]
    },
    {
      "id": "sim-mr-s2",
      "title": "ticket id, delivery status and address change",
      "provenance": "synthetic_hand_written",
      "needs_native_review": true,
      "persona": {"language": "mr", "accent": null},
      "scripted_turns": [
        {"index": 0, "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u092e\u0932\u093e \u092e\u093e\u091d\u094d\u092f\u093e \u0911\u0930\u094d\u0921\u0930\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0939\u0935\u0940 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 1, "text": "\u092e\u093e\u091d\u093e \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 90417 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 2, "text": "\u0911\u0930\u094d\u0921\u0930 \u0915\u0927\u0940 \u092a\u094b\u0939\u094b\u091a\u0923\u093e\u0930 \u0906\u0939\u0947?", "language": "mr"},
        {"index": 3, "text": "\u092e\u0932\u093e \u0924\u0940 \u0906\u091c \u0938\u0902\u0927\u094d\u092f\u093e\u0915\u093e\u0933\u0940 \u0939\u0935\u0940 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 4, "text": "\u092e\u093e\u091d\u093e \u092a\u0924\u094d\u0924\u093e \u092c\u0926\u0932\u093e\u092f\u091a\u093e \u0906\u0939\u0947.", "language": "mr"},
        {"index": 5, "text": "\u0928\u0935\u0940\u0928 \u092a\u0924\u094d\u0924\u093e \u0906\u0939\u0947, 12, \u0917\u093e\u0902\u0927\u0940 \u0930\u0938\u094d\u0924\u093e, \u092a\u0941\u0923\u0947.", "language": "mr"},
        {"index": 6, "text": "\u092a\u093f\u0928 \u0915\u094b\u0921 411001 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 7, "text": "\u0939\u094b, \u0924\u094b\u091a \u092a\u0924\u094d\u0924\u093e \u092c\u0930\u094b\u092c\u0930 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 8, "text": "\u0921\u093f\u0932\u093f\u0935\u094d\u0939\u0930\u0940 \u0909\u0926\u094d\u092f\u093e \u0938\u0915\u093e\u0933\u0940 \u092f\u0947\u0908\u0932 \u0915\u093e?", "language": "mr"},
        {"index": 9, "text": "\u0920\u0940\u0915 \u0906\u0939\u0947, \u0927\u0928\u094d\u092f\u0935\u093e\u0926.", "language": "mr"}
      ],
      "turn_meta": [
