    {
      "id": "sim-mr-s1",
      "title": "billing query and one-time passcode",
      "provenance": "synthetic_hand_written",
      "needs_native_review": true,
      "persona": {"language": "mr", "accent": null},
      "scripted_turns": [
        {"index": 0, "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u092e\u093e\u091d\u094d\u092f\u093e \u092c\u093f\u0932\u093e\u092c\u0926\u094d\u0926\u0932 \u090f\u0915 \u092a\u094d\u0930\u0936\u094d\u0928 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 1, "text": "\u092f\u093e \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u091a\u0947 \u092c\u093f\u0932 840 \u0930\u0941\u092a\u092f\u0947 \u0906\u0932\u0947 \u0906\u0939\u0947, \u0924\u0947 \u091c\u093e\u0938\u094d\u0924 \u0935\u093e\u091f\u0924\u0947.", "language": "mr"},
        {"index": 2, "text": "\u092e\u093e\u091d\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 5521 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 3, "text": "\u092e\u0932\u093e \u0913\u091f\u0940\u092a\u0940 \u0906\u0932\u093e \u0906\u0939\u0947.", "language": "mr"},
        {"index": 4, "text": "\u0913\u091f\u0940\u092a\u0940 482917 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 5, "text": "\u092e\u0932\u093e \u092e\u093e\u0917\u091a\u094d\u092f\u093e \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u091a\u0947 \u092c\u093f\u0932 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u093e\u0939\u093e\u092f\u091a\u0947 \u0906\u0939\u0947.", "language": "mr"},
        {"index": 6, "text": "\u0920\u0940\u0915 \u0906\u0939\u0947, \u091a\u093e\u0932\u0947\u0932.", "language": "mr"},
        {"index": 7, "text": "\u092c\u093f\u0932 \u0915\u092e\u0940 \u091d\u093e\u0932\u0947 \u0915\u093e?", "language": "mr"},
        {"index": 8, "text": "\u0927\u0928\u094d\u092f\u0935\u093e\u0926, \u0924\u0941\u092e\u091a\u0940 \u092e\u0926\u0924 \u091d\u093e\u0932\u0940.", "language": "mr"},
        {"index": 9, "text": "\u0920\u0940\u0915 \u0906\u0939\u0947. \u0928\u092e\u0938\u094d\u0915\u093e\u0930.", "language": "mr"}
      ],
      "turn_meta": [
        {"id": "sim-mr-s1-c00", "index": 0, "role": "caller", "provenance": "synthetic_hand_written", "needs_native_review": true},
