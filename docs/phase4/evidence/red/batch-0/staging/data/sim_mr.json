  "charset": {
    "id": "mr-caller-charset/1",
    "provenance": "synthetic_hand_written",
    "needs_native_review": true,
    "applies_to": "each line of an LLM caller reply after the reply is split at U+000A; the end sentinel line is matched exactly first (SCOPE Q9) and never reaches this table",
    "unit": "code point of the text exactly as returned; the text is not normalised (ADR 0017 Decision 1)",
    "rules": [
      {"rule": "V01", "kind": "allow", "ranges": [["U+0900", "U+097F"]], "note": "Devanagari block; includes the danda U+0964 and the double danda U+0965"},
      {"rule": "V02", "kind": "deny", "ranges": [["U+0966", "U+096F"], ["U+0970", "U+0970"]], "note": "native digits and the abbreviation sign: the caller writes ASCII digits (judgment call, switchable; the normaliser folds native digits in the key, ADR 0025 R03, so comparison does not require this)"},
      {"rule": "V03", "kind": "allow", "ranges": [["U+0030", "U+0039"]], "note": "ASCII digits"},
      {"rule": "V04", "kind": "allow", "ranges": [["U+0020", "U+0022"], ["U+0027", "U+0029"], ["U+002C", "U+002E"], ["U+003A", "U+003B"], ["U+003F", "U+003F"]], "note": "space, exclamation mark, double quote, apostrophe, parentheses, comma, hyphen, full stop, colon, semicolon, question mark; all are separators in ADR 0025 R07 and R08, so they never change a token"},
      {"rule": "V05", "kind": "deny", "ranges": [["U+0041", "U+005A"], ["U+0061", "U+007A"]], "note": "Latin letters: stricter than storage (ADR 0005 Decision 7 allows a few Latin words in stored text); a spoken Latin word has no fixed reading in the TTS (judgment call)"},
      {"rule": "V06", "kind": "deny", "ranges": [["U+00AD", "U+00AD"], ["U+200B", "U+200F"], ["U+202A", "U+202E"], ["U+2060", "U+2069"], ["U+FEFF", "U+FEFF"]], "note": "joiners, zero-width space, bidi controls and other invisible characters (ADR 0025 R04 to R06 and R08; display safety, ADR 0017)"},
      {"rule": "V07", "kind": "deny", "category": ["Cc", "Cf", "Cs", "Co", "Cn"], "note": "controls, format, surrogates, private use and unassigned code points"},
      {"rule": "V08", "kind": "require_line", "check": "line is NFC (unicodedata.is_normalized('NFC', line))", "note": "U+0958 to U+095F are never NFC (ADR 0025 R01), so they are refused here"},
      {"rule": "V09", "kind": "require_line", "ranges": [["U+0904", "U+0939"]], "note": "at least one Devanagari letter in the line, so a line of only digits or punctuation is refused"}
    ],
    "order": "A code point passes when V01, V03 or V04 allows it and no deny rule (V02, V05, V06, V07) hits it; deny wins. V08 and V09 are checks on the whole line.",
    "on_failure": "reject the reply; at most one regeneration (SCOPE Q8)",
    "not_claimed": "passing this table says nothing about Marathi quality, grammar or naturalness"
  }
}
