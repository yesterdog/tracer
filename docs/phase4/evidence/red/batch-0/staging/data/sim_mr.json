        {"id": "sim-mr-s3-a00", "index": 0, "role": "agent", "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u0940 \u0924\u0915\u094d\u0930\u093e\u0930 \u0938\u093e\u0902\u0917\u093e.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a01", "index": 1, "role": "agent", "text": "\u092e\u093e\u092b \u0915\u0930\u093e, \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f\u092e\u0927\u0940\u0932 \u0905\u0921\u091a\u0923 \u0906\u092e\u094d\u0939\u0940 \u0924\u092a\u093e\u0938\u0924\u094b.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a02", "index": 2, "role": "agent", "text": "\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u091d\u093e\u0932\u0947\u0932\u094d\u092f\u093e \u0924\u094d\u0930\u093e\u0938\u093e\u092c\u0926\u094d\u0926\u0932 \u0926\u093f\u0932\u0917\u0940\u0930 \u0906\u0939\u094b\u0924.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a03", "index": 3, "role": "agent", "text": "\u0927\u0928\u094d\u092f\u0935\u093e\u0926. \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0928\u094b\u0902\u0926\u0935\u0932\u093e \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a04", "index": 4, "role": "agent", "text": "\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0909\u0926\u094d\u092f\u093e \u0938\u0915\u093e\u0933\u092a\u0930\u094d\u092f\u0902\u0924 \u0938\u0941\u091f\u0947\u0932.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a05", "index": 5, "role": "agent", "text": "\u0924\u0941\u092e\u091a\u093e \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 30518 \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a06", "index": 6, "role": "agent", "text": "\u0906\u092a\u0932\u0947 \u0938\u094d\u0935\u093e\u0917\u0924 \u0906\u0939\u0947.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true},
        {"id": "sim-mr-s3-a07", "index": 7, "role": "agent", "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930.", "language": "mr", "provenance": "synthetic_hand_written", "needs_native_review": true}
