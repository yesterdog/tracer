+++ b/packages/evalproviders/src/tracer_evalproviders/sarvam/_post.py
@@ -0,0 +1,235 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""One JSON POST with the retry, size and error rules of ADR 0024 (oracle of batch B)."""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Callable
+from dataclasses import dataclass
+from types import ModuleType
+from typing import Any
+
+import httpx
+
+from tracer_evalproviders.calllog import safe_request_id
+from tracer_evalproviders.sarvam.client import (
+    BACKOFF_SECONDS,
+    MAX_ATTEMPTS,
+    RETRY_AFTER_MAX_SECONDS,
+    _Attempt,
+    _error_facts,
+    _http_date,
+    _retry_after_seconds,
+    _transport_kind,
+    build_http_client,
+)
+from tracer_evalproviders.secrets import ApiKey
+from tracer_evalproviders.simcalllog import SimCallLog
+from tracer_evalschema.loader import loads_strict
+
+__all__ = ["JsonPoster", "Reply", "read_document"]
+
+_KEY_HEADER = "api-subscription-key"
+
+
+def _has_lone_surrogate(value: Any) -> bool:
+    if isinstance(value, str):
+        return any(0xD800 <= ord(char) <= 0xDFFF for char in value)
+    if isinstance(value, dict):
+        return any(_has_lone_surrogate(k) or _has_lone_surrogate(v) for k, v in value.items())
+    if isinstance(value, list):
+        return any(_has_lone_surrogate(item) for item in value)
+    return False
+
+
+def read_document(body: bytes) -> tuple[bool, Any]:
+    """``(True, document)`` or ``(False, None)``: strict JSON, no lone surrogate."""
+    try:
+        text = body.decode("utf-8")
+        loads_strict(text)
+        document = json.loads(text)
+        if _has_lone_surrogate(document):
+            return False, None
+    except Exception:
+        return False, None
+    return True, document
+
+
+@dataclass(frozen=True)
+class Reply:
+    body: bytes
+    date: Any
+    attempts: int
+
+
+class JsonPoster:
+    def __init__(
+        self,
+        api_key: ApiKey,
+        *,
+        url: str,
+        stage: str,
+        errors: ModuleType,
+        prefix: str,
+        call_log: SimCallLog,
+        id_member: str,
+        transport: httpx.BaseTransport | None,
+        sleep: Callable[[float], None],
+        monotonic: Callable[[], float],
+    ) -> None:
+        self._key = api_key
+        self._url = url
+        self._stage = stage
+        self._errors = errors
+        self._prefix = prefix
+        self._log = call_log
+        self._id_member = id_member
+        self._sleep = sleep
+        self._monotonic = monotonic
+        self._http = build_http_client(transport)
+
+    def close(self) -> None:
+        self._http.close()
+
+    def _err(self, suffix: str, **facts: Any) -> Any:
+        return getattr(self._errors, self._prefix + suffix)(**facts)
+
+    def post(
+        self,
+        *,
+        index: int,
+        body: bytes,
+        log_fields: dict[str, Any],
+        max_bytes: int,
+    ) -> Reply | Any:
+        for attempt in range(1, MAX_ATTEMPTS + 1):
+            result = self._once(index, attempt, body, log_fields, max_bytes)
+            classified = self._classify(index, attempt, result)
+            if isinstance(classified, Reply):
+                return classified
+            retry, error = classified
+            if not retry or attempt == MAX_ATTEMPTS:
+                return error
+            wait = BACKOFF_SECONDS[attempt - 1]
+            if result.status in (429, 503):
+                asked = _retry_after_seconds(result.headers)
+                if asked is not None and asked > RETRY_AFTER_MAX_SECONDS:
+                    return self._err(
+                        "RateLimited",
+                        index=index,
+                        status=result.status,
+                        code=error.code,
+                        request_id=error.request_id,
+                        attempts=attempt,
+                        reason="retry_after_above_bound",
+                    )
+                if asked is not None:
+                    wait = max(wait, float(asked))
+            self._sleep(wait)
+        raise AssertionError("unreachable")  # pragma: no cover
+
+    def _once(
+        self, index: int, attempt: int, body: bytes, log_fields: dict[str, Any], max_bytes: int
+    ) -> _Attempt:
+        request = self._http.build_request(
+            "POST",
+            self._url,
+            headers={
+                _KEY_HEADER: self._key.reveal(),
+                "accept-encoding": "identity",
+                "content-type": "application/json",
+            },
+            content=body,
+        )
+        sent = len(request.read())
+        self._log.before(
+            stage=self._stage, index=index, attempt=attempt, bytes_sent=sent, **log_fields
+        )
+        result = _Attempt()
+        started = self._monotonic()
+        try:
+            self._receive(request, result, max_bytes)
+        except httpx.DecodingError:
+            result.undecodable = True
+        except httpx.RequestError as error:
+            result.transport_kind = _transport_kind(error)
+        finished = self._monotonic()
+        if result.status is None:
+            request_id = None
+        elif result.status == 200:
+            request_id = self._success_id(result)
+        else:
+            request_id = _error_facts(result.headers, result.body)[1]
+        self._log.after(
+            stage=self._stage,
+            index=index,
+            attempt=attempt,
+            bytes_sent=sent,
+            status=result.status,
+            error_kind=result.transport_kind,
+            elapsed_ms=int((finished - started) * 1000),
+            request_id=request_id,
+            **log_fields,
+        )
+        return result
+
+    def _success_id(self, result: _Attempt) -> str | None:
+        found = None
+        if result.body is not None:
+            try:
+                document = json.loads(result.body)
+            except (ValueError, RecursionError):
+                document = None
+            if isinstance(document, dict):
+                found = safe_request_id(document.get(self._id_member))
+        return found if found is not None else safe_request_id(result.headers.get("x-request-id"))
+
+    def _receive(self, request: httpx.Request, result: _Attempt, max_bytes: int) -> None:
+        response = self._http.send(request, stream=True)
+        try:
+            result.status = response.status_code
+            result.headers = response.headers
+            buffer = bytearray()
+            for piece in response.iter_bytes():
+                buffer += piece
+                if len(buffer) > max_bytes:
+                    result.oversize = True
+                    return
+            result.body = bytes(buffer)
+        finally:
+            response.close()
+
+    def _classify(self, index: int, attempt: int, result: _Attempt) -> Reply | tuple[bool, Any]:
+        facts: dict[str, Any] = {"index": index, "attempts": attempt}
+        if result.transport_kind is not None:
+            return True, self._err("TransportError", kind=result.transport_kind, **facts)
+        if result.undecodable:
+            return False, self._err("ResponseInvalid", reason="body_undecodable", **facts)
+        status = result.status
+        if status is None:
+            return True, self._err("TransportError", kind="transport_error", **facts)
+        if status == 200:
+            media_type = result.headers.get("content-type", "").split(";")[0].strip().lower()
+            if media_type != "application/json":
+                return False, self._err(
+                    "ResponseInvalid", reason="content_type", status=200, **facts
+                )
+            if result.oversize or result.body is None:
+                return False, self._err(
+                    "ResponseInvalid", reason="body_too_large", status=200, **facts
+                )
+            return Reply(result.body, _http_date(result.headers.get("date")), attempt)
+        if not 400 <= status < 600:
+            return False, self._err(
+                "ResponseInvalid", status=status, reason="unexpected_status", **facts
+            )
+        code, request_id = _error_facts(result.headers, result.body)
+        known: dict[str, Any] = {"status": status, "code": code, "request_id": request_id, **facts}
+        if status in (401, 403) or code == "invalid_api_key_error":
+            return False, self._err("AuthError", **known)
+        if status == 429:
+            return True, self._err("RateLimited", **known)
+        if status >= 500:
+            return True, self._err("ServerError", **known)
+        return False, self._err("RequestRejected", **known)
diff --color -ruN -x __pycache__ qa-batch-b-9f03f8-pristine/packages/evalproviders/src/tracer_evalproviders/sarvam/chat.py qa-batch-b-9f03f8/packages/evalproviders/src/tracer_evalproviders/sarvam/chat.py
--- a/packages/evalproviders/src/tracer_evalproviders/sarvam/chat.py
+++ b/packages/evalproviders/src/tracer_evalproviders/sarvam/chat.py
@@ -0,0 +1,236 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Tracer contributors
+"""The Sarvam chat completions v2 adapter (oracle of batch B; ADR 0024 amendments A1, A3, A7)."""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+from collections.abc import Callable, Mapping
+from types import TracebackType
+from typing import Any, ClassVar, Final
+
+import httpx
+
+from tracer_evalcore import llm as core
+from tracer_evalcore.llm import LlmContext, LlmOutcome, LlmRequest
+from tracer_evalcore.stt import UsageSink
+from tracer_evalproviders.sarvam._post import JsonPoster, Reply, read_document
+from tracer_evalproviders.sarvam.models import CHAT_URL, LLM_MAX_REPLY_BYTES, MAX_RESPONSE_BYTES
+from tracer_evalproviders.secrets import ApiKey, load_role_key
+from tracer_evalproviders.simcalllog import SimCallLog
+from tracer_evalschema import SCHEMA_VERSION
+from tracer_evalschema.ids import UsageRecordId
+from tracer_evalschema.usage import UsageRecord
+
+__all__ = ["SEED_STATEMENT", "SarvamLlm", "create_sarvam_llm"]
+
+PROVIDER: Final = "sarvam"
+SEED_STATEMENT: Final = "replies may differ between requests, even with the same seed"
+_MAX_SAFE: Final = 2**53 - 1
+
+
+def _check_cap(cap: object) -> int | None:
+    if cap is None:
+        return None
+    if type(cap) is not int or not 0 <= cap <= _MAX_SAFE:
+        raise ValueError("cap must be None or an integer from 0 to 2**53 - 1")
+    return cap
+
+
+def _count(value: object) -> int | None:
+    if type(value) is not int or not 0 <= value <= _MAX_SAFE:
+        return None
+    return value
+
+
+class SarvamLlm:
+    provider = "sarvam"
+    streams_usage: ClassVar[bool] = True
+
+    def __init__(
+        self,
+        api_key: ApiKey,
+        *,
+        call_log: SimCallLog,
+        cap_tokens: int | None,
+        transport: httpx.BaseTransport | None = None,
+        sleep: Callable[[float], None] = time.sleep,
+        monotonic: Callable[[], float] = time.monotonic,
+    ) -> None:
+        if not isinstance(api_key, ApiKey):
+            raise TypeError("api_key must be an ApiKey")
+        self._cap = _check_cap(cap_tokens)
+        self._reported = 0
+        self._post = JsonPoster(
+            api_key,
+            url=CHAT_URL,
+            stage="llm",
+            errors=core,
+            prefix="Llm",
+            call_log=call_log,
+            id_member="id",
+            transport=transport,
+            sleep=sleep,
+            monotonic=monotonic,
+        )
+
+    def close(self) -> None:
+        self._post.close()
+
+    def __enter__(self) -> SarvamLlm:
+        return self
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: TracebackType | None,
+    ) -> None:
+        self.close()
+
+    def complete(
+        self, request: LlmRequest, context: LlmContext, *, on_usage: UsageSink | None = None
+    ) -> LlmOutcome:
+        if not isinstance(request, LlmRequest) or not isinstance(context, LlmContext):
+            raise TypeError("request and context must be records")
+        if self._cap is not None and self._reported + request.max_tokens > self._cap:
+            return LlmOutcome(
+                text=None,
+                usage=(),
+                failure=core.LlmCapReachedError(index=request.index, reason="llm_tokens"),
+            )
+        payload: dict[str, Any] = {
+            "model": request.model,
+            "messages": [{"role": m.role, "content": m.content} for m in request.messages],
+            "max_tokens": request.max_tokens,
+        }
+        if request.seed is not None:
+            payload["seed"] = request.seed
+        if request.reasoning_effort is not None:
+            payload["reasoning_effort"] = request.reasoning_effort
+        reply = self._post.post(
+            index=request.index,
+            body=json.dumps(payload).encode("utf-8"),
+            log_fields={},
+            max_bytes=MAX_RESPONSE_BYTES,
+        )
+        if not isinstance(reply, Reply):
+            return LlmOutcome(text=None, usage=(), failure=reply)
+        parsed = self._parse(request, reply)
+        if isinstance(parsed, core.LlmError):
+            return LlmOutcome(text=None, usage=(), failure=parsed)
+        text, reply_id, prompt, completion, cached = parsed
+        self._reported += prompt + completion
+        record = self._record(request, context, reply, reply_id, prompt, completion, cached)
+        if on_usage is not None:
+            on_usage(record)
+        return LlmOutcome(text=text, usage=(record,), failure=None)
+
+    def _parse(
+        self, request: LlmRequest, reply: Reply
+    ) -> tuple[str, str, int, int, int | None] | core.LlmError:
+        facts: dict[str, Any] = {"index": request.index, "attempts": reply.attempts, "status": 200}
+
+        def invalid(reason: str) -> core.LlmError:
+            return core.LlmResponseInvalid(reason=reason, **facts)
+
+        ok, document = read_document(reply.body)
+        if not ok:
+            return invalid("not_json")
+        if not isinstance(document, dict):
+            return invalid("not_object")
+        reply_id = document.get("id")
+        if not isinstance(reply_id, str) or not 1 <= len(reply_id) <= 256:
+            return invalid("id_invalid")
+        choices = document.get("choices")
+        if not (isinstance(choices, list) and len(choices) == 1):
+            return invalid("choices_invalid")
+        message = choices[0].get("message") if isinstance(choices[0], dict) else None
+        if not isinstance(message, dict):
+            return invalid("message_invalid")
+        content = message.get("content")
+        if not isinstance(content, str):
