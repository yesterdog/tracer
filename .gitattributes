# Generated JSON Schema files and schema.lock are hashed byte for byte (schema.lock, ADR 0008):
# keep them LF on every platform, so a Windows checkout cannot turn LF into CRLF and break the
# hashes. Regenerate them with `uv run python -m tracer_evalschema.schema_export --write`.
packages/evalschema/src/tracer_evalschema/schemas/** text eol=lf
*.schema.json text eol=lf
schema.lock text eol=lf
packages/evalschema/tests/fixtures/golden/** text eol=lf
packages/evalschema/tests/fixtures/frozen/** text eol=lf
packages/evalschema/tests/fixtures/languages/** text eol=lf
