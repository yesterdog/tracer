    {"id": "nfc-composes-nnna-rra", "text": "\u0928\u093c \u0930\u093c", "expected_tokens": [{"key": "\u0929", "start": 0, "end": 2}, {"key": "\u0931", "start": 3, "end": 5}], "rules": ["R01"], "purpose": "NA + nukta composes to U+0929 and RA + nukta to U+0931 (these two are not composition-excluded), the opposite direction from U+0958 to U+095F.", "needs_native_review": true},
