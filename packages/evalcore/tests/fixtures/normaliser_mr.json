    {"id": "joiner-trailing-kept-in-span", "text": "\u0915\u094d\u200d \u0916", "expected_tokens": [{"key": "\u0915\u094d", "start": 0, "end": 3}, {"key": "\u0916", "start": 4, "end": 5}], "rules": ["R04", "R16"], "purpose": "A ZWJ after the virama at the end of a word is inside the span (it belongs to the grapheme cluster) and is dropped from the key.", "needs_native_review": true},
