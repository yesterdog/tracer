  "cases": [
    {"id": "ref-mr-001", "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u092e\u0940 \u0924\u0941\u092e\u091a\u0940 \u0915\u093e\u092f \u092e\u0926\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?", "expected_tokens": [{"key": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930", "start": 0, "end": 7}, {"key": "\u092e\u0940", "start": 9, "end": 11}, {"key": "\u0924\u0941\u092e\u091a\u0940", "start": 12, "end": 17}, {"key": "\u0915\u093e\u092f", "start": 18, "end": 21}, {"key": "\u092e\u0926\u0924", "start": 22, "end": 25}, {"key": "\u0915\u0930\u0942", "start": 26, "end": 29}, {"key": "\u0936\u0915\u0924\u094b", "start": 30, "end": 34}], "rules": ["R07", "R15"], "purpose": "Reference: mr.json mr-001. A comma and a question mark separate tokens; seven tokens.", "needs_native_review": true},
    {"id": "ref-mr-002", "text": "\u0917\u094d\u0930\u0902\u0925\u093e\u0932\u092f \u0938\u094b\u092e\u0935\u093e\u0930 \u0924\u0947 \u0936\u0928\u093f\u0935\u093e\u0930 \u0938\u0915\u093e\u0933\u0940 \u0928\u090a \u0924\u0947 \u0938\u0902\u0927\u094d\u092f\u093e\u0915\u093e\u0933\u0940 \u0938\u0939\u093e \u0935\u093e\u091c\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u0909\u0918\u0921\u0947 \u0905\u0938\u0924\u0947.", "expected_tokens": [{"key": "\u0917\u094d\u0930\u0902\u0925\u093e\u0932\u092f", "start": 0, "end": 8}, {"key": "\u0938\u094b\u092e\u0935\u093e\u0930", "start": 9, "end": 15}, {"key": "\u0924\u0947", "start": 16, "end": 18}, {"key": "\u0936\u0928\u093f\u0935\u093e\u0930", "start": 19, "end": 25}, {"key": "\u0938\u0915\u093e\u0933\u0940", "start": 26, "end": 31}, {"key": "\u0928\u090a", "start": 32, "end": 34}, {"key": "\u0924\u0947", "start": 35, "end": 37}, {"key": "\u0938\u0902\u0927\u094d\u092f\u093e\u0915\u093e\u0933\u0940", "start": 38, "end": 48}, {"key": "\u0938\u0939\u093e", "start": 49, "end": 52}, {"key": "\u0935\u093e\u091c\u0947\u092a\u0930\u094d\u092f\u0902\u0924", "start": 53, "end": 63}, {"key": "\u0909\u0918\u0921\u0947", "start": 64, "end": 68}, {"key": "\u0905\u0938\u0924\u0947", "start": 69, "end": 73}], "rules": ["R07", "R11", "R15"], "purpose": "Reference: mr.json mr-002. The LLA letter (U+0933) stays in the keys; the full stop separates; twelve tokens.", "needs_native_review": true},
    {"id": "ref-mr-003", "text": "\u0915\u093e\u0909\u0902\u091f\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u092c\u093e\u0930\u093e.", "expected_tokens": [{"key": "\u0915\u093e\u0909\u0902\u091f\u0930", "start": 0, "end": 6}, {"key": "\u0915\u094d\u0930\u092e\u093e\u0902\u0915", "start": 7, "end": 14}, {"key": "\u092c\u093e\u0930\u093e", "start": 15, "end": 19}], "rules": ["R07", "R15"], "purpose": "Reference: mr.json mr-003. A number written as a word stays a word token.", "needs_native_review": true},
    {"id": "ref-mr-004", "text": "\u0917\u094d\u0930\u0902\u0925\u093e\u0932\u092f \u0938\u0915\u093e\u0933\u0940 \u096f \u0935\u093e\u091c\u0924\u093e \u0909\u0918\u0921\u0924\u0947.", "expected_tokens": [{"key": "\u0917\u094d\u0930\u0902\u0925\u093e\u0932\u092f", "start": 0, "end": 8}, {"key": "\u0938\u0915\u093e\u0933\u0940", "start": 9, "end": 14}, {"key": "9", "start": 15, "end": 16}, {"key": "\u0935\u093e\u091c\u0924\u093e", "start": 17, "end": 22}, {"key": "\u0909\u0918\u0921\u0924\u0947", "start": 23, "end": 28}], "rules": ["R03", "R07", "R15"], "purpose": "Reference: mr.json mr-004. The Devanagari digit nine (U+096F) has the key 9; its span is the original code point.", "needs_native_review": true},
    {"id": "ref-mr-005", "text": "\u092a\u0941\u0938\u094d\u0924\u0915 \u096b \u0928\u094b\u0935\u094d\u0939\u0947\u0902\u092c\u0930\u0932\u093e 10 \u0935\u093e\u091c\u0924\u093e \u092a\u0930\u0924 \u0915\u0930\u093e\u092f\u091a\u0947 \u0906\u0939\u0947.", "expected_tokens": [{"key": "\u092a\u0941\u0938\u094d\u0924\u0915", "start": 0, "end": 6}, {"key": "5", "start": 7, "end": 8}, {"key": "\u0928\u094b\u0935\u094d\u0939\u0947\u0902\u092c\u0930\u0932\u093e", "start": 9, "end": 20}, {"key": "10", "start": 21, "end": 23}, {"key": "\u0935\u093e\u091c\u0924\u093e", "start": 24, "end": 29}, {"key": "\u092a\u0930\u0924", "start": 30, "end": 33}, {"key": "\u0915\u0930\u093e\u092f\u091a\u0947", "start": 34, "end": 40}, {"key": "\u0906\u0939\u0947", "start": 41, "end": 44}], "rules": ["R03", "R07", "R15"], "purpose": "Reference: mr.json mr-005. A native digit and an ASCII digit in one turn; keys 5 and 10 are both ASCII.", "needs_native_review": true},
    {"id": "ref-mr-006", "text": "\u0915\u093e\u0930\u094d\u200d\u092f \u0915\u093e\u0930\u094d\u200c\u092f", "expected_tokens": [{"key": "\u0915\u093e\u0930\u094d\u092f", "start": 0, "end": 6}, {"key": "\u0915\u093e\u0930\u094d\u092f", "start": 7, "end": 13}], "rules": ["R04", "R16"], "purpose": "Reference: mr.json mr-006. ZWJ and ZWNJ after the virama are dropped from the key only, so both tokens get the same key; the spans keep the joiners (six code points each). Whether a reader treats the eyelash form as the same word is unconfirmed (BL-132).", "needs_native_review": true},
    {"id": "ref-mr-007", "text": "\u0915\u093e\u0933", "expected_tokens": [{"key": "\u0915\u093e\u0933", "start": 0, "end": 3}], "rules": ["R11"], "purpose": "Reference: mr.json mr-007. LLA (U+0933) is kept; the key differs from the key of ref-mr-008.", "needs_native_review": true},
    {"id": "ref-mr-008", "text": "\u0915\u093e\u0932", "expected_tokens": [{"key": "\u0915\u093e\u0932", "start": 0, "end": 3}], "rules": ["R11"], "purpose": "Reference: mr.json mr-008. Plain LA (U+0932) is kept; the key differs from the key of ref-mr-007.", "needs_native_review": true},
    {"id": "ref-mr-009", "text": "\u092e\u0932\u093e WhatsApp \u0935\u0930 \u0938\u0902\u0926\u0947\u0936 \u092a\u093e\u0920\u0935\u093e.", "expected_tokens": [{"key": "\u092e\u0932\u093e", "start": 0, "end": 3}, {"key": "whatsapp", "start": 4, "end": 12}, {"key": "\u0935\u0930", "start": 13, "end": 15}, {"key": "\u0938\u0902\u0926\u0947\u0936", "start": 16, "end": 21}, {"key": "\u092a\u093e\u0920\u0935\u093e", "start": 22, "end": 27}], "rules": ["R07", "R10", "R15"], "purpose": "Reference: mr.json mr-009. A Latin-script word inside a Marathi sentence is its own token with a case-folded key; no transliteration.", "needs_native_review": true},
    {"id": "ref-mr-010", "text": "mala pustak parat karaycha aahe", "expected_tokens": [{"key": "mala", "start": 0, "end": 4}, {"key": "pustak", "start": 5, "end": 11}, {"key": "parat", "start": 12, "end": 17}, {"key": "karaycha", "start": 18, "end": 26}, {"key": "aahe", "start": 27, "end": 31}], "rules": ["R10", "R15"], "purpose": "Reference: mr.json mr-010. Romanised text is tokenised like any Latin text; the normaliser does not transliterate (the script check belongs to the metric layer).", "needs_native_review": true},
    {"id": "nfc-precomposed-za-word", "text": "\u095b\u0930\u0942\u0930", "expected_tokens": [{"key": "\u091c\u093c\u0930\u0942\u0930", "start": 0, "end": 4}], "rules": ["R01"], "purpose": "Precomposed ZA (U+095B) decomposes in NFC to JA + nukta (U+091C U+093C): the key is one code point longer than the span.", "needs_native_review": true},
    {"id": "nfc-decomposed-za-word", "text": "\u091c\u093c\u0930\u0942\u0930", "expected_tokens": [{"key": "\u091c\u093c\u0930\u0942\u0930", "start": 0, "end": 5}], "rules": ["R01", "R13"], "purpose": "JA + nukta already in NFC; same key as nfc-precomposed-za-word. The nukta is not stripped.", "needs_native_review": true},
    {"id": "nfc-precomposed-qa-to-yya-run", "text": "\u0958\u0959\u095a\u095b\u095c\u095d\u095e\u095f", "expected_tokens": [{"key": "\u0915\u093c\u0916\u093c\u0917\u093c\u091c\u093c\u0921\u093c\u0922\u093c\u092b\u093c\u092f\u093c", "start": 0, "end": 8}], "rules": ["R01"], "purpose": "All eight composition-excluded letters U+0958 to U+095F decompose in NFC; the key never contains one of them. Eight code points in the span, sixteen in the key.", "needs_native_review": true},
