    {"id": "nfc-llla-from-lla-nukta", "text": "\u0933\u093c \u0933", "expected_tokens": [{"key": "\u0934", "start": 0, "end": 2}, {"key": "\u0933", "start": 3, "end": 4}], "rules": ["R01", "R11"], "purpose": "LLA + nukta composes to U+0934, which is a different key from plain LLA (U+0933); neither is merged with LA (U+0932).", "needs_native_review": true},
    {"id": "nfc-reorders-nukta-before-virama", "text": "\u0915\u094d\u093c", "expected_tokens": [{"key": "\u0915\u093c\u094d", "start": 0, "end": 3}], "rules": ["R01", "R13", "R16"], "purpose": "Canonical ordering by combining class: nukta (class 7) sorts before virama (class 9), so the key order differs from the text order. The span keeps all three code points.", "needs_native_review": true},
