{
  "$defs": {
    "ContentDigest": {
      "additionalProperties": false,
      "description": "``{scheme, value, key_ref?}`` (ADR 0006 Decision 3). An unregistered scheme raises\n``UnknownDigestScheme`` (not wrapped by pydantic): it is never \"unverifiable, accept\".",
      "properties": {
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "enum": [
            "sha256-jcs/v1",
            "hmac-sha256-jcs/v1"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ContentDigest",
      "type": "object"
    },
    "KeyRef": {
      "additionalProperties": false,
      "description": "Names a key held by a key manager; never carries key material (ADR 0007 Decision 4).\n\n``key_id`` is the key manager's own name for the key, an opaque string stored as given\n(ADR 0001 I12), not one of our typed IDs.",
      "properties": {
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "key_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Version"
        },
        "provider_hint": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Hint"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "KeyRef",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    },
    "MetricDefinitionRef": {
      "additionalProperties": false,
      "description": "``{id, version, content_digest?}`` of a ``MetricDefinition`` (ADR 0009 Decision 4).",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^met_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "MetricDefinitionRef",
      "type": "object"
    }
  },
  "$id": "urn:tracer:evalschema:0.0.1:MetricBinding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A definition bound to an evaluator (prefix ``mbd``; ADR 0010 Decisions 4 and 4a).\n\n``params`` set parameters the definition declares, stored unchanged; they never change a\ndefinition field such as the pass rule (E6). ``check_binding_params`` checks them against the\ndefinition. A disabled binding is never run and may not be a rubric item.",
  "properties": {
    "content_digest": {
      "$ref": "#/$defs/ContentDigest"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "evaluator_id": {
      "pattern": "^evl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Evaluator Id",
      "type": "string"
    },
    "id": {
      "pattern": "^mbd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "metric": {
      "$ref": "#/$defs/MetricDefinitionRef"
    },
    "params": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {}
      },
      "title": "Params",
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "content_digest",
    "created_at",
    "enabled",
    "evaluator_id",
    "id",
    "metric",
    "params",
    "schema_version",
    "version"
  ],
  "title": "MetricBinding",
  "type": "object"
}
