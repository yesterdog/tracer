{
  "$defs": {
    "ContentDigest": {
      "additionalProperties": false,
      "description": "``{scheme, value, key_ref?}`` (ADR 0006 Decision 3). An unregistered scheme raises\n``UnknownDigestScheme`` (not wrapped by pydantic): it is never \"unverifiable, accept\".",
      "properties": {
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "enum": [
            "sha256-jcs/v1",
            "hmac-sha256-jcs/v1"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ContentDigest",
      "type": "object"
    },
    "KeyRef": {
      "additionalProperties": false,
      "description": "Names a key held by a key manager; never carries key material (ADR 0007 Decision 4).\n\n``key_id`` is the key manager's own name for the key, an opaque string stored as given\n(ADR 0001 I12), not one of our typed IDs.",
      "properties": {
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "key_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Version"
        },
        "provider_hint": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Hint"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "KeyRef",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    }
  },
  "$id": "urn:tracer:evalschema:0.0.1:TestProfile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The identity a simulated caller presents (prefix ``tpf``). Every data field is PII.",
  "properties": {
    "account_number": {
      "minLength": 1,
      "title": "Account Number",
      "type": "string",
      "x-pii": true
    },
    "content_digest": {
      "$ref": "#/$defs/ContentDigest"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "dob": {
      "minLength": 1,
      "title": "Dob",
      "type": "string",
      "x-pii": true
    },
    "id": {
      "pattern": "^tpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string",
      "x-pii": true
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "account_number",
    "content_digest",
    "created_at",
    "dob",
    "id",
    "name",
    "schema_version",
    "version"
  ],
  "title": "TestProfile",
  "type": "object"
}
