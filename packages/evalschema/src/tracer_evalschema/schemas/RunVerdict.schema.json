{
  "$defs": {
    "ContentDigest": {
      "additionalProperties": false,
      "description": "``{scheme, value, key_ref?}`` (ADR 0006 Decision 3). An unregistered scheme raises\n``UnknownDigestScheme`` (not wrapped by pydantic): it is never \"unverifiable, accept\".",
      "properties": {
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "enum": [
            "sha256-jcs/v1",
            "hmac-sha256-jcs/v1"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ContentDigest",
      "type": "object"
    },
    "KeyRef": {
      "additionalProperties": false,
      "description": "Names a key held by a key manager; never carries key material (ADR 0007 Decision 4).\n\n``key_id`` is the key manager's own name for the key, an opaque string stored as given\n(ADR 0001 I12), not one of our typed IDs.",
      "properties": {
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "key_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Version"
        },
        "provider_hint": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Hint"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "KeyRef",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    },
    "MetricDefinitionRef": {
      "additionalProperties": false,
      "description": "``{id, version, content_digest?}`` of a ``MetricDefinition`` (ADR 0009 Decision 4).",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^met_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "MetricDefinitionRef",
      "type": "object"
    },
    "VerdictCheck": {
      "additionalProperties": false,
      "description": "One required rubric binding and the outcome of its result (ADR 0013 Decisions 2 and 3).\n``metric_ref`` is the binding's ``metric`` reference, never text.",
      "properties": {
        "binding_id": {
          "pattern": "^mbd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Binding Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricDefinitionRef"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "not_applicable",
            "errored"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "result_id": {
          "pattern": "^res_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "metric_ref",
        "outcome",
        "result_id"
      ],
      "title": "VerdictCheck",
      "type": "object"
    },
    "WeightedExclusion": {
      "additionalProperties": false,
      "description": "A weighted check left out of the weighted score, and why (ADR 0013 Decision 8).",
      "properties": {
        "binding_id": {
          "pattern": "^mbd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Binding Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "not_applicable",
            "errored"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "outcome"
      ],
      "title": "WeightedExclusion",
      "type": "object"
    }
  },
  "$id": "urn:tracer:evalschema:0.0.1:RunVerdict",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The verdict of a run (prefix ``vrd``; ADR 0013). A record of fact without ``run_id``: the\nRunBundle is the unit of a run (N22).",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/VerdictCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "errored": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Errored",
      "type": "integer"
    },
    "failed": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "id": {
      "pattern": "^vrd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "not_applicable": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Not Applicable",
      "type": "integer"
    },
    "passed": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Passed",
      "type": "integer"
    },
    "required_total": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Required Total",
      "type": "integer"
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "Status",
      "type": "string"
    },
    "weight_coverage": {
      "anyOf": [
        {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]{0,17}[1-9])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weight Coverage"
    },
    "weighted_excluded": {
      "items": {
        "$ref": "#/$defs/WeightedExclusion"
      },
      "title": "Weighted Excluded",
      "type": "array"
    },
    "weighted_score": {
      "anyOf": [
        {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]{0,17}[1-9])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weighted Score"
    }
  },
  "required": [
    "checks",
    "created_at",
    "errored",
    "failed",
    "id",
    "not_applicable",
    "passed",
    "required_total",
    "schema_version",
    "status"
  ],
  "title": "RunVerdict",
  "type": "object"
}
