{
  "$defs": {
    "CostExclusion": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "duplicate_of_reported"
                ]
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "covered_by": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "A record a summary leaves out of its total, and why (Decision 16a): the record's\n``na_reason``, ``duplicate_of_reported`` (an available computed record set aside for an\navailable reported one; ``covered_by`` non-empty) or ``overlaps_reported`` (an available\ncomputed record that only partly overlaps included reported records, N53). ``covered_by``\nlists the included records that cover all of the record's usage, else it is empty; it names\neach record at most once (N78).",
      "properties": {
        "covered_by": {
          "items": {
            "pattern": "^cst_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Covered By",
          "type": "array",
          "uniqueItems": true
        },
        "reason": {
          "enum": [
            "no_price_for_model",
            "unit_unpriced",
            "no_usage",
            "ambiguous_price",
            "billing_rules_missing",
            "usage_not_reported",
            "unsupported_currency",
            "currency_not_reported",
            "amount_unparseable",
            "currency_conflict",
            "duplicate_of_reported",
            "overlaps_reported"
          ],
          "title": "Reason",
          "type": "string"
        },
        "ref": {
          "pattern": "^cst_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "covered_by",
        "reason",
        "ref"
      ],
      "title": "CostExclusion",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An exact amount of money: ``{amount, currency}``, both required (ADR 0014 Decision 1).\n\nEqual by value. ``+`` adds exactly and returns the canonical amount; ``display()`` rounds for\npresentation only.",
      "properties": {
        "amount": {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]{0,17}[1-9])$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "enum": [
            "USD"
          ],
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "$id": "urn:tracer:evalschema:0.0.1:CostSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "completeness": {
            "enum": [
              "none"
            ]
          },
          "total": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "included": {
            "minItems": 1
          }
        },
        "required": [
          "included"
        ]
      },
      "then": {
        "properties": {
          "completeness": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "total": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "total"
        ]
      }
    }
  ],
  "description": "The cost of one domain of a run (prefix ``csum``; a record of fact; Decision 16). The\nrules on the summary alone are checked here; the rules against its records are\n``check_cost_summary``.",
  "properties": {
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "none"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "domain": {
      "enum": [
        "evaluation",
        "agent_under_test"
      ],
      "title": "Domain",
      "type": "string"
    },
    "excluded": {
      "items": {
        "$ref": "#/$defs/CostExclusion"
      },
      "title": "Excluded",
      "type": "array"
    },
    "id": {
      "pattern": "^csum_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "included": {
      "items": {
        "pattern": "^cst_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Included",
      "type": "array",
      "uniqueItems": true
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "total": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "completeness",
    "created_at",
    "domain",
    "excluded",
    "id",
    "included",
    "schema_version"
  ],
  "title": "CostSummary",
  "type": "object"
}
