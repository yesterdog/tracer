{
  "$defs": {
    "ContentDigest": {
      "additionalProperties": false,
      "description": "``{scheme, value, key_ref?}`` (ADR 0006 Decision 3). An unregistered scheme raises\n``UnknownDigestScheme`` (not wrapped by pydantic): it is never \"unverifiable, accept\".",
      "properties": {
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "enum": [
            "sha256-jcs/v1",
            "hmac-sha256-jcs/v1"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ContentDigest",
      "type": "object"
    },
    "CostRounding": {
      "additionalProperties": false,
      "description": "``{scale: 18, mode: half_even, exact: false}`` (P-35): present on an available computed\nrecord iff the record's total was rounded.",
      "properties": {
        "exact": {
          "enum": [
            false
          ],
          "title": "Exact",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "half_even"
          ],
          "title": "Mode",
          "type": "string"
        },
        "scale": {
          "enum": [
            18
          ],
          "title": "Scale",
          "type": "integer"
        }
      },
      "required": [
        "exact",
        "mode",
        "scale"
      ],
      "title": "CostRounding",
      "type": "object"
    },
    "KeyRef": {
      "additionalProperties": false,
      "description": "Names a key held by a key manager; never carries key material (ADR 0007 Decision 4).\n\n``key_id`` is the key manager's own name for the key, an opaque string stored as given\n(ADR 0001 I12), not one of our typed IDs.",
      "properties": {
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "key_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Version"
        },
        "provider_hint": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Hint"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "KeyRef",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An exact amount of money: ``{amount, currency}``, both required (ADR 0014 Decision 1).\n\nEqual by value. ``+`` adds exactly and returns the canonical amount; ``display()`` rounds for\npresentation only.",
      "properties": {
        "amount": {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]{0,17}[1-9])$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "enum": [
            "USD"
          ],
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PricingSnapshot": {
      "additionalProperties": false,
      "description": "The catalog version and the entries a computed cost used (ADR 0014 Decision 12, O6, N61):\n``(catalog_id, version, content_digest)`` names one catalog version and ``entry_keys`` the\nentries used, by their catalog-scoped ``entry_key`` (non-empty, distinct).",
      "properties": {
        "catalog_id": {
          "pattern": "^pcat_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Catalog Id",
          "type": "string"
        },
        "content_digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "entry_keys": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Entry Keys",
          "type": "array",
          "uniqueItems": true
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "catalog_id",
        "content_digest",
        "entry_keys",
        "version"
      ],
      "title": "PricingSnapshot",
      "type": "object"
    },
    "ReportedCostRaw": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "currency_raw": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "currency_raw"
            ]
          },
          "if": {
            "properties": {
              "currency_source": {
                "enum": [
                  "none"
                ]
              }
            },
            "required": [
              "currency_source"
            ]
          },
          "then": {
            "properties": {
              "currency_raw": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "A reported source's cost values, verbatim and never parsed (ADR 0014 Decisions 12, 12b):\nthe amount lexeme, the currency label as sent (``payload``) or as the cited API contract\nwrites it (``api_contract``), or no currency (``none``). A present ``currency_raw`` is never\nempty or ASCII white space only, which is no label (D6).",
      "properties": {
        "amount_raw": {
          "title": "Amount Raw",
          "type": "string"
        },
        "currency_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Raw"
        },
        "currency_source": {
          "enum": [
            "payload",
            "api_contract",
            "none"
          ],
          "title": "Currency Source",
          "type": "string"
        },
        "reported_by": {
          "enum": [
            "provider",
            "telemetry_platform"
          ],
          "title": "Reported By",
          "type": "string"
        }
      },
      "required": [
        "amount_raw",
        "currency_source",
        "reported_by"
      ],
      "title": "ReportedCostRaw",
      "type": "object"
    }
  },
  "$id": "urn:tracer:evalschema:0.0.1:CostRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "amount": {
            "type": "null"
          },
          "basis": {
            "type": "null"
          },
          "na_reason": {
            "not": {
              "type": "null"
            }
          },
          "pricing_snapshot": {
            "type": "null"
          },
          "reported_by": {
            "type": "null"
          },
          "rounding": {
            "type": "null"
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "available"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "not": {
              "type": "null"
            }
          },
          "basis": {
            "not": {
              "type": "null"
            }
          },
          "na_reason": {
            "type": "null"
          },
          "reported_raw": {
            "type": "null"
          },
          "unpriced_units": {
            "maxItems": 0
          }
        },
        "required": [
          "amount",
          "basis"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "enum": [
              "reported"
            ]
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "properties": {
          "pricing_snapshot": {
            "type": "null"
          },
          "reported_by": {
            "not": {
              "type": "null"
            }
          },
          "rounding": {
            "type": "null"
          }
        },
        "required": [
          "reported_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "enum": [
              "computed"
            ]
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "properties": {
          "pricing_snapshot": {
            "not": {
              "type": "null"
            }
          },
          "reported_by": {
            "type": "null"
          },
          "usage_record_ids": {
            "minItems": 1
          }
        },
        "required": [
          "pricing_snapshot"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "reported_raw": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "unsupported_currency",
              "currency_not_reported",
              "amount_unparseable",
              "currency_conflict"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "reported_raw": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "reported_raw"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "unsupported_currency"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "reported_raw": {
            "properties": {
              "currency_source": {
                "enum": [
                  "payload",
                  "api_contract"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "currency_not_reported"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "reported_raw": {
            "properties": {
              "currency_source": {
                "enum": [
                  "none"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "amount_unparseable"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "reported_raw": {
            "properties": {
              "currency_source": {
                "enum": [
                  "payload",
                  "api_contract"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "currency_conflict"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "reported_raw": {
            "properties": {
              "currency_source": {
                "enum": [
                  "payload"
                ]
              }
            }
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "unpriced_units": {
            "maxItems": 0
          }
        }
      },
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "unit_unpriced"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "unpriced_units": {
            "minItems": 1
          }
        },
        "required": [
          "unpriced_units"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "no_usage",
              "usage_not_reported"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "usage_record_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "na_reason": {
            "enum": [
              "no_price_for_model",
              "unit_unpriced",
              "billing_rules_missing",
              "ambiguous_price"
            ]
          }
        },
        "required": [
          "na_reason"
        ]
      },
      "then": {
        "properties": {
          "usage_record_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "description": "A cost of one domain (prefix ``cst``; a record of fact; ADR 0014 Decisions 12 to 16).\n\n``status=available``: an ``amount`` (USD, >= 0) and a ``basis``, with no ``na_reason``, no\n``reported_raw`` and no ``unpriced_units``. ``basis=reported`` names ``reported_by`` and has no\n``pricing_snapshot`` and no ``rounding``. ``basis=computed`` has the ``pricing_snapshot`` it\nused, names no reporter, lists the usage records it priced, and carries ``rounding`` only when\nthe amount was rounded (P-35).\n\n``status=not_available``: an ``na_reason`` and nothing that could read as a cost (no\n``amount``, ``basis``, ``reported_by``, ``pricing_snapshot`` or ``rounding``; never an amount\nof 0). ``reported_raw`` keeps a reported source's values verbatim and is present exactly for\nthe four reasons ``unsupported_currency``, ``currency_not_reported``, ``amount_unparseable``\nand ``currency_conflict`` (N51). ``unpriced_units`` is non-empty exactly when the reason is\n``unit_unpriced``. ``usage_record_ids`` has no repeats and follows the reason (N67): empty for\n``no_usage`` and ``usage_not_reported``, non-empty for ``no_price_for_model``,\n``unit_unpriced``, ``billing_rules_missing`` and ``ambiguous_price``.",
  "properties": {
    "amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "basis": {
      "anyOf": [
        {
          "enum": [
            "reported",
            "computed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Basis"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "domain": {
      "enum": [
        "evaluation",
        "agent_under_test"
      ],
      "title": "Domain",
      "type": "string"
    },
    "id": {
      "pattern": "^cst_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "na_reason": {
      "anyOf": [
        {
          "enum": [
            "no_price_for_model",
            "unit_unpriced",
            "no_usage",
            "ambiguous_price",
            "billing_rules_missing",
            "usage_not_reported",
            "unsupported_currency",
            "currency_not_reported",
            "amount_unparseable",
            "currency_conflict"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Na Reason"
    },
    "pricing_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/PricingSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reported_by": {
      "anyOf": [
        {
          "enum": [
            "provider",
            "telemetry_platform"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported By"
    },
    "reported_raw": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportedCostRaw"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostRounding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "not_available"
      ],
      "title": "Status",
      "type": "string"
    },
    "unpriced_units": {
      "items": {
        "enum": [
          "input_tokens",
          "cache_read_input_tokens",
          "cache_write_input_tokens",
          "output_tokens",
          "audio_input_seconds",
          "audio_output_seconds",
          "input_characters",
          "requests"
        ],
        "type": "string"
      },
      "title": "Unpriced Units",
      "type": "array",
      "uniqueItems": true
    },
    "usage_record_ids": {
      "items": {
        "pattern": "^use_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Usage Record Ids",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "created_at",
    "domain",
    "id",
    "schema_version",
    "status",
    "usage_record_ids"
  ],
  "title": "CostRecord",
  "type": "object"
}
