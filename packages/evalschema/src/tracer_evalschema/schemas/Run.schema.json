{
  "$defs": {
    "AgentTargetRef": {
      "additionalProperties": false,
      "description": "``{id, version, content_digest?}`` of an ``AgentTarget`` (ADR 0009 Decision 4, N35): what a\nRun holds. What the run detects is recorded on the Run, never written back (P-23).",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^agt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AgentTargetRef",
      "type": "object"
    },
    "CallerExternalId": {
      "additionalProperties": false,
      "description": "The caller's transport identifier (a SIP or telephony ``user_id``, possibly a phone\nnumber), verbatim, with its own privacy marker (P-43, ADR 0016 Decision 6). The only place\nsuch an identifier may live; it never enters a snapshot.",
      "properties": {
        "privacy": {
          "$ref": "#/$defs/PrivacyMarker"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "privacy",
        "value"
      ],
      "title": "CallerExternalId",
      "type": "object"
    },
    "ChannelAssignment": {
      "additionalProperties": false,
      "description": "One channel of a recording and whom it carries (P-31: ``mixed`` is a mono channel that\ncarries the caller and the agent together).",
      "properties": {
        "index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "role": {
          "enum": [
            "caller",
            "agent",
            "unknown",
            "mixed"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "index",
        "role"
      ],
      "title": "ChannelAssignment",
      "type": "object"
    },
    "ChannelMap": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "confidence": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "determination": {
                "enum": [
                  "inferred"
                ]
              }
            },
            "required": [
              "determination"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "number"
              }
            },
            "required": [
              "confidence"
            ]
          }
        }
      ],
      "description": "Which channel of an artifact carries whom (ADR 0012 Decision 5).\n\n``declared``: the producer's documented layout (for example Pipecat's stereo buffer, left the\ncaller and right the agent); ``method`` names the declaration and there is no confidence (a\ndeclaration is not a probability). ``inferred``: our analysis; ``method`` names it and\n``confidence`` is required. At most one channel is the agent (a second AI agent is a separate\nrun), indexes are unique and the order is kept.",
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelAssignment"
          },
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "determination": {
          "enum": [
            "declared",
            "inferred"
          ],
          "title": "Determination",
          "type": "string"
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "channels",
        "determination",
        "method"
      ],
      "title": "ChannelMap",
      "type": "object"
    },
    "ConsentRecord": {
      "additionalProperties": false,
      "description": "Whether the person recorded consented (ADR 0016 Decision 3). ``unknown`` is a state, not a\ndefault: it counts as not obtained for benchmark exports (P-44, P1-14).",
      "properties": {
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "status": {
          "enum": [
            "obtained",
            "not_obtained",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ConsentRecord",
      "type": "object"
    },
    "ContentDigest": {
      "additionalProperties": false,
      "description": "``{scheme, value, key_ref?}`` (ADR 0006 Decision 3). An unregistered scheme raises\n``UnknownDigestScheme`` (not wrapped by pydantic): it is never \"unverifiable, accept\".",
      "properties": {
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "enum": [
            "sha256-jcs/v1",
            "hmac-sha256-jcs/v1"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ContentDigest",
      "type": "object"
    },
    "ExternalRef": {
      "additionalProperties": false,
      "description": "An identifier assigned by another system, kept as data (never as our ID).\n\nAll three parts are stored exactly as given (ADR 0001 Decision 7).",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "system": {
          "title": "System",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "system",
        "value"
      ],
      "title": "ExternalRef",
      "type": "object"
    },
    "IngestWarning": {
      "additionalProperties": false,
      "description": "Something an importer could not map faithfully (ADR 0012 Decision 7). ``path`` locates the\nvalue in its source (the form depends on the mapping), ``raw`` is the source value verbatim.\nA ``LanguageLabelWarning`` becomes an ``IngestWarning`` with the same ``code`` and ``raw``.",
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "IngestWarning",
      "type": "object"
    },
    "KeyRef": {
      "additionalProperties": false,
      "description": "Names a key held by a key manager; never carries key material (ADR 0007 Decision 4).\n\n``key_id`` is the key manager's own name for the key, an opaque string stored as given\n(ADR 0001 I12), not one of our typed IDs.",
      "properties": {
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "key_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Version"
        },
        "provider_hint": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Hint"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "KeyRef",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    },
    "PrivacyMarker": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "consent": {
                "type": "null"
              },
              "human_subject_reason": {
                "type": "null"
              },
              "retention": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "human_subject": {
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "human_subject"
            ]
          },
          "then": {
            "properties": {
              "consent": {
                "type": "object"
              },
              "retention": {
                "type": "object"
              }
            },
            "required": [
              "consent",
              "retention"
            ]
          }
        }
      ],
      "description": "Whether a payload is human-subject data, with its consent and retention (ADR 0016).\n\nConsent and retention are present if and only if ``human_subject`` is true (P-46): a consent\nrecord for a synthetic voice would read as a consent gap. ``human_subject_reason`` records why\na marker is stricter than the derivation (P-47) and is rejected on a false marker.",
      "properties": {
        "consent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsentRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "human_subject": {
          "title": "Human Subject",
          "type": "boolean"
        },
        "human_subject_reason": {
          "anyOf": [
            {
              "enum": [
                "marked_before_role_evidence",
                "real_person_likeness",
                "manual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Subject Reason"
        },
        "retention": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetentionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "human_subject"
      ],
      "title": "PrivacyMarker",
      "type": "object"
    },
    "RetentionPolicy": {
      "additionalProperties": false,
      "description": "How long human-subject data is kept, and whether it is deleted when the time is up.",
      "properties": {
        "delete_on_expiry": {
          "title": "Delete On Expiry",
          "type": "boolean"
        },
        "policy_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Ref"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        }
      },
      "required": [
        "delete_on_expiry"
      ],
      "title": "RetentionPolicy",
      "type": "object"
    }
  },
  "$id": "urn:tracer:evalschema:0.0.1:Run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A run (prefix ``run``; a record of fact, ADR 0009 Decision 5).\n\nIt names the project, the agent target, and the configuration snapshot it ran with. ``mode``\nand ``caller_origin`` are both required, and a ``simulated`` run never has a ``human`` caller.\n``started_at`` is the start of the run and never the ingest time; absent when not known.\n``caller_external_id`` is the caller's transport identifier with its own privacy marker.\n``detected_capabilities`` (what the run detected) and ``available_inputs`` (what evidence it\nholds) are separate lists. ``agent_audio`` in ``available_inputs`` needs a channel map that\nidentifies the agent's channel (ADR 0004 Decision 5). ``observed_tier`` is closed and required\nand is for display and filtering only; ``spans`` in ``available_inputs`` with\n``observed_tier=T0`` is rejected, because stage spans come only from agent telemetry or an\nobserver (rule R1, O3a; ``detected_capabilities`` is not read for it).",
  "properties": {
    "agent_target": {
      "$ref": "#/$defs/AgentTargetRef"
    },
    "available_inputs": {
      "items": {
        "enum": [
          "audio",
          "agent_audio",
          "transcript",
          "agent_transcript",
          "turn_timing",
          "tool_calls",
          "tool_results",
          "spans",
          "usage",
          "reference_text",
          "expected_tool_calls"
        ],
        "type": "string"
      },
      "title": "Available Inputs",
      "type": "array",
      "uniqueItems": true
    },
    "caller_external_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallerExternalId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "caller_origin": {
      "enum": [
        "simulated",
        "human"
      ],
      "title": "Caller Origin",
      "type": "string"
    },
    "channel_maps": {
      "items": {
        "$ref": "#/$defs/ChannelMap"
      },
      "title": "Channel Maps",
      "type": "array"
    },
    "config_snapshot_id": {
      "pattern": "^snap_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Config Snapshot Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "detected_capabilities": {
      "items": {
        "enum": [
          "audio",
          "agent_audio",
          "transcript",
          "agent_transcript",
          "turn_timing",
          "tool_calls",
          "tool_results",
          "spans",
          "usage",
          "reference_text",
          "expected_tool_calls"
        ],
        "type": "string"
      },
      "title": "Detected Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "external_refs": {
      "items": {
        "$ref": "#/$defs/ExternalRef"
      },
      "title": "External Refs",
      "type": "array"
    },
    "id": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "ingest_warnings": {
      "items": {
        "$ref": "#/$defs/IngestWarning"
      },
      "title": "Ingest Warnings",
      "type": "array"
    },
    "metadata": {
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "mode": {
      "enum": [
        "simulated",
        "recorded"
      ],
      "title": "Mode",
      "type": "string"
    },
    "observed_tier": {
      "enum": [
        "T0",
        "T1",
        "T2"
      ],
      "title": "Observed Tier",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    }
  },
  "required": [
    "agent_target",
    "caller_origin",
    "config_snapshot_id",
    "created_at",
    "id",
    "mode",
    "observed_tier",
    "project_id",
    "schema_version"
  ],
  "title": "Run",
  "type": "object"
}
