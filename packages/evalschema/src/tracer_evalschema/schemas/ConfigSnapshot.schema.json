{
  "$defs": {
    "ContentDigest": {
      "additionalProperties": false,
      "description": "``{scheme, value, key_ref?}`` (ADR 0006 Decision 3). An unregistered scheme raises\n``UnknownDigestScheme`` (not wrapped by pydantic): it is never \"unverifiable, accept\".",
      "properties": {
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "enum": [
            "sha256-jcs/v1",
            "hmac-sha256-jcs/v1"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ContentDigest",
      "type": "object"
    },
    "EnumScale": {
      "additionalProperties": false,
      "description": "The options of an enum metric (non-empty, distinct ``MetricKey`` values).",
      "properties": {
        "options": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Options",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "options"
      ],
      "title": "EnumScale",
      "type": "object"
    },
    "EqualsTrueRule": {
      "additionalProperties": false,
      "description": "``equals_true``: a boolean passes iff it is ``true``.",
      "properties": {
        "kind": {
          "enum": [
            "equals_true"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EqualsTrueRule",
      "type": "object"
    },
    "Evaluator": {
      "additionalProperties": false,
      "description": "One test of an agent (prefix ``evl``; ADR 0010 Decision 8, ADR 0013 Decision 2).\n\nIts ``content_digest`` is computed over ``evaluator_digest_domain`` (N20).",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Created At",
          "type": "string"
        },
        "expected_outcome": {
          "minLength": 1,
          "title": "Expected Outcome",
          "type": "string"
        },
        "expected_tool_calls": {
          "items": {
            "$ref": "#/$defs/ExpectedToolCall"
          },
          "title": "Expected Tool Calls",
          "type": "array"
        },
        "id": {
          "pattern": "^evl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "language": {
          "pattern": "^(?:[eE][nN](?:-(?:[lL][aA][tT][nN]))?|[hH][iI](?:-(?:[dD][eE][vV][aA]))?|[mM][rR](?:-(?:[dD][eE][vV][aA]))?|[tT][eE](?:-(?:[tT][eE][lL][uU]))?|[tT][aA](?:-(?:[tT][aA][mM][lL]))?|[kK][nN](?:-(?:[kK][nN][dD][aA]))?|[mM][lL](?:-(?:[mM][lL][yY][mM]))?|[pP][aA](?:-(?:[gG][uU][rR][uU]))?|[gG][uU](?:-(?:[gG][uU][jJ][rR]))?)(?:-(?:[gG][bB]|[iI][nN]|[uU][sS]))?$",
          "title": "Language",
          "type": "string"
        },
        "max_duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 14400000,
          "minimum": 0,
          "title": "Max Duration Ms",
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metadata_flags": {
          "items": {
            "$ref": "#/$defs/MetadataFlag"
          },
          "title": "Metadata Flags",
          "type": "array"
        },
        "metric_bindings": {
          "items": {
            "$ref": "#/$defs/MetricBindingRef"
          },
          "minItems": 1,
          "title": "Metric Bindings",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "persona": {
          "$ref": "#/$defs/PersonaRef"
        },
        "schema_version": {
          "enum": [
            "0.0.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "scripted_turns": {
          "items": {
            "$ref": "#/$defs/ScriptedTurn"
          },
          "title": "Scripted Turns",
          "type": "array"
        },
        "test_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestProfileRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "content_digest",
        "created_at",
        "expected_outcome",
        "id",
        "instructions",
        "language",
        "max_duration_ms",
        "metric_bindings",
        "name",
        "persona",
        "schema_version",
        "version"
      ],
      "title": "Evaluator",
      "type": "object"
    },
    "ExpectedToolCall": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "enum": [
                  "name_only"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "enum": [
                  "arguments_exact"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object"
              }
            },
            "required": [
              "arguments"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "enum": [
                  "arguments_subset"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "arguments": {
                "minProperties": 1,
                "type": "object"
              }
            },
            "required": [
              "arguments"
            ]
          }
        }
      ],
      "description": "A tool call the agent is expected to make (ADR 0010 Decision 8).",
      "properties": {
        "arguments": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arguments"
        },
        "match": {
          "enum": [
            "name_only",
            "arguments_exact",
            "arguments_subset"
          ],
          "title": "Match",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
          "title": "Name",
          "type": "string"
        },
        "order_index": {
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        }
      },
      "required": [
        "match",
        "name",
        "order_index"
      ],
      "title": "ExpectedToolCall",
      "type": "object"
    },
    "KeyRef": {
      "additionalProperties": false,
      "description": "Names a key held by a key manager; never carries key material (ADR 0007 Decision 4).\n\n``key_id`` is the key manager's own name for the key, an opaque string stored as given\n(ADR 0001 I12), not one of our typed IDs.",
      "properties": {
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "key_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Version"
        },
        "provider_hint": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Hint"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "KeyRef",
      "type": "object"
    },
    "MetadataFlag": {
      "additionalProperties": false,
      "description": "A secret-looking string in ``metadata``: where it is and why (ADR 0007 Decision 5a).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "known_credential_prefix",
            "high_entropy_token"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MetadataFlag",
      "type": "object"
    },
    "MetricBinding": {
      "additionalProperties": false,
      "description": "A definition bound to an evaluator (prefix ``mbd``; ADR 0010 Decisions 4 and 4a).\n\n``params`` set parameters the definition declares, stored unchanged; they never change a\ndefinition field such as the pass rule (E6). ``check_binding_params`` checks them against the\ndefinition. A disabled binding is never run and may not be a rubric item.",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Created At",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "evaluator_id": {
          "pattern": "^evl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "id": {
          "pattern": "^mbd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metadata_flags": {
          "items": {
            "$ref": "#/$defs/MetadataFlag"
          },
          "title": "Metadata Flags",
          "type": "array"
        },
        "metric": {
          "$ref": "#/$defs/MetricDefinitionRef"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {}
          },
          "title": "Params",
          "type": "object"
        },
        "schema_version": {
          "enum": [
            "0.0.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "content_digest",
        "created_at",
        "enabled",
        "evaluator_id",
        "id",
        "metric",
        "params",
        "schema_version",
        "version"
      ],
      "title": "MetricBinding",
      "type": "object"
    },
    "MetricBindingRef": {
      "additionalProperties": false,
      "description": "``{id, version, content_digest?}`` of a ``MetricBinding`` (ADR 0009 Decision 4).",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^mbd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "MetricBindingRef",
      "type": "object"
    },
    "MetricDefinition": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "implementation_ref": {
                "type": "string"
              },
              "judge_model_ref": {
                "type": "null"
              },
              "prompt_template": {
                "type": "null"
              },
              "prompt_variables": {
                "type": "null"
              }
            },
            "required": [
              "implementation_ref"
            ]
          },
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "llm_judge"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "implementation_ref": {
                "type": "null"
              },
              "judge_model_ref": {
                "type": "object"
              },
              "prompt_template": {
                "type": "string"
              },
              "prompt_variables": {
                "type": "array"
              }
            },
            "required": [
              "judge_model_ref",
              "prompt_template",
              "prompt_variables"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "rating"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "scale": {
                "required": [
                  "max",
                  "min"
                ],
                "type": "object"
              }
            },
            "required": [
              "scale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "enum"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "scale": {
                "required": [
                  "options"
                ],
                "type": "object"
              }
            },
            "required": [
              "scale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "boolean",
                  "numeric"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "scale": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "unit": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "numeric"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "languages": {
                "type": "string"
              }
            },
            "required": [
              "languages"
            ]
          },
          "then": {
            "properties": {
              "script_sensitive": {
                "enum": [
                  false
                ]
              }
            }
          }
        }
      ],
      "description": "What a metric measures and how it passes (prefix ``met``; ADR 0010 Decisions 1 and 1a).\n\nThe judge fields (``prompt_template``, ``prompt_variables``, ``judge_model_ref``) are required\nfor ``kind=llm_judge`` and forbidden otherwise; ``implementation_ref`` is the reverse. A\n``scale`` belongs to rating and enum metrics, a ``unit`` to numeric ones. The pass rule fits\n``value_type`` (for ``per_turn_share`` it is a range on the share and ``turn_rule`` fits the\ntype), its bounds lie in the value domain, and some value passes.",
      "properties": {
        "aggregation": {
          "oneOf": [
            {
              "$ref": "#/$defs/PerConversationAggregation"
            },
            {
              "$ref": "#/$defs/PerTurnShareAggregation"
            }
          ],
          "title": "Aggregation"
        },
        "content_digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "pattern": "^met_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "implementation_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9._:/@+-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implementation Ref"
        },
        "judge_model_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "llm_judge",
            "audio",
            "latency"
          ],
          "title": "Kind",
          "type": "string"
        },
        "languages": {
          "anyOf": [
            {
              "enum": [
                "language_independent"
              ],
              "type": "string"
            },
            {
              "items": {
                "pattern": "^(?:[eE][nN](?:-(?:[lL][aA][tT][nN]))?|[hH][iI](?:-(?:[dD][eE][vV][aA]))?|[mM][rR](?:-(?:[dD][eE][vV][aA]))?|[tT][eE](?:-(?:[tT][eE][lL][uU]))?|[tT][aA](?:-(?:[tT][aA][mM][lL]))?|[kK][nN](?:-(?:[kK][nN][dD][aA]))?|[mM][lL](?:-(?:[mM][lL][yY][mM]))?|[pP][aA](?:-(?:[gG][uU][rR][uU]))?|[gG][uU](?:-(?:[gG][uU][jJ][rR]))?)(?:-(?:[gG][bB]|[iI][nN]|[uU][sS]))?$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ],
          "title": "Languages"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metadata_flags": {
          "items": {
            "$ref": "#/$defs/MetadataFlag"
          },
          "title": "Metadata Flags",
          "type": "array"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/MetricParameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "pass_rule": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/RangeRule"
                },
                {
                  "$ref": "#/$defs/EqualsTrueRule"
                },
                {
                  "$ref": "#/$defs/OneOfRule"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Rule"
        },
        "prompt_template": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template"
        },
        "prompt_variables": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Variables"
        },
        "requires": {
          "items": {
            "enum": [
              "audio",
              "agent_audio",
              "transcript",
              "agent_transcript",
              "turn_timing",
              "tool_calls",
              "tool_results",
              "spans",
              "usage",
              "reference_text",
              "expected_tool_calls"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Requires",
          "type": "array",
          "uniqueItems": true
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/RatingScale"
            },
            {
              "$ref": "#/$defs/EnumScale"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "schema_version": {
          "enum": [
            "0.0.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "script_sensitive": {
          "title": "Script Sensitive",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "ms",
                "count",
                "ratio",
                "percent",
                "wer",
                "cer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value_type": {
          "enum": [
            "boolean",
            "rating",
            "enum",
            "numeric"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "aggregation",
        "content_digest",
        "created_at",
        "id",
        "key",
        "kind",
