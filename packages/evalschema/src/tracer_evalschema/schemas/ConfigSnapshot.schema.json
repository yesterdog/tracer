  "$id": "urn:tracer:evalschema:0.0.1:ConfigSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The configuration a run used, frozen (prefix ``snap``; ADR 0006 Decision 1).\n\nChecked on load, after the fields: the digest equals ``compute_snapshot_digest`` of the\ndocument (``DigestMismatch``, ``DigestKeyUnavailable`` and ``UnknownDigestScheme`` unwrapped);\nno definition and no binding is embedded twice (same ``id`` and ``version``; a code-only rule,\nregister row ``CO-LONG-LIST-UNIQUENESS``); the evaluator's persona and binding references,\nand each binding's definition reference, resolve to an embedded record of that\n``(id, version)``, and a digest on such a reference is verified (``RefDigestMismatchError``,\nE5); every binding belongs to the evaluator; the rubric passes ``validate_rubric``; the\nevaluator has at least one expected-outcome check, and every such check is a required rubric\nitem.",
  "properties": {
    "content_digest": {
      "$ref": "#/$defs/ContentDigest"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "evaluator": {
      "$ref": "#/$defs/Evaluator"
    },
    "id": {
      "pattern": "^snap_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metadata_flags": {
      "items": {
        "$ref": "#/$defs/MetadataFlag"
      },
      "title": "Metadata Flags",
      "type": "array"
    },
    "metric_bindings": {
      "items": {
        "$ref": "#/$defs/MetricBinding"
      },
      "minItems": 1,
      "title": "Metric Bindings",
      "type": "array"
    },
    "metric_definitions": {
      "items": {
        "$ref": "#/$defs/MetricDefinition"
      },
      "minItems": 1,
      "title": "Metric Definitions",
      "type": "array"
    },
    "persona": {
      "$ref": "#/$defs/Persona"
    },
    "pricing_catalog": {
      "anyOf": [
        {
          "$ref": "#/$defs/PricingCatalogRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rubric": {
      "$ref": "#/$defs/Rubric"
    },
    "schema_version": {
      "enum": [
        "0.0.1"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "content_digest",
    "created_at",
    "evaluator",
    "id",
    "metric_bindings",
    "metric_definitions",
    "persona",
    "rubric",
    "schema_version"
  ],
  "title": "ConfigSnapshot",
  "type": "object"
}
